// == 040-aliases.filter ==
@ 040-aliases.filter:83  Alias VIAL2, Alias VIALX, Alias VIALY
= Alias[VIAL]:%PURPLE%xX%BLUE%xX%LIGHT_GRAY%x\%WHITE%\V/%LIGHT_GRAY%/x%BLUE%Xx%PURPLE%Xx
+ Alias[VIAL2]:%BLACK%•%GREEN%
+ Alias[VIALX]:%GRAY%+++%LIGHT_GRAY%+++%WHITE%+++
+ Alias[VIALY]:%WHITE%+++%LIGHT_GRAY%+++%GRAY%+++
@ 040-aliases.filter:86  Alias MIRROR_L, Alias MIRROR_R
= Alias[MIRROR]:%PURPLE%xX%RED%xX%ORANGE%x\%TAN%\%WHITE%V%TAN%/%ORANGE%/x%RED%Xx%PURPLE%Xx
+ Alias[MIRROR_L]:%PURPLE%+++%BLUE%+++%TEAL%+++%DARK_GREEN%+++
+ Alias[MIRROR_R]:%DARK_GREEN%+++%TEAL%+++%BLUE%+++%PURPLE%+++
@ 040-aliases.filter:262  Corr's magic charms
- Alias[MAGIC_CHARMS_LEFT]:%TEAL%\%BLUE%(%PURPLE%(
+ Alias[MAGIC_CHARMS_LEFT]:%YELLOW%\%ORANGE%(%RED%(
@ 040-aliases.filter:263  Corr's magic charms
- Alias[MAGIC_CHARMS_RIGHT]:%PURPLE%)%BLUE%)%TEAL%/
+ Alias[MAGIC_CHARMS_RIGHT]:%RED%)%ORANGE%)%YELLOW%/
@ 040-aliases.filter:266  Corr's magic charms
- Alias[MAGIC_CHARMS_DIM_LEFT]:%TEAL%\%BLUE%((
+ Alias[MAGIC_CHARMS_DIM_LEFT]:%YELLOW%\%ORANGE%((
@ 040-aliases.filter:267  Corr's magic charms
- Alias[MAGIC_CHARMS_DIM_RIGHT]:%BLUE%))%TEAL%/
+ Alias[MAGIC_CHARMS_DIM_RIGHT]:%ORANGE%))%YELLOW%/
@ 040-aliases.filter:270  Corr's magic charms
- Alias[MAGIC_LARGE_CHARM_90_LEFT]:%PURPLE%-
+ Alias[MAGIC_LARGE_CHARM_90_LEFT]:%RED%-
@ 040-aliases.filter:271  Corr's magic charms
- Alias[MAGIC_LARGE_CHARM_90_RIGHT]:%PURPLE%-
+ Alias[MAGIC_LARGE_CHARM_90_RIGHT]:%RED%-
