// =====================================  Corrlorized style  ==================================

// Corrlorized - Main - PoE, - Revealed - PoE, - BIG GG - PoE and - Revealed - BIG GG - PoE: the look of
// Erazure-S13-corrlorized.filter (a restyle of Season 13's Erazure - Main - PoE, 1a0ae41, by Corr) on today's
// four Erazure PoE versions (each file has all 8 toggle blocks). Imported with
// python tools/style_edits.py --port (2026-10-19); the author's review (2026-10-20): his look everywhere but the
// Horadric Cube, which names this filter, and the tags (the author's "r", not Corr's "res"); his look on 52 S14
// rules he never saw. Rules are the author's: map resistances and descriptions, rune and gem notifications and
// icons, and tags as in Erazure. Of the displays Corr switched off, only the minimap icons of Small and Grand
// Charms under item level 90 stay off, and since his v2 (2026-10-20) the Highest Resistances of T1-T3 maps (one
// '*' entry per map; their Monster Immunities show, and unique maps keep both). No sounds or minimap icons on
// rare rings, belts and boots, ethereal rare and magic axes, magic jewels and Large Charms, nor on rare circlets
// and amulets on level 12 (Corr's removals, and the author's for boots and level 12's jewelry).
// Corr's v3 (2026-10-21; "mostly disabling a bunch of rules for maps and charm stat displays"), all taken by the
// author: 17 map description lines off (guest monsters, Blood Lords, Melee Splash, +% elemental and physical
// damage, low +% Maximum Life, Dual Extra Damage, -% Max and All Resistances), 19 magic charm tags and 20 affix
// tags off (Light Radius, Gold Find, DTM, ATD on weapons, MDR, Mana Regeneration, Mana, Replenish Life, Energy,
// Dexterity, % AR, rare max damage), no icons or notifications for Flawless and Perfect gems in maps (Skulls keep
// theirs, as in his file) nor for runes El to Fal (El to Io keep stopping the display, only their icon codes go),
// and LIL GG in sage, BIG GG in orange.
// Each entry: '@ <section file>:<line>  <name>' (where it last matched, kept up to date by the build), then
// '- <the author's line>' and '+ <the style's line>' (only what the rule shows changes; its condition and
// comment stay the author's), '= <anchor line>' and '+ <lines inserted after it>', 'x <a rule switched off>',
// or '* <words>' (each rule of the section whose condition has those words, switched off). See
// tools/style_edits.py.

// == 020-horadric-cube.filter ==
@ 020-horadric-cube.filter:28  Corrlorized on the Cube
- Alias[MAIN_VERSION_NAME]:Erazure - Main
+ Alias[MAIN_VERSION_NAME]:Corrlorized - Main
@ 020-horadric-cube.filter:29  Corrlorized on the Cube
- Alias[REVEALED_VERSION_NAME]:Erazure - Revealed
+ Alias[REVEALED_VERSION_NAME]:Corrlorized - Revealed
@ 020-horadric-cube.filter:30  Corrlorized on the Cube
- Alias[MAIN_POE_VERSION_NAME]:Erazure - Main - PoE
+ Alias[MAIN_POE_VERSION_NAME]:Corrlorized - Main - PoE
@ 020-horadric-cube.filter:31  Corrlorized on the Cube
- Alias[REVEALED_POE_VERSION_NAME]:Erazure - Revealed - PoE
+ Alias[REVEALED_POE_VERSION_NAME]:Corrlorized - Revealed - PoE
@ 020-horadric-cube.filter:32  Corrlorized on the Cube
- Alias[BIG_GG_VERSION_NAME]:Erazure - Big GG
+ Alias[BIG_GG_VERSION_NAME]:Corrlorized - Big GG
@ 020-horadric-cube.filter:33  Corrlorized on the Cube
- Alias[REVEALED_BIG_GG_VERSION_NAME]:Erazure - Revealed - Big GG
+ Alias[REVEALED_BIG_GG_VERSION_NAME]:Corrlorized - Revealed - Big GG
@ 020-horadric-cube.filter:34  Corrlorized on the Cube
- Alias[BIG_GG_POE_VERSION_NAME]:Erazure - Big GG - PoE
+ Alias[BIG_GG_POE_VERSION_NAME]:Corrlorized - Big GG - PoE
@ 020-horadric-cube.filter:35  Corrlorized on the Cube
- Alias[REVEALED_BIG_GG_POE_VERSION_NAME]:Erazure - Revealed - Big GG - PoE
+ Alias[REVEALED_BIG_GG_POE_VERSION_NAME]:Corrlorized - Revealed - Big GG - PoE

// == 040-aliases.filter ==
@ 040-aliases.filter:84  Alias VIAL2, Alias VIALX, Alias VIALY
= Alias[VIAL]:%PURPLE%xX%BLUE%xX%LIGHT_GRAY%x\%WHITE%\V/%LIGHT_GRAY%/x%BLUE%Xx%PURPLE%Xx
+ Alias[VIAL2]:%BLACK%•%GREEN%
+ Alias[VIALX]:%GRAY%+++%LIGHT_GRAY%+++%WHITE%+++
+ Alias[VIALY]:%WHITE%+++%LIGHT_GRAY%+++%GRAY%+++
@ 040-aliases.filter:87  Alias MIRROR_L, Alias MIRROR_R
= Alias[MIRROR]:%PURPLE%xX%RED%xX%ORANGE%x\%TAN%\%WHITE%V%TAN%/%ORANGE%/x%RED%Xx%PURPLE%Xx
+ Alias[MIRROR_L]:%PURPLE%+++%BLUE%+++%TEAL%+++%DARK_GREEN%+++
+ Alias[MIRROR_R]:%DARK_GREEN%+++%TEAL%+++%BLUE%+++%PURPLE%+++
@ 040-aliases.filter:268  Corr's magic charms
- Alias[MAGIC_CHARMS_LEFT]:%TEAL%\%BLUE%(%PURPLE%(
+ Alias[MAGIC_CHARMS_LEFT]:%YELLOW%\%ORANGE%(%RED%(
@ 040-aliases.filter:269  Corr's magic charms
- Alias[MAGIC_CHARMS_RIGHT]:%PURPLE%)%BLUE%)%TEAL%/%BLUE%
+ Alias[MAGIC_CHARMS_RIGHT]:%RED%)%ORANGE%)%YELLOW%/%BLUE%
@ 040-aliases.filter:272  Corr's magic charms
- Alias[MAGIC_CHARMS_DIM_LEFT]:%TEAL%\%BLUE%((
+ Alias[MAGIC_CHARMS_DIM_LEFT]:%YELLOW%\%ORANGE%((
@ 040-aliases.filter:273  Corr's magic charms
- Alias[MAGIC_CHARMS_DIM_RIGHT]:%BLUE%))%TEAL%/%BLUE%
+ Alias[MAGIC_CHARMS_DIM_RIGHT]:%ORANGE%))%YELLOW%/%BLUE%
@ 040-aliases.filter:276  Corr's magic charms
- Alias[MAGIC_LARGE_CHARM_90_LEFT]:%PURPLE%-
+ Alias[MAGIC_LARGE_CHARM_90_LEFT]:%RED%-
@ 040-aliases.filter:277  Corr's magic charms
- Alias[MAGIC_LARGE_CHARM_90_RIGHT]:%PURPLE%-%BLUE%
+ Alias[MAGIC_LARGE_CHARM_90_RIGHT]:%RED%-%BLUE%
@ 040-aliases.filter:280  Corr's magic charms
- Alias[MAGIC_LARGE_CHARM_LEFT]:%TEAL%-
+ Alias[MAGIC_LARGE_CHARM_LEFT]:%YELLOW%-
@ 040-aliases.filter:281  Corr's magic charms
- Alias[MAGIC_LARGE_CHARM_RIGHT]:%TEAL%-%BLUE%
