// =====================================  Minimal style  ==================================

// Minimal: Erazure - Main with the aliases below in place of the same aliases in
// sections/040-aliases.filter. tools/build.py writes Erazure-Minimal.filter and its 7 other versions (every
// combination of Revealed, BIG GG and PoE) from it (STYLE_VARIANTS); the launcher lists them (filter_definitions.json).
// One line per alias that looks different from Main; an alias left out keeps Main's look.
// A line must never hold // (BH reads the rest as a comment): put a color code between two slashes.
// BH drops spaces at an alias's ends: a color code on the outside keeps them.
// The item name keeps its own color: an earlier layer puts it in front (150:429 %GOLD%%NAME% for uniques).
// The author's picks of 2026-10-19 to 2026-10-21 (the claude.ai page in CLAUDE.md). The keys, the Horadric
// Almanac and Navigator and the description highlights keep Main's look.

// Lowest Runes
Alias[LOWEST_RUNE_HIGH_QTY_LEFT]:%DARK_GREEN%x%GRAY%x%LIGHT_GRAY%x
Alias[LOWEST_RUNE_HIGH_QTY_RIGHT]:%LIGHT_GRAY%x%GRAY%x%DARK_GREEN%x

// Low Runes
Alias[LOW_RUNE_HIGH_QTY_LEFT]:%BLUE%x%GRAY%x%LIGHT_GRAY%x
Alias[LOW_RUNE_HIGH_QTY_RIGHT]:%LIGHT_GRAY%x%GRAY%x%BLUE%x

// Um Mal
Alias[UM_RUNE]:%DARK_GREEN%x%GREEN%x%YELLOW%x%TAN%o%YELLOW%x%GREEN%x%DARK_GREEN%x
Alias[MAL_RUNE]:%DARK_GREEN%x%GREEN%x%YELLOW%x%TAN%o%YELLOW%x%GREEN%x%DARK_GREEN%x

// Ist Gul
Alias[IST_GUL_RUNE]:%BLUE%x%DARK_GREEN%x%GREEN%x%YELLOW%x%TAN%o%YELLOW%x%GREEN%x%DARK_GREEN%x%BLUE%x

// Vex Ohm Lo
Alias[VEX_OHM_LO_RUNE]:%BLUE%x%PURPLE%x%ORANGE%x%YELLOW%x%TAN%o%YELLOW%x%ORANGE%x%PURPLE%x%BLUE%x

// Sur Ber Jah Cham Zod BIG GG
Alias[SUR_BER_JAH_CHAM_ZOD_BIG_GG]:%PURPLE%x%RED%x%ORANGE%x%YELLOW%x%TAN%o%YELLOW%x%ORANGE%x%RED%x%PURPLE%x

// Worldstone High Qty
Alias[WORLDSTONE_HIGH_QTY]:%RED%xx%CORAL%x%WHITE%o%CORAL%x%RED%xx

// Catalyst Shard
Alias[CATALYST_SHARD]:%GRAY%x%LIGHT_GRAY%x%WHITE%o%LIGHT_GRAY%x%GRAY%x

// Puzzlepiece
Alias[PUZZLEPIECE_LEFT]:%ORANGE%x%YELLOW%x%TAN%x
Alias[PUZZLEPIECE_RIGHT]:%TAN%x%YELLOW%x%ORANGE%x

// Puzzlebox
Alias[PUZZLEBOX_LEFT]:%BLUE%x%PURPLE%x%ORANGE%x%YELLOW%x%TAN%x
Alias[PUZZLEBOX_RIGHT]:%TAN%x%YELLOW%x%ORANGE%x%PURPLE%x%BLUE%x

// Demonic Cube
Alias[DEMONIC_CUBE]:%RED%x%CORAL%xx%WHITE%xox%CORAL%xx%RED%x

// Vial of Lightsong
Alias[VIAL]:%PURPLE%x%BLUE%x%LIGHT_GRAY%x%WHITE%v%LIGHT_GRAY%x%BLUE%x%PURPLE%x

// Lilith's Mirror
Alias[MIRROR]:%PURPLE%x%RED%x%ORANGE%x%TAN%x%WHITE%v%TAN%x%ORANGE%x%RED%x%PURPLE%x

// Rainbow Facet
Alias[FACET_LEFT]:%GREEN%*%BLUE%*%PURPLE%*%RED%*%ORANGE%*%YELLOW%*
Alias[FACET_RIGHT]:%YELLOW%*%ORANGE%*%RED%*%PURPLE%*%BLUE%*%GREEN%*

// Uniques from Diablo Clone and Rathma
Alias[UNI_DCLONE_RATHMA]:%BLUE%*%TEAL%**%GREEN%***%TEAL%**%BLUE%*

// Unique High Value
Alias[UNI_HIGH_VALUE_LEFT]:%BLUE%*%PURPLE%*%RED%*%ORANGE%*%GOLD%*  %WHITE%>
Alias[UNI_HIGH_VALUE_RIGHT]:%WHITE%<  %GOLD%*%ORANGE%*%RED%*%PURPLE%*%BLUE%*%GOLD%

// Unique Medium Value
Alias[UNI_MEDIUM_VALUE_LEFT]:%PURPLE%*%RED%*%ORANGE%*%GOLD%*  %WHITE%>
Alias[UNI_MEDIUM_VALUE_RIGHT]:%WHITE%<  %GOLD%*%ORANGE%*%RED%*%PURPLE%*%GOLD%

// Unique Minimal Value
Alias[UNI_MINIMAL_VALUE_LEFT]:%RED%*%ORANGE%*%GOLD%*
Alias[UNI_MINIMAL_VALUE_RIGHT]:%GOLD%*%ORANGE%*%RED%*%GOLD%

// Unique Grail
Alias[UNI_GRAIL_LEFT]:%ORANGE%*%GOLD%*%LIGHT_GRAY%*
Alias[UNI_GRAIL_RIGHT]:%LIGHT_GRAY%*%GOLD%*%ORANGE%*%GOLD%

// Unique LLD
Alias[UNI_LLD_LEFT]:%TEAL%*%LIGHT_GRAY%*%GRAY%*
Alias[UNI_LLD_RIGHT]:%GRAY%*%LIGHT_GRAY%*%TEAL%*%GOLD%

// Unique Normal
Alias[UNI_NORMAL_LEFT]:%GOLD%*%LIGHT_GRAY%*%GRAY%*
Alias[UNI_NORMAL_RIGHT]:%GRAY%*%LIGHT_GRAY%*%GOLD%*

// Unique Exceptional
Alias[UNI_EXCEPTIONAL_LEFT]:%GOLD%*%LIGHT_GRAY%*%GRAY%*
Alias[UNI_EXCEPTIONAL_RIGHT]:%GRAY%*%LIGHT_GRAY%*%GOLD%*

// Unique Elite
Alias[UNI_ELITE_LEFT]:%GOLD%*%LIGHT_GRAY%*%GRAY%*
Alias[UNI_ELITE_RIGHT]:%GRAY%*%LIGHT_GRAY%*%GOLD%*

// Set High Value
Alias[SET_HIGH_VALUE_LEFT]:%PURPLE%*%RED%*%GREEN%*%DARK_GREEN%*  %WHITE%>
Alias[SET_HIGH_VALUE_RIGHT]:%WHITE%<  %DARK_GREEN%*%GREEN%*%RED%*%PURPLE%*%GREEN%

// Set Medium Value
Alias[SET_MEDIUM_VALUE_LEFT]:%PURPLE%*%GREEN%*%DARK_GREEN%*  %WHITE%>
Alias[SET_MEDIUM_VALUE_RIGHT]:%WHITE%<  %DARK_GREEN%*%GREEN%*%PURPLE%*%GREEN%

// Set Grail
Alias[SET_GRAIL_LEFT]:%ORANGE%*%GREEN%*%DARK_GREEN%*
Alias[SET_GRAIL_RIGHT]:%DARK_GREEN%*%GREEN%*%ORANGE%*%GREEN%

// Set LLD
Alias[SET_LLD_LEFT]:%TEAL%*%GREEN%*%DARK_GREEN%*
Alias[SET_LLD_RIGHT]:%DARK_GREEN%*%GREEN%*%TEAL%*%GREEN%

// Set
Alias[SET_LEFT]:%PURPLE%*%GREEN%*%DARK_GREEN%*
Alias[SET_RIGHT]:%DARK_GREEN%*%GREEN%*%PURPLE%*%GREEN%

// Set Normal: normal-tier set items at character level 60+ (levels 0-2)
Alias[SET_NORMAL_LEFT]:%DARK_GREEN%*%GREEN%*%DARK_GREEN%*%GREEN%
Alias[SET_NORMAL_RIGHT]:%DARK_GREEN%*%GREEN%*%DARK_GREEN%*%GREEN%

// Rare High Value
Alias[RARE_HIGH_VALUE_LEFT]:%PURPLE%• %YELLOW%>
Alias[RARE_HIGH_VALUE_RIGHT]:%YELLOW%< %PURPLE%•

// Rare Medium Value
Alias[RARE_MEDIUM_VALUE_RIGHT]:%YELLOW%< %PURPLE%•%YELLOW%

// Rare Eth Craft
Alias[RARE_ETH_CRAFT_RIGHT]:%YELLOW%< %ORANGE%•%YELLOW%

// Magic Eth Craft
Alias[MAGIC_ETH_CRAFT_RIGHT]:%BLUE%< %ORANGE%•%BLUE%

// Magic Charms
Alias[MAGIC_CHARM_LEFT]:%TEAL%*%BLUE%*%PURPLE%*
Alias[MAGIC_CHARM_RIGHT]:%PURPLE%*%BLUE%*%TEAL%*%BLUE%

// Magic Small, Grand and Large Charms (Small and Grand on levels 0-4 or of item level 90+, Large on levels 0-6)
Alias[MAGIC_CHARMS_LEFT]:%TEAL%*%BLUE%*%PURPLE%*
Alias[MAGIC_CHARMS_RIGHT]:%PURPLE%*%BLUE%*%TEAL%*%BLUE%

// Magic Small and Grand Charms below item level 90 (levels 5-12)
Alias[MAGIC_CHARMS_DIM_LEFT]:%TEAL%*%BLUE%**
Alias[MAGIC_CHARMS_DIM_RIGHT]:%BLUE%**%TEAL%*

// Magic Large Charms of item level 90+ (levels 8 and 10)
Alias[MAGIC_LARGE_CHARM_90_LEFT]:%PURPLE%*
Alias[MAGIC_LARGE_CHARM_90_RIGHT]:%PURPLE%*

// Magic Large Charms below item level 90 (levels 8 and 10)
Alias[MAGIC_LARGE_CHARM_LEFT]:%TEAL%*
Alias[MAGIC_LARGE_CHARM_RIGHT]:%TEAL%*

// Each version's name on the Horadric Cube (sections/020-horadric-cube.filter): "Erazure - Minimal ...", though
// the launcher names dropped "Erazure - " (the author, 2026-10-24: the Cube keeps it)
Alias[MAIN_VERSION_NAME]:Erazure - Minimal
Alias[REVEALED_VERSION_NAME]:Erazure - Minimal - Revealed
Alias[MAIN_POE_VERSION_NAME]:Erazure - Minimal - PoE
Alias[REVEALED_POE_VERSION_NAME]:Erazure - Minimal - Revealed - PoE
Alias[BIG_GG_VERSION_NAME]:Erazure - Minimal - Big GG
Alias[REVEALED_BIG_GG_VERSION_NAME]:Erazure - Minimal - Revealed - Big GG
Alias[BIG_GG_POE_VERSION_NAME]:Erazure - Minimal - Big GG - PoE
Alias[REVEALED_BIG_GG_POE_VERSION_NAME]:Erazure - Minimal - Revealed - Big GG - PoE
