// ------------------------------------------------------------------------------
//    =======================  Rathma Gear Tags Display ======================
// ------------------------------------------------------------------------------

// Rare/Crafted Amulets - 50+ PLR mandatory, 4+ desirable affixes
ItemDisplay[(RARE OR CRAFT) amu ID STAT110>49 $f(COUNT(LIFE>29,STR>14,DEX>14,ALLATTRIB>4,ALLSK>0,FCR>9,FHR>9,STAT96>9,STAT20>0,AR>99,EDAM>29,RES>9,FRES>29,CRES>29,PRES>29,MAXRES>1,STAT118==1,STAT153==1,STAT360==0,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=4)]:%NAME%{%RED%Rathma Amulet%CL%%NAME%}%CONTINUE%//
ItemDisplay[MAG amu ID STAT110>74 (TABSK0>2 OR TABSK1>2 OR TABSK2>2 OR TABSK8>2 OR TABSK9>2 OR TABSK10>2 OR TABSK16>2 OR TABSK17>2 OR TABSK18>2 OR TABSK24>2 OR TABSK25>2 OR TABSK26>2 OR TABSK32>2 OR TABSK33>2 OR TABSK34>2 OR TABSK40>2 OR TABSK41>2 OR TABSK42>2 OR TABSK48>2 OR TABSK49>2 OR TABSK50>2 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1) (STAT360=0 OR ALLSK>0 OR MAXRES>1 OR STAT153=1)]:%NAME%{%RED%Rathma Amulet%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Rings - Physical - 25+ PLR, 1+ offensive affixes, 4+ desirable affixes
// Rare/Crafted Rings - Caster - 25+ PLR, 4+ desirable affixes
ItemDisplay[(RARE OR CRAFT) rin ID STAT110>24 (($f(COUNT(AR>59,MINDMG>8,MAXDMG>9)>=1) $f(COUNT(LIFE>19,STR>9,DEX>9,STAT3>9,ALLATTRIB>4,FCR>9,STAT96>9,AR>59,MINDMG>8,MAXDMG>9,RES>7,FRES>14,CRES>14,PRES>14,STAT118==1,STAT360==0)>=4)) OR ($f(COUNT(LIFE>19,STR>9,DEX>9,STAT3>9,ALLATTRIB>4,FCR>9,STAT96>9,RES>7,FRES>14,CRES>14,PRES>14,STAT118==1,STAT360==0)>=4)))]:%NAME%{%RED%Rathma Ring%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Shield - Caster - 75+ PLR mandatory, 4+ desirable affixes
// Rare/Crafted Shield - Physical - 75+ PLR and 80+ ED mandatory, 3+ desirable affixes
ItemDisplay[(RARE OR CRAFT) SHIELD ID STAT110>74 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FBR>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT360==53,STAT360==54,STAT360==56)>=4) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FBR>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT360==53,STAT360==54,STAT360==56)>=3))) ]:%NAME%{%RED%Rathma Shield%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Belts - Uncorrupted or 2% all max resistances corruption, 5+ desirable affixes
ItemDisplay[(RARE OR CRAFT) BELT ID (STAT360=0 OR MAXRES>1) $f(COUNT(MAXRES>1,STAT110>24,LIFE>89,LIFE>49,STR>19,FCR>9,FHR>14,FRES>14,CRES>14,PRES>14,STAT36>7,STAT360==0)>=5)]:%NAME%{%RED%Rathma Belt%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Chest - Caster - 75+ PLR mandatory, 4+ desirable affixes
// Rare/Crafted Chest - Physical - 75+ PLR and 80+ ED mandatory, 3+ desirable affixes
ItemDisplay[(RARE OR CRAFT) CHEST ID STAT110>74 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FRW>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT360==53,STAT360==54,STAT360==56)>=4) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FRW>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT360==53,STAT360==54,STAT360==56)>=3))) ]:%NAME%{%RED%Rathma Chest%CL%%NAME%}%CONTINUE%//

// Rare Circlets - 50+ PLR mandatory, 5+ desirable affixes
ItemDisplay[RARE CIRC ID STAT110>49 $f(COUNT(LIFE>29,STR>14,DEX>14,STAT216>0,ALLSK>0,FCR>19,FHR>16,FRW>19,SOCK>2,RES>9,MAXRES>1,STAT153==1,STAT360==0,STAT36>7,STAT76>4,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=5)]:%NAME%{%RED%Rathma Circlet%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Gloves - 25+ PLR, 20+ IAS, +2 skill tab mandatory, 3+ desirable affixes
ItemDisplay[(RARE OR CRAFT) GLOVES ID STAT110>24 IAS>19 (TABSK0=2 OR TABSK2=2 OR TABSK50=2) $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,IAS>29,AR>99,STAT116>0,RES>4,FRES>14,CRES>14,PRES>14,STAT118==1,STAT360==0)>=3)]:%NAME%{%RED%Rathma Gloves%CL%%NAME%}%CONTINUE%//

