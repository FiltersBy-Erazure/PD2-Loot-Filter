// ---------------------------------------------------------------------------------
// ===============================  Necro Wands  ===============================
// ---------------------------------------------------------------------------------

// Hide nonmagical necromancer wands that are not Dominion bases: on filter levels 2-6 from character level 80 (only a ($) shows when one sells for 25,000+ gold and takes 2 inventory squares or less), and on filter levels 7+
ItemDisplay[NMAG !RW WAND (FILTLVL~2-6 CLVL>79) !RWB_DOMINION_WAND GROUND !TOWN SELLPRICE>24999 AREA<3]:%GRAY%(%TAN%$%GRAY%)//
ItemDisplay[NMAG !RW WAND (FILTLVL~2-6 CLVL>79) !RWB_DOMINION_WAND GROUND !TOWN (SELLPRICE<25000 OR AREA>2)]://
ItemDisplay[NMAG !RW WAND FILTLVL>6 !RWB_DOMINION_WAND !TOWN]:// On filter levels 7+, hide nonmagical necromancer wands that are not Dominion bases

//      Dominion runeword wand bases
ItemDisplay[NMAG !RW WAND RWB_DOMINION_WAND]:%ORANGE%Dominion %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

//      White runeword wand bases: 
//      Teeth, Bone Spear, and Corpse Explosion
ItemDisplay[NMAG !RW WAND ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!NECROMANCER CLVL<60) OR (NECROMANCER CLVL<80)) !(wnd OR ywn OR 9wn) (SOCK=0 OR SOCK=2) (SK67>2 OR SK84>2 OR SK74>2)]:%ORANGE%White %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Hides all other wands that don't have + to skills
ItemDisplay[NMAG !RW WAND CLVL>9 FILTLVL>0 !(SK66>0 OR SK67>0 OR SK68>0 OR SK69>0 OR SK70>0 OR SK71>0 OR SK72>0 OR SK73>0 OR SK74>0 OR SK75>0 OR SK76>0 OR SK77>0 OR SK78>0 OR SK79>0 OR SK80>0 OR SK81>0 OR SK82>0 OR SK83>0 OR SK84>0 OR SK85>0 OR SK86>0 OR SK87>0 OR SK88>0 OR SK89>0 OR SK90>0 OR SK91>0 OR SK92>0 OR SK93>0 OR SK94>0 OR SK95>0 OR SK367>0 OR SK374>0 OR SK381>0) !TOWN]://

// ------------------------------------------------------------------------------
//    =============================  Amazon Bows  ============================   
// ------------------------------------------------------------------------------

// Hide Zon Class Bows that don't have at least +1 to Bow Skills above character level 24
ItemDisplay[NMAG TABSK0<1 (am1 OR am2 OR am6 OR am7 OR amb OR amc) CLVL>24 FILTLVL>0 !TOWN]://
// Hide Zon Class Bows that don't have at least +2 to Bow Skills above character level 44
ItemDisplay[NMAG TABSK0<2 (am1 OR am2 OR am6 OR am7 OR amb OR amc) CLVL>44 FILTLVL>0 !TOWN]://
// Hide Zon Class Bows that don't have at least +3 to Bow Skills above character level 64
ItemDisplay[NMAG TABSK0<3 (am1 OR am2 OR am6 OR am7 OR amb OR amc) CLVL>64 FILTLVL>0 !TOWN]://

//          Normal tier
//           Stag Bow
ItemDisplay[NMAG !INF !RW am1 CLVL>59 FILTLVL>1 !TOWN]:// 
ItemDisplay[NMAG !INF !RW (SOCK=3 OR SOCK=4) am1 TABSK0>2 FILTLVL<2 CLVL<90]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 3os

//           Reflex Bow
ItemDisplay[NMAG !INF !RW am2 CLVL>59 FILTLVL>1 !TOWN]://
ItemDisplay[NMAG !INF !RW (SOCK=3 OR SOCK=4) am2 TABSK0>2 FILTLVL<2 CLVL<90]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 3os

//          Exceptional tier
//           Ashwood Bow
ItemDisplay[NMAG !INF !RW am6 CLVL>79 FILTLVL>1 !TOWN]://
ItemDisplay[NMAG !INF !RW (SOCK=3 OR SOCK=4) am6 TABSK0>2 FILTLVL<2 CLVL<90]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 3os

//           Ceremonial Bow
ItemDisplay[NMAG !INF !RW am7 CLVL>79 FILTLVL>1 !TOWN]://
ItemDisplay[NMAG !INF !RW (SOCK=3 OR SOCK=4) am7 TABSK0>2 FILTLVL<2 CLVL<90]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 3os

//           Elite tier
//            Matriarchal Bow
ItemDisplay[NMAG !INF !RW ED<5 SOCK=2 amb TABSK0>2 FILTLVL>0 !TOWN]:// Hide 2os
ItemDisplay[NMAG !INF !RW ED>4 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5) amb TABSK0>2 FILTLVL<7]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior 5-15%ED 0os, 3os, 4os, 5os
ItemDisplay[NMAG !INF !RW ED>14 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5) amb TABSK0>2 FILTLVL>6]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior 15%+ED 0os, 3os, 4os, 5os
ItemDisplay[NMAG !INF !RW ED>4 SOCK=2 amb TABSK0>2 FILTLVL>0 !TOWN]://
ItemDisplay[NMAG !INF !RW amb TABSK0>2 FILTLVL>1 ED<5 !TOWN]:// Hide <5 ED at FILTLVL 3+
ItemDisplay[NMAG !INF !RW amb TABSK0>2 FILTLVL>6 ED<15 !TOWN]:// Hide <15 ED at FILTLVL 8+

//            Grand Matron Bow
ItemDisplay[NMAG !INF !RW ED<5 SOCK=2 amc TABSK0>2 FILTLVL>0 !TOWN]:// Hide 2os
ItemDisplay[NMAG !INF !RW ED>4 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5) amc TABSK0>2 FILTLVL<7]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior 5-15%ED 0os, 3os, 4os, 5os
ItemDisplay[NMAG !INF !RW ED>14 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5) amc TABSK0>2 FILTLVL>6]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior 15%+ED 0os, 3os, 4os, 5os
ItemDisplay[NMAG !INF !RW ED>4 SOCK=2 amc TABSK0>2 FILTLVL>0 !TOWN]://
ItemDisplay[NMAG !INF !RW amc TABSK0>2 FILTLVL>1 ED<5 !TOWN]:// Hide <5 ED at FILTLVL 3+
ItemDisplay[NMAG !INF !RW amc TABSK0>2 FILTLVL>6 ED<15 !TOWN]:// Hide <15 ED at FILTLVL 8+


// ------------------------------------------------------------------------------
//   ========================  Amazon Spears and Javelins  ======================
// ------------------------------------------------------------------------------

// Hide Amazon Class Spears and Javelins that don't have at least +1 to Javelin Skills above character level 29
ItemDisplay[NMAG TABSK2<1 (am3 OR am4 OR am8 OR am9 OR amd OR ame OR am5 OR ama OR amf) CLVL>29 FILTLVL>0 !TOWN]://
// Hide Amazon Class Spears and Javelins that don't have at least +2 to Javelin Skills above character level 49
ItemDisplay[NMAG TABSK2<2 (am3 OR am4 OR am8 OR am9 OR amd OR ame OR am5 OR ama OR amf) CLVL>49 FILTLVL>0 !TOWN]://
// Hide Amazon Class Spears and Javelins that don't have at least +3 to Javelin Skills above character level 69
ItemDisplay[NMAG TABSK2<3 (am3 OR am4 OR am8 OR am9 OR amd OR ame OR am5 OR ama OR amf) CLVL>69 FILTLVL>0 !TOWN]://

// Hides nonmagical Zon Class Javelins from character level 80 or on filter levels 2+ (by then most Amazons have used their imbue quests)
ItemDisplay[NMAG TABSK2=3 (am5 OR ama OR amf) (CLVL>79 OR FILTLVL>1) FILTLVL>0 !(amf ETH (SOCK=0 OR SOCK=3) (FILTLVL<7 OR ED>14)) !TOWN]:// S14: eth +3 Matriarchal Javelins with 0 or 3 sockets (Jealousy base) show on levels 0-7, and with 15+ ED on 8-12

//           Maiden Spear, Maiden Pike
ItemDisplay[NMAG !INF !RW (am3 OR am4) !AMAZON SOCK=0 CLVL>19 FILTLVL>0 !TOWN]:// 
ItemDisplay[NMAG !INF !RW (am3 OR am4) CLVL>29 FILTLVL>0 !(am3 SOCK=4 (AMAZON OR FILTLVL<7)) !TOWN]://
ItemDisplay[NMAG !INF !RW (am3 SOCK=4 (AMAZON OR FILTLVL<7)) TABSK2=3]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

//           Ceremonial Spear, Ceremonial Pike
ItemDisplay[NMAG !INF !RW (am8 OR am9) !AMAZON (SOCK=0 OR CLVL>39) FILTLVL>0 !TOWN]:// 
ItemDisplay[NMAG !INF !RW (am8 OR am9) AMAZON CLVL>49 FILTLVL>0 !TOWN]://

//           Matriarchal Spear, Matriarchal Pike
// Hide amazon spears on filter levels 2+ unless character is an amazon
ItemDisplay[NMAG !INF !RW (amd OR ame) !AMAZON FILTLVL>1 !TOWN]://
// Hide matriarchal spears without ED on filter levels 2+ if character is an amazon
ItemDisplay[NMAG !INF !RW amd AMAZON FILTLVL>1 ED<5 !TOWN]://
// Hide matriarchal pikes on filter levels 2+ if character is an amazon
ItemDisplay[NMAG !INF !RW ame AMAZON FILTLVL>1 !TOWN]://
// Hide noneth matriarchal spears and pikes that are not 0, 3, or 4 sockets
ItemDisplay[NMAG !INF !RW (amd OR ame) !ETH TABSK2=3 !(SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL>0 !TOWN]://
// Hide eth matriarchal spears and pikes that are not 0 or 6 sockets
ItemDisplay[NMAG !INF !RW (amd OR ame) ETH TABSK2=3 !(SOCK=0 OR SOCK=6) FILTLVL>0 !TOWN]://

// ------------------------------------------------------------------------------
//    ============================  Assassin Claws  ==========================
// ------------------------------------------------------------------------------

// Hide nonmagical assassin claws that are not Plague, Chaos or Malice bases: on filter levels 2-6 from character level 80 (only a ($) shows when one sells for 25,000+ gold and takes 2 inventory squares or less), and on filter levels 7+
ItemDisplay[NMAG !RW SIN (FILTLVL~2-6 CLVL>79) !(RWB_PLAGUE_CLAW OR RWB_CHAOS_CLAW OR RWB_MALICE_CLAW) GROUND !TOWN SELLPRICE>24999 AREA<3]:%GRAY%(%TAN%$%GRAY%)//
ItemDisplay[NMAG !RW SIN (FILTLVL~2-6 CLVL>79) !(RWB_PLAGUE_CLAW OR RWB_CHAOS_CLAW OR RWB_MALICE_CLAW) GROUND !TOWN (SELLPRICE<25000 OR AREA>2)]://
ItemDisplay[NMAG !RW SIN FILTLVL>6 !(RWB_PLAGUE_CLAW OR RWB_CHAOS_CLAW OR RWB_MALICE_CLAW) !TOWN]:// On filter levels 7+, hide nonmagical assassin claws that are not Plague, Chaos or Malice bases

//      Plague: +3 Wake of Fire or +3 Chain Lightning Sentry on fast bases, or +3 Wake of Fire or +3 Chain Lightning Sentry with +2-3 to Weapon Block/Fade/Dragon Flight/Wake of Inferno/Lightning Sentry
//      Plague: +3 Cobra Strike, +3 Phoenix Strike, +3 Claws of Thunder, +3 Blades of Ice, +3 Fists of Fire
//      Plague: +3 Blade Sentinel with (+3 to Claw and Dagger Mastery/Weapon Block or +1-3 Dragon Flight)
//      Plague: +3 Mind Blast with (+3 Psychic Hammer/Burst of Speed/Weapon Block/Fade or +1-3 Dragon Flight/Death Sentry) when playing as Assassin
ItemDisplay[NMAG !INF !RW RWB_PLAGUE_CLAW]:%ORANGE%Plague %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 

//      Neophyte: +3 Mind Blast or +3 Psychic Hammer
ItemDisplay[NMAG !INF !RW ASSASSIN ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!ASSASSIN CLVL<60) OR (ASSASSIN CLVL<80)) RWB_NEOPHYTE_CLAW !FILTLVL>6]:%ORANGE%Neophyte %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !INF !RW !ASSASSIN ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!ASSASSIN CLVL<60) OR (ASSASSIN CLVL<80)) RWB_NEOPHYTE_CLAW !FILTLVL>6]:%TEAL%Neophyte %NAME%{%NAME%}%CONTINUE%//

//      Eth Base for Chaos
ItemDisplay[NMAG !INF !RW RWB_CHAOS_CLAW]:%ORANGE%Chaos %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

//      Low Req Malice Base for Bossing
ItemDisplay[NMAG !INF !RW ASSASSIN RWB_MALICE_CLAW]:%ORANGE%Malice %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 
ItemDisplay[NMAG !INF !RW !ASSASSIN RWB_MALICE_CLAW]:%TEAL%Malice %NAME%{%NAME%}%CONTINUE%// 

//      Hides assassin claws that do no have +1 to at least 1 skill past level 10
ItemDisplay[NMAG !RW SIN CLVL>9 FILTLVL>0 !(SK251>1 OR SK252>0 OR SK253>0 OR SK254>0 OR SK255>0 OR SK256>0 OR SK257>0 OR SK258>0 OR SK259>0 OR SK260>0 OR SK261>0 OR SK262>0 OR SK263>0 OR SK264>0 OR SK265>0 OR SK266>0 OR SK267>0 OR SK268>0 OR SK269>0 OR SK270>0 OR SK271>0 OR SK272>0 OR SK273>0 OR SK274>0 OR SK275>0 OR SK276>0 OR SK277>0 OR SK278>0 OR SK279>0 OR SK280>0 OR SK366>0 OR RWB_CHAOS_CLAW) !TOWN]:// All tiers

