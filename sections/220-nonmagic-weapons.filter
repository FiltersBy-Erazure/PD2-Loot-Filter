//      Neophyte runeword orb bases: 
//     Character=SORCERESS levels 1-79, +3 to Frost Nova, Fire Ball, Nova, Lightning, Fire Wall, Chain Lightning, Meteor, Blizzard, Hydra, Frozen Orb, Ice Barrage, Combustion
ItemDisplay[NMAG !RW SOR SORCERESS ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!SORCERESS CLVL<60) OR (SORCERESS CLVL<80)) RWB_NEOPHYTE_ORB]:%ORANGE%Neophyte %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !RW SOR !SORCERESS ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!SORCERESS CLVL<60) OR (SORCERESS CLVL<80)) RWB_NEOPHYTE_ORB]:%TEAL%Neophyte %WHITE%%NAME%{%NAME%}%CONTINUE%//

