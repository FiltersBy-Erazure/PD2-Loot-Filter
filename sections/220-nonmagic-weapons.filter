ItemDisplay[NMAG !RW !INF (9sr OR 9tr OR 9br OR 9st) ETH !(SOCK=3 NECROMANCER) CLVL>79 FILTLVL>0 !TOWN]:// Hide Exceptional eth Spears (except War Pike, except 3os for Necromancers) at clvl 80+ on filter levels 1+
ItemDisplay[NMAG !RW !INF (9sr OR 9tr OR 9br OR 9st OR 9p9) !ETH SOCK=0 FILTLVL>0 !TOWN]:// Hide Exceptional noneth Spears with 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF 9p9 !ETH CLVL>79 FILTLVL>0 !TOWN]:// Hide Lance noneth at clvl 80+ on filter levels 1+
ItemDisplay[NMAG !RW !INF 9p9 ETH (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5) CLVL<80 FILTLVL<2]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Lance eth with 0, 3, 4, or 5os below clvl 80 on filter levels 0-1
ItemDisplay[NMAG !RW !INF 9p9 ETH !(SOCK=3 NECROMANCER) (FILTLVL>1 OR CLVL>79) FILTLVL>0 !TOWN]:// Hide Lance eth (except 3os for Necromancers) on filter levels 2+ or at clvl 80+ on filter levels 1+
//  Elite tiers
ItemDisplay[NMAG !RW !INF (7sr OR 7tr OR 7br OR 7st OR 7p7) ((!ETH (SOCK=0 OR SOCK=3)) OR SOCK=2) CLVL>79 FILTLVL>0 !TOWN]:// Hide Elite Spears that are noneth with 0 or 3os, or any with 2os at clvl 80+ on filter levels 1+
ItemDisplay[NMAG !RW !INF (7sr OR 7tr OR 7br OR 7st OR 7p7) !ETH ED<5 ((CLVL>89 FILTLVL>0) OR FILTLVL>1) !TOWN]:// Hide Elite noneth Spears with ED<5 at clvl 90+ on filter levels 1+ or on filter levels 2+
ItemDisplay[NMAG !RW !INF (7sr OR 7tr OR 7br OR 7st OR 7p7) !(ETH (SOCK=4 OR SOCK=5)) ED<5 CLVL>79 FILTLVL>1 !TOWN]:// Hide Elite Spears (except eth with 4 or 5os) with ED<5 at clvl 80+ on filter levels 2+
ItemDisplay[NMAG !RW !INF (7sr OR 7tr OR 7br OR 7st OR 7p7) ED<15 FILTLVL>6 !TOWN]:// Hide Elite Spears with ED<15 on filter levels 7+
ItemDisplay[NMAG !RW !INF ELT SPEAR ETH (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5 OR SOCK=6) FILTLVL<2]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Elite eth Spears with 0, 3, 4, 5, or 6os on filter levels 0-1
ItemDisplay[NMAG !RW !INF ELT SPEAR ETH SUP ED>4 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5 OR SOCK=6) FILTLVL<7]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Elite eth Superior Spears with ED>4 and 0, 3, 4, 5, or 6os on filter levels 0-6
ItemDisplay[NMAG !RW !INF ELT SPEAR ETH SUP ED>14 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5 OR SOCK=6) FILTLVL>6]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Elite eth Superior Spears with ED>14 and 0, 3, 4, 5, or 6os on filter levels 7+
// Purity Tag
ItemDisplay[NMAG !RW !INF ((EXC (CLVL<80 OR NECROMANCER)) OR ELT) (SPEAR OR POLEARM) ETH SOCK=3 FILTLVL<7]:%ORANGE%Purity %GRAY%%NAME%{%NAME%}%CONTINUE%// Show eth 3os Exceptional (below clvl 80 or Necromancer) or Elite Polearms/Spears on filter levels 0-6

// ------------------------------------------------------------------------------
//    =========================  1-Handed Swords  ===========================
// ------------------------------------------------------------------------------

//      Normal 1-Handed Swords
ItemDisplay[NMAG !RW !INF (ssd OR sbr OR flc OR wsd) SOCK=0 FILTLVL>0 !TOWN]:// Hide Normal Short Sword, Sabre, Falchion, War Sword with 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF (ssd OR sbr OR flc OR wsd) CLVL>9 FILTLVL>0 !TOWN]:// Hide Normal Short Sword, Sabre, Falchion, War Sword at clvl 10+ on filter levels 1+

//          Scimitar
ItemDisplay[NMAG !RW !INF scm SOCK=0 CLVL>9 FILTLVL>0 !TOWN]:// Hide Scimitar with 0os at clvl 10+ on filter levels 1+
ItemDisplay[NMAG !RW !INF scm CLVL>19 FILTLVL>0 !TOWN]:// Hide Scimitar at clvl 20+ on filter levels 1+

//          Spirit bases (Crystal Sword, Broad Sword, Long Sword)
ItemDisplay[NMAG !RW !INF crs SOCK=0 (ILVL<26 OR ILVL>40) FILTLVL>0 !TOWN]:// Hide Crystal Sword with 0os and ilvl outside 26-40 (can't roll 4os from Larzuk) on filter levels 1+
ItemDisplay[NMAG !RW !INF crs SOCK=0 (ILVL>25 ILVL<41) CLVL<25]:%WHITE%%NAME% %TAN%[%WHITE%Larzuk%TAN%]%WHITE%%DOT-20%%PX-00%%CONTINUE%// Show Crystal Sword with 0os and ilvl 26-40 below clvl 25 (notify)
ItemDisplay[NMAG !RW !INF crs SOCK=0 (ILVL>25 ILVL<41) CLVL>24]:%WHITE%%NAME% %TAN%[%WHITE%L%TAN%]%WHITE%%CONTINUE%// Show Crystal Sword with 0os and ilvl 26-40 at clvl 25+ (no notify)

ItemDisplay[NMAG !RW !INF bsd SOCK=0 ILVL<26 FILTLVL>0 !TOWN]:// Hide Broad Sword with 0os and ilvl below 26 (can't roll 4os from Larzuk) on filter levels 1+
ItemDisplay[NMAG !RW !INF bsd SOCK=0 ILVL>25 CLVL<25]:%WHITE%%NAME% %TAN%[%WHITE%Larzuk%TAN%]%WHITE%%DOT-20%%PX-00%%CONTINUE%// Show Broad Sword with 0os and ilvl 26+ below clvl 25 (notify)
ItemDisplay[NMAG !RW !INF bsd SOCK=0 ILVL>25 CLVL>24 CLVL<41]:%WHITE%%NAME% %TAN%[%WHITE%L%TAN%]%WHITE%%CONTINUE%// Show Broad Sword with 0os and ilvl 26+ at clvl 25-40 (no notify)

ItemDisplay[NMAG !RW !INF lsd SOCK=0 ILVL<26 FILTLVL>0 !TOWN]:// Hide Long Sword with 0os and ilvl below 26 (can't roll 4os from Larzuk) on filter levels 1+
ItemDisplay[NMAG !RW !INF lsd SOCK=0 ILVL>25 CLVL<25]:%WHITE%%NAME% %TAN%[%WHITE%Larzuk%TAN%]%WHITE%%DOT-20%%PX-00%%CONTINUE%// Show Long Sword with 0os and ilvl 26+ below clvl 25 (notify)
ItemDisplay[NMAG !RW !INF lsd SOCK=0 ILVL>25 CLVL>24 CLVL<41]:%WHITE%%NAME% %TAN%[%WHITE%L%TAN%]%WHITE%%CONTINUE%// Show Long Sword with 0os and ilvl 26+ at clvl 25-40 (no notify)

ItemDisplay[NMAG !RW !INF (crs OR bsd OR lsd) SOCK=0 CLVL>40 FILTLVL>0 !TOWN]:// Hide Crystal Sword, Broad Sword, Long Sword with 0os at clvl 41+ on filter levels 1+
ItemDisplay[NMAG !RW !INF (crs OR bsd OR lsd) (SOCK=2 OR SOCK=3) CLVL>29 FILTLVL>0 !TOWN]:// Hide Crystal Sword, Broad Sword, Long Sword with 2 or 3os at clvl 30+ on filter levels 1+

//      4, 5, and 6 socket Crystal Sword, Broad Sword, Long Sword
ItemDisplay[NMAG !RW !INF (crs OR bsd OR lsd) SOCK=4 CLVL<60]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Crystal Sword, Broad Sword, Long Sword with 4os below clvl 60 (notify)
ItemDisplay[NMAG !RW !INF (crs OR bsd OR lsd) SOCK=4 CLVL>59 CLVL<80]:%GRAY%%NAME%{%NAME%}%CONTINUE%// Show Crystal Sword, Broad Sword, Long Sword with 4os at clvl 60-79 (no notify)
ItemDisplay[NMAG !RW !INF (crs OR bsd OR lsd) SOCK=4 CLVL>79 FILTLVL>0 !TOWN]:// Hide Crystal Sword, Broad Sword, Long Sword with 4os at clvl 80+ on filter levels 1+
ItemDisplay[NMAG !RW !INF crs SOCK=5 FILTLVL<7]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Crystal Sword with 5os on filter levels 0-6
ItemDisplay[NMAG !RW !INF crs SOCK=5 CLVL>79 FILTLVL>6 !TOWN]:// Hide Crystal Sword with 5os at clvl 80+ on filter levels 7+
ItemDisplay[NMAG !RW !INF crs SOCK=6 CLVL>79 FILTLVL>1 !TOWN]:// Hide Crystal Sword with 6os at clvl 80+ on filter levels 2+

// 	Exceptional tier 1-Handed Swords
ItemDisplay[NMAG !RW !INF (9ss OR 9sm OR 9sb OR 9fc OR 9cr OR 9bs OR 9ls OR 9wd) SOCK=0 FILTLVL>0 !TOWN]:// Hide Exceptional 1H Swords with 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF (9ss OR 9sm OR 9sb OR 9fc OR 9cr OR 9bs OR 9ls OR 9wd) CLVL>69 FILTLVL>0 !TOWN]:// Hide Exceptional 1H Swords at clvl 70+ on filter levels 1+

// 	Elite tier 1-Handed Swords (except Phase Blade)
ItemDisplay[NMAG !RW !INF (7ss OR 7fc OR 7wd OR 7sm OR 7sb OR 7bs OR 7ls) !ETH ED<5 SOCK=0 FILTLVL>0 !TOWN]:// Hide Elite 1H Swords (except Phase Blade) noneth with ED<5 and 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF (7ss OR 7fc OR 7wd OR 7sm OR 7sb OR 7bs OR 7ls) SOCK=2 FILTLVL>0 !TOWN]:// Hide Elite 1H Swords (except Phase Blade) with 2os on filter levels 1+
ItemDisplay[NMAG !RW !INF (7ss OR 7fc OR 7wd OR 7sm OR 7sb OR 7bs OR 7ls) ED<10 CLVL>79 FILTLVL>1 !TOWN]:// Hide Elite 1H Swords (except Phase Blade) with ED<10 at clvl 80+ on filter levels 2+
ItemDisplay[NMAG !RW !INF (7ss OR 7fc OR 7wd OR 7sm OR 7sb OR 7bs OR 7ls) ED<15 FILTLVL>6 !TOWN]:// Hide Elite 1H Swords (except Phase Blade) with ED<15 on filter levels 7+

//          Phase Blade
ItemDisplay[NMAG !RW !INF 7cr SOCK=2 FILTLVL>0 !TOWN]:// Hide Phase Blade with 2os on filter levels 1+
ItemDisplay[NMAG !RW !INF 7cr ED<5 !((SOCK=0 OR SOCK=3 OR SOCK=5) FILTLVL<2) !(ETH SOCK=4 FILTLVL<7) FILTLVL>0 !TOWN]:// Hide Phase Blade with ED<5 (except 0, 3 or 5os on filter levels 0-1) on filter levels 1+ (S14: not eth 4os on levels 0-7, Madness base)
ItemDisplay[NMAG !RW !INF 7cr ED<5 !(SOCK=0 FILTLVL<2) !(ETH SOCK=4 FILTLVL<7) CLVL>79 FILTLVL>1 !TOWN]:// Hide Phase Blade with ED<5 (except 0os on filter levels 0-1) at clvl 80+ on filter levels 2+
ItemDisplay[NMAG !RW !INF 7cr ETH SOCK=4 ED<15 FILTLVL>6 !TOWN]:// S14: Madness base: eth 4os Phase Blade shows on filter levels 7+ only with 15+ ED
ItemDisplay[NMAG !RW !INF 7cr ED<15 !(SOCK=0 FILTLVL<2) FILTLVL>6 !TOWN]:// Hide Phase Blade with ED<15 (except 0os on filter levels 0-1) on filter levels 7+
ItemDisplay[NMAG !RW !INF 7cr ED<5 SOCK=3 FILTLVL<2]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Phase Blade with ED<5 and 3os on filter levels 0-1
ItemDisplay[NMAG !RW !INF 7cr ED<5 SOCK=5 FILTLVL<2]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Phase Blade with ED<5 and 5os on filter levels 0-1
ItemDisplay[NMAG !RW !INF 7cr SUP ED>4 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5 OR SOCK=6) FILTLVL~2-6]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Phase Blade Superior with ED>4 and 0, 3, 4, 5, or 6os on filter levels 2-6
ItemDisplay[NMAG !RW !INF 7cr SUP ED>14 (SOCK=0 OR SOCK=3 OR SOCK=4 OR SOCK=5 OR SOCK=6) FILTLVL>6]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Phase Blade Superior with ED>14 and 0, 3, 4, 5, or 6os on filter levels 7+

// ------------------------------------------------------------------------------
//    =========================  2-Handed Swords  ===========================
// ------------------------------------------------------------------------------
//      Normal 2-Handed Swords
ItemDisplay[NMAG !RW !INF (2hs OR clm OR gis OR bsw OR flb OR gsd) SOCK=0 FILTLVL>0 !TOWN]:// Hide Normal 2H Swords with 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF (2hs OR clm OR gis OR bsw OR flb OR gsd) CLVL>29 FILTLVL>0 !TOWN]:// Hide Normal 2H Swords at clvl 30+ on filter levels 1+
//      Exceptional 2-Handed Swords
ItemDisplay[NMAG !RW !INF (92h OR 9cm OR 9gs OR 9b9 OR 9fb OR 9gd) SOCK=0 FILTLVL>0 !TOWN]:// Hide Exceptional 2H Swords with 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF (92h OR 9cm OR 9gs OR 9b9 OR 9fb OR 9gd) CLVL>69 FILTLVL>0 !TOWN]:// Hide Exceptional 2H Swords at clvl 70+ on filter levels 1+
//      Elite 2-Handed Swords
//      Legend Sword (72h), Highland Blade (7cm), Champion Sword (7b7), Balrog Blade (7gs)
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) !ETH FILTLVL>0 !TOWN]:// Hide Legend Sword, Highland Blade, Champion Sword, Balrog Blade noneth on filter levels 1+
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) SOCK=2 FILTLVL>0 !TOWN]:// Hide Legend Sword, Highland Blade, Champion Sword, Balrog Blade with 2os on filter levels 1+
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) ETH (SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL<2]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Legend Sword, Highland Blade, Champion Sword, Balrog Blade eth with 0, 3, or 4os on filter levels 0-1
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) ETH SUP ED>4 (SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL~2-6]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Legend Sword, Highland Blade, Champion Sword, Balrog Blade eth Superior with ED>4 and 0, 3, or 4os on filter levels 2-6
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) ETH SUP ED>14 (SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL>6]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Legend Sword, Highland Blade, Champion Sword, Balrog Blade eth Superior with ED>14 and 0, 3, or 4os on filter levels 7+
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) ED<5 CLVL>79 FILTLVL>1 !TOWN]:// Hide Legend Sword, Highland Blade, Champion Sword, Balrog Blade with ED<5 at clvl 80+ on filter levels 2+
ItemDisplay[NMAG !RW !INF (72h OR 7cm OR 7b7 OR 7gs) ED<15 FILTLVL>6 !TOWN]:// Hide Legend Sword, Highland Blade, Champion Sword, Balrog Blade with ED<15 on filter levels 7+
//      Colossus Blade (7gd), Colossus Sword (7fb)
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) !ETH ED<5 SOCK=0 FILTLVL>0 !TOWN]:// Hide Colossus Blade, Colossus Sword noneth with ED<5 and 0os on filter levels 1+
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) !ETH ED<5 (SOCK=4 OR SOCK=5 OR SOCK=6) CLVL>79 FILTLVL>0 !TOWN]:// Hide Colossus Blade, Colossus Sword noneth with ED<5 and 4, 5, or 6os at clvl 80+ on filter levels 1+
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) !ETH SOCK=3 CLVL>79 FILTLVL>0 !TOWN]:// Hide Colossus Blade, Colossus Sword noneth with 3os at clvl 80+ on filter levels 1+
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) SOCK=2 FILTLVL>0 !TOWN]:// Hide Colossus Blade, Colossus Sword with 2os on filter levels 1+
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) ED<5 CLVL>79 FILTLVL>1 !TOWN]:// Hide Colossus Blade, Colossus Sword with ED<5 at clvl 80+ on filter levels 2+
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) ED<15 FILTLVL>6 !TOWN]:// Hide Colossus Blade, Colossus Sword with ED<15 on filter levels 7+

ItemDisplay[NMAG !RW !INF (7gd OR 7fb) ETH (SOCK=0 OR SOCK~3-6) FILTLVL<2]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Colossus Blade, Colossus Sword eth with 0, 3, 4, 5, or 6os on filter levels 0-1
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) ETH SUP ED>4 (SOCK=0 OR SOCK~3-6) FILTLVL~2-6]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Colossus Blade, Colossus Sword eth Superior with ED>4 and 0, 3, 4, 5, or 6os on filter levels 2-6
ItemDisplay[NMAG !RW !INF (7gd OR 7fb) ETH SUP ED>14 (SOCK=0 OR SOCK~3-6) FILTLVL>6]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Show Colossus Blade, Colossus Sword eth Superior with ED>14 and 0, 3, 4, 5, or 6os on filter levels 7+

// ------------------------------------------------------------------------------
//    =========================  Ethereal Nonmagical  =======================
// ------------------------------------------------------------------------------

// Add Eth tag to Nonmagical items
ItemDisplay[ETH NMAG]:%WHITE%Eth %NAME%{%NAME%}%CONTINUE%//


// Adds "Sup" tag for superiors with less than 10% ED
ItemDisplay[(WEAPON OR ARMOR) SUP NMAG ED<10 !ETH SOCK=0]:%WHITE%Sup %NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(WEAPON OR ARMOR) SUP NMAG !RW ED<10 (SOCK>0 OR ETH)]:%GRAY%Sup %NAME%{%NAME%}%CONTINUE%//

ItemDisplay[(WEAPON !((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND)) SUP NMAG !RW ED>9]:%CORAL%Sup %NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR HELM OR SHIELD) SUP NMAG !RW ED>9]:%TEAL%Sup %NAME%{%NAME%}%CONTINUE%

ItemDisplay[((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND) SUP NMAG ED>4 !ETH SOCK=0]:%WHITE%Sup %NAME%{%NAME%}%CONTINUE%
ItemDisplay[((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND) SUP NMAG !RW ED>4 (SOCK>0 OR ETH)]:%GRAY%Sup %NAME%{%NAME%}%CONTINUE%

ItemDisplay[(GLOVES OR BOOTS OR BELT) SUP NMAG ED>4]:%WHITE%Sup %NAME%{%NAME%}%CONTINUE%

// Adds "Inf" for tag for inferiors
ItemDisplay[INF NMAG !RW ID]:%GRAY%Inf %NAME%{%NAME%}%CONTINUE%//

// ------------------------------------------------------------------------------
//    =======================  %ED tag on Superior Items  ====================
// ------------------------------------------------------------------------------

// Enhanced Defense and Enhanced Damage tags (and the % Attack Rating tag, commented out): on the tag line, see 310-staffmods


// ------------------------------------------------------------------------------
//     ==========================  Paladin Shields  =========================
// ------------------------------------------------------------------------------

// Hide all eth Normal paladin shields
ItemDisplay[NMAG !INF !RW ETH NORM DIN FILTLVL>0 !TOWN]://

// Hide all paladin shields with less than 5 all res at character level 10+
ItemDisplay[NMAG !INF !RW RES<5 DIN CLVL>9 FILTLVL>0 !TOWN]://
// Hide all paladin shields with less than 10 all res at character level 30+
ItemDisplay[NMAG !INF !RW RES<10 DIN CLVL>29 FILTLVL>0 !TOWN]://
// Hide all paladin shields with less than 20 all res at character level 60+
ItemDisplay[NMAG !INF !RW RES<20 DIN CLVL>59 FILTLVL>0 !TOWN]://
// Hide all non-eth paladin shields with less than 25 all res at character level 70+
ItemDisplay[NMAG !INF !RW !ETH RES<25 DIN CLVL>69 FILTLVL>0 !TOWN]://
// Hide all non-eth normal and exceptional paladin shields with less than 29 all res at character level 80+ on filter levels 2+
ItemDisplay[NMAG !INF !RW !ETH (NORM OR EXC) RES<29 DIN CLVL>79 FILTLVL>1 !TOWN]://

// Paladin Exile/Shattered Wall Bases
ItemDisplay[NMAG !INF !RW (SOCK=0 OR SOCK=4) DIN EXC ETH RES>24 (pa8 OR pa9 OR paa) ]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !INF !RW (SOCK=0 OR SOCK=4) DIN ELT ((ETH RES>19) OR (RES>28 (pae OR paf)))]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Label All Res Paladin shields when leveling: on the tag line, see 310-staffmods

ItemDisplay[(CHEST OR HELM OR SHIELD) !SOCK=1 !INF SUP NMAG ED~15-20 !SHOP !RW !(DIN RES<20)]:%BLUE%* %NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(CHEST OR HELM OR SHIELD) !SOCK=1 !INF SUP NMAG ED~18-20 !SHOP !RW !(DIN RES<25) ((EXC CLVL<80) OR ELT)]:%PURPLE%*%NAME%{%NAME%}%CONTINUE%//

ItemDisplay[(WEAPON !((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND)) !SOCK=1 !RW !INF SUP NMAG ED~15-20 !SHOP]:%RED%* %NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(WEAPON !((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND)) !SOCK=1 !RW !INF SUP NMAG ED~18-20 !SHOP ((EXC CLVL<80) OR ELT)]:%PURPLE%*%NAME%{%NAME%}%CONTINUE%//


// Fixing coloring for vendors
ItemDisplay[(UNI OR RW)]:%NAME%%GOLD%{%NAME%}%CONTINUE%
ItemDisplay[SET]:%NAME%%GREEN%{%NAME%}%CONTINUE%
ItemDisplay[RARE]:%NAME%%YELLOW%{%NAME%}%CONTINUE%
ItemDisplay[MAG]:%NAME%%BLUE%{%NAME%}%CONTINUE%
ItemDisplay[(ARMOR OR WEAPON OR QUIVER) NMAG !ETH (SOCK=0 OR THROWING) !opm]:%NAME%%WHITE%{%NAME%}%CONTINUE%
ItemDisplay[(ARMOR OR WEAPON OR QUIVER) NMAG !RW (SOCK>0 OR ETH)]:%NAME%%GRAY%{%NAME%}%CONTINUE%
ItemDisplay[CRAFT]:%NAME%%ORANGE%{%NAME%}%CONTINUE%

