// ------------------------------------------------------------------------------
//     ==========================  Sorceress Staves  ========================   
// ------------------------------------------------------------------------------

// Hide nonmagical staves that are not Memory, CTA, Infinity, Doom or Obsession bases (or 5-6 socket Archon Staves on filter levels 2-6): on filter levels 2-6 from character level 80 (only a ($) shows when one sells for 25,000+ gold and takes 2 inventory squares or less), and on filter levels 7+
ItemDisplay[NMAG !RW STAFF (FILTLVL~2-6 CLVL>79) !(RWB_MEMORY_STAFF OR RWB_CTA_STAFF OR RWB_INFINITY_STAFF OR RWB_DOOM_STAFF OR RWB_OBSESSION_STAFF OR (6ws FILTLVL<7 (SOCK=5 OR SOCK=6))) GROUND !TOWN SELLPRICE>24999 AREA<3]:%GRAY%(%TAN%$%GRAY%)//
ItemDisplay[NMAG !RW STAFF (FILTLVL~2-6 CLVL>79) !(RWB_MEMORY_STAFF OR RWB_CTA_STAFF OR RWB_INFINITY_STAFF OR RWB_DOOM_STAFF OR RWB_OBSESSION_STAFF OR (6ws FILTLVL<7 (SOCK=5 OR SOCK=6))) GROUND !TOWN (SELLPRICE<25000 OR AREA>2)]://
ItemDisplay[NMAG !RW STAFF FILTLVL>6 !(RWB_MEMORY_STAFF OR RWB_CTA_STAFF OR RWB_INFINITY_STAFF OR RWB_DOOM_STAFF OR RWB_OBSESSION_STAFF OR (6ws FILTLVL<7 (SOCK=5 OR SOCK=6))) !TOWN]:// On filter levels 7+, hide nonmagical staves that are not Memory, CTA, Infinity, Doom or Obsession bases

// Memory:
ItemDisplay[NMAG !RW RWB_MEMORY_STAFF]:%ORANGE%Memory %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// CTA: +3 to Energy Shield | +3 to Cold Enchant +1-3 to Fire Enchant | +3 to Fire Enchant +1-3 to Cold Enchant | +1-3 Energy Shield +1-3 Shiver Armor | +1-3 Energy Shield +1-3 Chilling Armor | +1-3 Energy Shield +1-3 Thunderstorm | +1-3 Shiver Armor +1-3 Thunderstorm | +1-3 Chilling Armor +1-3 Thunderstorm
ItemDisplay[NMAG !RW RWB_CTA_STAFF]:%ORANGE%CTA %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Infinity - +3 Nova, Chain Lightning or Charged Bolt, with +1-3 to Lightning Mastery, Teleport, Thunder Storm, Static Field, Energy Shield, Warmth, Shiver Armor or Chilling Armor (or Lightning, with Chain Lightning)
ItemDisplay[NMAG !RW RWB_INFINITY_STAFF]:%ORANGE%Infinity %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Plague (orbs) - +3 Nova, Chain Lightning or Charged Bolt with +3 Teleport or Lightning Mastery, or +3 Meteor (or Fire Ball and Combustion, one +3 and the other +2-3) with +3 Teleport or Fire Mastery
ItemDisplay[NMAG !RW RWB_PLAGUE_ORB]:%ORANGE%Plague %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Doom - Frost Nova, Blizzard, Frozen Orb, Ice Barrage
ItemDisplay[NMAG !RW RWB_DOOM_STAFF]:%ORANGE%Doom %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Obsession - Fire Wall, Frozen Orb, Ice Bolt, Blizzard, Meteor
ItemDisplay[NMAG !RW RWB_OBSESSION_STAFF]:%ORANGE%Obsession %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Leaf - Inferno, Fire Wall (filter levels 0-6)
ItemDisplay[NMAG !RW (SK41>2 OR SK51>2) SOCK=2 STAFF ((NORM CLVL<30) OR (EXC CLVL<60) OR (ELT CLVL<80)) FILTLVL<7]:%ORANGE%Leaf %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Hides all other Staves that don't have + to skills past level 10
ItemDisplay[NMAG !INF !RW STAFF CLVL>9 FILTLVL>0 !(SK36>0 OR SK37>0 OR SK38>0 OR SK39>0 OR SK40>0 OR SK41>0 OR SK42>0 OR SK43>0 OR SK44>0 OR SK45>0 OR SK46>0 OR SK47>0 OR SK48>0 OR SK49>0 OR SK50>0 OR SK51>0 OR SK52>0 OR SK53>0 OR SK54>0 OR SK55>0 OR SK56>0 OR SK57>0 OR SK58>0 OR SK59>0 OR SK60>0 OR SK61>0 OR SK62>0 OR SK63>0 OR SK64>0 OR SK65>0 OR SK369>0 OR SK383>0 OR (6ws FILTLVL<7 (SOCK=5 OR SOCK=6))) FILTLVL>0 !TOWN]:// 

// ------------------------------------------------------------------------------
//    ============================  Scepters  ================================   
// ------------------------------------------------------------------------------

// Hide nonmagical scepters that are not Plague, CTA or Beast bases, or Caduceus with 0 or 4 sockets and +3 Holy Fire or Conviction, 0 or 5 sockets and +3 Might, Concentration, Sanctuary or Conviction, or superior with 10%+ ED and 0, 4 or 5 sockets: on filter levels 2-6 from character level 80 (only a ($) shows when one sells for 25,000+ gold and takes 2 inventory squares or less), and on filter levels 7+
ItemDisplay[NMAG !RW SCEPTER (FILTLVL~2-6 CLVL>79) !((7ws (SOCK=0 OR SOCK=4) (SK102>2 OR SK123>2)) OR (7ws (SOCK=0 OR SOCK=5) (SK98>2 OR SK113>2 OR SK119>2 OR SK123>2)) OR RWB_PLAGUE_SCEPTER OR RWB_CTA_SCEPTER OR RWB_BEAST_SCEPTER OR (7ws SUP ED>9 (SOCK=0 OR SOCK=4 OR SOCK=5))) GROUND !TOWN SELLPRICE>24999 AREA<3]:%GRAY%(%TAN%$%GRAY%)//
ItemDisplay[NMAG !RW SCEPTER (FILTLVL~2-6 CLVL>79) !((7ws (SOCK=0 OR SOCK=4) (SK102>2 OR SK123>2)) OR (7ws (SOCK=0 OR SOCK=5) (SK98>2 OR SK113>2 OR SK119>2 OR SK123>2)) OR RWB_PLAGUE_SCEPTER OR RWB_CTA_SCEPTER OR RWB_BEAST_SCEPTER OR (7ws SUP ED>9 (SOCK=0 OR SOCK=4 OR SOCK=5))) GROUND !TOWN (SELLPRICE<25000 OR AREA>2)]://
ItemDisplay[NMAG !RW SCEPTER FILTLVL>6 !((7ws (SOCK=0 OR SOCK=4) (SK102>2 OR SK123>2)) OR (7ws (SOCK=0 OR SOCK=5) (SK98>2 OR SK113>2 OR SK119>2 OR SK123>2)) OR RWB_PLAGUE_SCEPTER OR RWB_CTA_SCEPTER OR RWB_BEAST_SCEPTER OR (7ws SUP ED>9 (SOCK=0 OR SOCK=4 OR SOCK=5))) !TOWN]:// On filter levels 7+, hide nonmagical scepters (the same bases are kept)

ItemDisplay[NMAG !INF !RW 7ws (SOCK=0 OR SOCK=4) (SK102>2 OR SK123>2)]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !INF !RW 7ws (SOCK=0 OR SOCK=5) (SK98>2 OR SK113>2 OR SK119>2 OR SK123>2)]:%ORANGE%Doom %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

ItemDisplay[NMAG !INF !RW RWB_PLAGUE_SCEPTER]:%ORANGE%Plague %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

ItemDisplay[NMAG !INF !RW PALADIN ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!PALADIN CLVL<60) OR (PALADIN CLVL<80)) RWB_NEOPHYTE_SCEPTER]:%ORANGE%Neophyte %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !INF !RW !PALADIN ((CLVL<90 FILTLVL<7) OR FILTLVL<2) ((!PALADIN CLVL<60) OR (PALADIN CLVL<80)) RWB_NEOPHYTE_SCEPTER]:%TEAL%Neophyte %NAME%{%NAME%}%CONTINUE%//

ItemDisplay[NMAG !INF !RW RWB_CTA_SCEPTER]:%ORANGE%CTA %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

ItemDisplay[NMAG !INF !RW RWB_BEAST_SCEPTER]:%ORANGE%Beast %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

ItemDisplay[NMAG !INF !RW ((wsp ILVL>25) OR 9ws OR 7ws) (SOCK=0 OR SOCK=4) ((SK111>2 OR SK114>2) SK123>2) ((CLVL<90 FILTLVL<7) OR FILTLVL<2)]:%ORANGE%Voice of Reason %NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Hides all other Scepters that don't have + to skills past level 10
ItemDisplay[NMAG !INF !RW SCEPTER CLVL>9 FILTLVL>0 !(SK96>0 OR SK97>0 OR SK98>0 OR SK99>0 OR SK100>0 OR SK101>0 OR SK102>0 OR SK103>0 OR SK104>0 OR SK105>0 OR SK106>0 OR SK107>0 OR SK108>0 OR SK109>0 OR SK110>0 OR SK111>0 OR SK112>0 OR SK113>0 OR SK114>0 OR SK115>0 OR SK116>0 OR SK117>0 OR SK118>0 OR SK119>0 OR SK120>0 OR SK121>0 OR SK122>0 OR SK123>0 OR SK124>0 OR SK125>0 OR SK371>0 OR SK364>0 OR SOCK=4 OR (7ws SUP ED>9 (SOCK=0 OR SOCK=4 OR SOCK=5))) !TOWN]://

// ------------------------------------------------------------------------------
//     ================================  Axes  ==============================   
// ------------------------------------------------------------------------------

