// ------------------------------------------------------------------------------
//    ========================  Cannot Be Frozen Tag  ========================
// ------------------------------------------------------------------------------

// Cannot be Frozen from 2x HFD
ItemDisplay[(CHARSTAT118>1 STAT118=1) EQUIPPED]:%NAME%{%BLUE%Cannot Be Frozen%CL%%NAME%}%CONTINUE%

// ------------------------------------------------------------------------------
//    =========================  Weapon Speed & Range  =======================
// ------------------------------------------------------------------------------

ItemDisplay[WEAPON !BOW !XBOW !WAND !SOR]:%NAME%{%NAME%%CL%%WHITE%Speed: %WPNSPD% %GRAY%| %WHITE%Range: +%RANGE%}%CONTINUE%//
ItemDisplay[WEAPON (BOW OR XBOW)]:%NAME%{%NAME%%CL%%WHITE%Base Speed: %WPNSPD%}%CONTINUE%//

