// Info about Max Sockets from all sources of socketing
// L: Larzuk's quest (magic 2, the rest 1), P: Larzuk's Puzzlebox / Puzzlepiece (2H weapons, bows, crossbows 4; the
// rest 2), C: corruption (2H weapons, bows, crossbows 6; other weapons 4; helms, circlets, chests, shields 3;
// quivers 2), each at most MAXSOCKETS: the game's cap for this base at this item level (ItemTypes MaxSock1 /
// MaxSock25 / MaxSock40 at item level 1-25 / 26-40 / 41+, its gemsockets, its inventory size). BH's 2H misses 7cr2.
// opener
ItemDisplay[(CHEST OR HELM OR CIRC OR SHIELD OR WEAPON OR QUIVER) (RARE OR CRAFT OR UNI OR SET) (NORM OR EXC) ID SOCK=0]:%NAME%{%NAME%%CL%}%CONTINUE%
ItemDisplay[(CHEST OR HELM OR CIRC OR SHIELD OR WEAPON OR QUIVER) MAG ID SOCK=0 MAXSOCKETS>0]:%NAME%{%NAME%%WHITE%Max Sockets: %WHITE%L:$f(MIN(2,MAXSOCKETS))}%CONTINUE%
ItemDisplay[(CHEST OR HELM OR CIRC OR SHIELD OR WEAPON OR QUIVER) (RARE OR CRAFT OR UNI OR SET) ID SOCK=0 MAXSOCKETS>0]:%NAME%{%NAME%%WHITE%Max Sockets: %WHITE%L:1}%CONTINUE%
ItemDisplay[(CHEST OR HELM OR CIRC OR SHIELD OR WEAPON OR QUIVER) !(2H OR 7cr2) (RARE OR CRAFT OR UNI OR SET OR MAG) ID SOCK=0 MAXSOCKETS>0]:%NAME%{%NAME% %TAN%P:%WHITE%$f(MIN(2,MAXSOCKETS))}%CONTINUE%
ItemDisplay[(2H OR 7cr2) (RARE OR CRAFT OR UNI OR SET OR MAG) ID SOCK=0]:%NAME%{%NAME% %TAN%P:%WHITE%$f(MIN(4,MAXSOCKETS))}%CONTINUE%
// corruption
ItemDisplay[(CHEST OR HELM OR CIRC OR SHIELD) (RARE OR CRAFT OR UNI OR SET OR MAG) SOCK=0 STAT360=0 MAXSOCKETS>0]:%NAME%{%NAME% %RED%C:%WHITE%$f(MIN(3,MAXSOCKETS))}%CONTINUE%
ItemDisplay[QUIVER (RARE OR CRAFT OR UNI OR SET OR MAG) SOCK=0 STAT360=0 MAXSOCKETS>0]:%NAME%{%NAME% %RED%C:%WHITE%$f(MIN(2,MAXSOCKETS))}%CONTINUE%
ItemDisplay[WEAPON !(2H OR 7cr2) (RARE OR CRAFT OR UNI OR SET OR MAG) SOCK=0 STAT360=0 MAXSOCKETS>0]:%NAME%{%NAME% %RED%C:%WHITE%$f(MIN(4,MAXSOCKETS))}%CONTINUE%
ItemDisplay[(2H OR 7cr2) (RARE OR CRAFT OR UNI OR SET OR MAG) SOCK=0 STAT360=0]:%NAME%{%NAME% %RED%C:%WHITE%$f(MIN(6,MAXSOCKETS))}%CONTINUE%

