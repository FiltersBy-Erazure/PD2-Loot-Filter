// --------------------------------------------------------------------------------------------------------
// =============================================  Rare Items  =============================================
// --------------------------------------------------------------------------------------------------------

// Hide Rare Items on Filter Level 12
ItemDisplay[RARE !ID (FILTLVL=10 OR FILTLVL=12) (QUIVER OR (ARMOR !CIRC !BOOTS !BELT !(CHEST (ALVL>84 OR CRAFTALVL>84))) OR WEAPON) !TOWN]://

// Keep orginal coloring for items
ItemDisplay[RARE]:%YELLOW%%NAME%%CONTINUE%//
ItemDisplay[ETH RARE]:%WHITE%Eth %NAME%{%NAME%}%CONTINUE%//

// Rare Jewels
ItemDisplay[!POE_SOUNDS RARE !ID jew]:%RARE_HIGH_VALUE_LEFT%  %TAN%(x  %YELLOW%%NAME%  %TAN%x)  %RARE_HIGH_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%%SOUNDID-31%// All unidentified rare Jewels
ItemDisplay[POE_SOUNDS RARE !ID jew]:%RARE_HIGH_VALUE_LEFT%  %TAN%(x  %YELLOW%%NAME%  %TAN%x)  %RARE_HIGH_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%%SOUNDID-4715%// All unidentified rare Jewels

// Filter level 12 
ItemDisplay[RARE !ID (CIRC OR rin OR amu) FILTLVL=12]:%NAME%%DOT-5E%%PX-6D%%TIER-0%// No notifications or flair for rare circlets, rings, or amulets on filter level 12

// Rare Circlets
ItemDisplay[RARE !ID CIRC FILTLVL<12]:%RARE_HIGH_VALUE_LEFT%  %YELLOW%%NAME%  %RARE_HIGH_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%%SOUNDID-31%// All unidentified rare Circlets
// Rare Rings
ItemDisplay[RARE !ID rin FILTLVL<12]:%RARE_HIGH_VALUE_LEFT%  %YELLOW%%NAME%  %RARE_HIGH_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%%SOUNDID-31%// All unidentified rare Rings
// Rare Amulets
ItemDisplay[RARE !ID amu FILTLVL<12]:%RARE_HIGH_VALUE_LEFT%  %YELLOW%%NAME%  %RARE_HIGH_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%%SOUNDID-31%// All unidentified rare Amulets

// Rare Arrows and Bolts
ItemDisplay[RARE !ID QUIVER FILTLVL>11 !AMAZON !TOWN]:// Hide rare arrows on filter levels 12 if character is not an Amazon
ItemDisplay[RARE !ID (aqv OR aqv2 OR aqv3)]:%LIGHT_GRAY%*  %YELLOW%Arrows  %LIGHT_GRAY%*%YELLOW%// Rename all unidentified rare to "Arrows"
ItemDisplay[RARE !ID (cqv OR cqv2 OR cqv3)]:%LIGHT_GRAY%*  %YELLOW%Bolts  %LIGHT_GRAY%*%YELLOW%// Rename all unidentified rare to "Bolts"

// Rare Belts
ItemDisplay[RARE !ID BELT FILTLVL<12]:%RARE_MEDIUM_VALUE_LEFT%  %NAME%  %RARE_MEDIUM_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%//
ItemDisplay[RARE !ID BELT FILTLVL=12]:%NAME%%DOT-5E%%PX-6D%%TIER-0%//
// Rare Boots
ItemDisplay[RARE !ID BOOTS FILTLVL<8]:%RARE_MEDIUM_VALUE_LEFT%  %NAME%  %RARE_MEDIUM_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%//
ItemDisplay[RARE !ID BOOTS FILTLVL~8-11]:%NAME%%DOT-5E%%PX-6D%%TIER-0%// 
ItemDisplay[RARE !ID BOOTS FILTLVL=12]:%NAME%// 
// Rare Gloves
ItemDisplay[RARE !ID GLOVES (CLVL<90 OR FILTLVL<3) !(FILTLVL=10 OR FILTLVL=12)]:%RARE_MEDIUM_VALUE_LEFT%  %NAME%  %RARE_MEDIUM_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%// Notify for rare gloves under character level 90
ItemDisplay[RARE !ID GLOVES (ASSASSIN OR AMAZON) CLVL>89 (FILTLVL<10 OR FILTLVL=11)]:%NAME%%DOT-5E%%PX-6D%%TIER-0%//
ItemDisplay[RARE !ID GLOVES !(ASSASSIN OR AMAZON) CLVL>89 FILTLVL<8]:%NAME%// No chat notification above character level 89

// Rare Chests
ItemDisplay[RARE !ID CHEST (ALVL>84 OR CRAFTALVL>84) FILTLVL=12]:%RARE_MEDIUM_VALUE_LEFT%  %NAME%  %RARE_MEDIUM_VALUE_RIGHT%%YELLOW%// 
ItemDisplay[RARE !ID CHEST (ALVL>84 OR CRAFTALVL>84) FILTLVL~8-11]:%RARE_MEDIUM_VALUE_LEFT%  %NAME%  %RARE_MEDIUM_VALUE_RIGHT%%YELLOW%%BORDER-8F%%MAP-9B%%DOT-5E%%PX-6D%%TIER-0%// 
