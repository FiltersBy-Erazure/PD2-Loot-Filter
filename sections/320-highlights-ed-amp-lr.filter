ItemDisplay[((MAG FCR>29) OR CRAFT OR RARE) STAFF ((SUFFIX=904 CLVL<60) OR SUFFIX=905 OR SUFFIX=906)]:%NAME%{%RED%Amplify Damage%CL%%NAME%}%CONTINUE%//
