// ------------------------------------------------------------------------------
//    ====================  Highlights for High ED, Amp, LR  =================
// ------------------------------------------------------------------------------

//  Magic High Enhanced Damage Weapons (250+)
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING) MAG (EXC OR ELT) ED~250-299 CLVL<80 !EQUIPPED]:%NAME%{%ORANGE%**%YELLOW%**   %ORANGE%+%ED%% Enhanced Damage   %YELLOW%**%ORANGE%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING) MAG (EXC OR ELT) ED~250-299 CLVL<80 EQUIPPED]:%NAME%{%ORANGE%**%YELLOW%**   %ORANGE%+%EDAM%% Enhanced Damage   %YELLOW%**%ORANGE%**%CL%%NAME%}%CONTINUE%//

//  Rare or Crafted High Enhanced Damage Magic Weapons (250-299) under character level 80
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING) (RARE OR CRAFT) ED~250-299 CLVL<80 !EQUIPPED]:%NAME%{%ORANGE%**%YELLOW%**   %ORANGE%+%ED%% Enhanced Damage   %YELLOW%**%ORANGE%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING) (RARE OR CRAFT) ED~250-299 CLVL<80 EQUIPPED]:%NAME%{%ORANGE%**%YELLOW%**   %ORANGE%+%EDAM%% Enhanced Damage   %YELLOW%**%ORANGE%**%CL%%NAME%}%CONTINUE%//

