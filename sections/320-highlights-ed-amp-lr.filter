// ------------------------------------------------------------------------------
//    ====================  Highlights for High ED, Amp, LR  =================
// ------------------------------------------------------------------------------

//  Magic High Enhanced Damage Weapons (250+)
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING) MAG (EXC OR ELT) ED~250-299 CLVL<80 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_250_LEFT%   +%ED%% Enhanced Damage   %HIGHLIGHT_ED_250_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING) MAG (EXC OR ELT) ED~250-299 CLVL<80 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_250_LEFT%   +%EDAM%% Enhanced Damage   %HIGHLIGHT_ED_250_RIGHT%%CL%%NAME%}%CONTINUE%//

//  Rare or Crafted High Enhanced Damage Magic Weapons (250-299) under character level 80
ItemDisplay[WEAPON !STAFF !WAND !SOR (RARE OR CRAFT) ED~250-299 CLVL<80 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_250_LEFT%   +%ED%% Enhanced Damage   %HIGHLIGHT_ED_250_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR (RARE OR CRAFT) ED~250-299 CLVL<80 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_250_LEFT%   +%EDAM%% Enhanced Damage   %HIGHLIGHT_ED_250_RIGHT%%CL%%NAME%}%CONTINUE%//

//  High Enhanced Damage Weapons (300-399)
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING MAG) (MAG OR RARE OR CRAFT) CLVL<80 ED~300-399 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_300_LEFT%   +%ED%% Enhanced Damage   %HIGHLIGHT_ED_300_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING MAG) (MAG OR RARE OR CRAFT) CLVL<80 ED~300-399 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_300_LEFT%   +%EDAM%% Enhanced Damage   %HIGHLIGHT_ED_300_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING MAG) (MAG OR RARE OR CRAFT) CLVL>79 ED~300-399 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_300_CLVL80_LEFT%   +%ED%% Enhanced Damage   %HIGHLIGHT_ED_300_CLVL80_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR !(DAGGER !THROWING MAG) (MAG OR RARE OR CRAFT) CLVL>79 ED~300-399 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_300_CLVL80_LEFT%   +%EDAM%% Enhanced Damage   %HIGHLIGHT_ED_300_CLVL80_RIGHT%%CL%%NAME%}%CONTINUE%//

//  High Enhanced Damage Weapons (400-499)
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED~400-499 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_400_LEFT%    +%ED%% Enhanced Damage    %HIGHLIGHT_ED_400_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED~400-499 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_400_LEFT%    +%EDAM%% Enhanced Damage    %HIGHLIGHT_ED_400_RIGHT%%CL%%NAME%}%CONTINUE%//
//  High Enhanced Damage Weapons (500-599)
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED~500-599 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_500_LEFT%    +%ED%% Enhanced Damage    %HIGHLIGHT_ED_500_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED~500-599 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_500_LEFT%    +%EDAM%% Enhanced Damage    %HIGHLIGHT_ED_500_RIGHT%%CL%%NAME%}%CONTINUE%//
//  High Enhanced Damage Weapons (600-699)
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED~600-699 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_600_LEFT%    +%ED%% Enhanced Damage    %HIGHLIGHT_ED_600_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED~600-699 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_600_LEFT%    +%EDAM%% Enhanced Damage    %HIGHLIGHT_ED_600_RIGHT%%CL%%NAME%}%CONTINUE%//
//  High Enhanced Damage Weapons (700+)
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED>699 !EQUIPPED]:%NAME%{%HIGHLIGHT_ED_700_LEFT%    +%ED%% Enhanced Damage    %HIGHLIGHT_ED_700_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[WEAPON !STAFF !WAND !SOR (MAG OR RARE OR CRAFT) ED>699 EQUIPPED]:%NAME%{%HIGHLIGHT_ED_700_LEFT%    +%EDAM%% Enhanced Damage    %HIGHLIGHT_ED_700_RIGHT%%CL%%NAME%}%CONTINUE%//

// Amplify Damage and Lower Resist sit under Enhanced Damage (the author, 2026-11-07; over it from 2026-10-29)
// Corrupted items show them without stars (the author, 2026-10-30: a full hover box cut the item's name)
// Amplify Damage on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) WEAPON !STAFF !WAND !SOR ((SUFFIX=662 CLVL<60) OR SUFFIX=898 OR SUFFIX=899) (CLVL<60 OR ED>299) !STAT360>0]:%NAME%{%AMPLIFY_LEFT%    %RED%Amplify Damage    %AMPLIFY_RIGHT%%CL%%NAME%}%CONTINUE%//
// Lower Resist on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) WEAPON !STAFF !WAND !SOR ((SUFFIX=907 CLVL<60) OR SUFFIX=908 OR SUFFIX=909) (CLVL<60 OR ED>299) !STAT360>0]:%NAME%{%LOWER_RES_LEFT%     %PURPLE%Lower Resist     %LOWER_RES_RIGHT%%CL%%NAME%}%CONTINUE%//
// Amplify Damage on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) WEAPON !STAFF !WAND !SOR ((SUFFIX=662 CLVL<60) OR SUFFIX=898 OR SUFFIX=899) ((CLVL>59 ED<300) OR STAT360>0)]:%NAME%{%RED%Amplify Damage%CL%%NAME%}%CONTINUE%//
// Lower Resist on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) WEAPON !STAFF !WAND !SOR ((SUFFIX=907 CLVL<60) OR SUFFIX=908 OR SUFFIX=909) ((CLVL>59 ED<300) OR STAT360>0)]:%NAME%{%PURPLE%Lower Resist%CL%%NAME%}%CONTINUE%//

// Amplify Damage on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) (STAFF OR WAND OR SOR) ((SUFFIX=662 CLVL<60) OR SUFFIX=898 OR SUFFIX=899)]:%NAME%{%RED%Amplify Damage%CL%%NAME%}%CONTINUE%//
// Lower Resist on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) (STAFF OR WAND OR SOR) ((SUFFIX=907 CLVL<60) OR SUFFIX=908 OR SUFFIX=909)]:%NAME%{%PURPLE%Lower Resist%CL%%NAME%}%CONTINUE%//

// Amplify Damage on Casting (staves only)
ItemDisplay[((MAG FCR>29) OR CRAFT OR RARE) STAFF ((SUFFIX=904 CLVL<60) OR SUFFIX=905 OR SUFFIX=906)]:%NAME%{%RED%Amplify Damage%CL%%NAME%}%CONTINUE%//
// Lower Resist on Casting (staves only)
ItemDisplay[((MAG FCR>29) OR CRAFT OR RARE) STAFF ((SUFFIX=910 CLVL<60) OR SUFFIX=911 OR SUFFIX=912)]:%NAME%{%PURPLE%Lower Resist%CL%%NAME%}%CONTINUE%//

