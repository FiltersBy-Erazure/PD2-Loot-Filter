// Amplify Damage on Striking
ItemDisplay[(MAG OR CRAFT OR RARE) WEAPON !STAFF !WAND !SOR ((SUFFIX=662 CLVL<60) OR SUFFIX=898 OR SUFFIX=899) (CLVL<60 OR ED>299)]:%NAME%{%AMPLIFY_LEFT%    %RED%Amplify Damage    %AMPLIFY_RIGHT%%CL%%NAME%}%CONTINUE%//
// Lower Resist on Striking
