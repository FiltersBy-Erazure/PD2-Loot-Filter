// -------------------------------------------------------------------------------------------------------
// ============================================  Magic Items  ============================================
// -------------------------------------------------------------------------------------------------------

// Hide Magic Items on Filter Level 12
ItemDisplay[MAG !ID (FILTLVL=10 OR FILTLVL=12) (ARMOR OR WEAPON) !((uts OR uow OR uit) CRAFTALVL>84) !TOWN]://

// Keep orginal coloring for items
ItemDisplay[MAG]:%BLUE%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[ETH MAG]:%WHITE%Eth %NAME%{%NAME%}%CONTINUE%//

// Magic Amulets
ItemDisplay[MAG !ID amu FILTLVL>7 !TOWN]:// Hide unidentified magic amulets on filter levels 8+

ItemDisplay[MAG !ID amu CLVL>79 FILTLVL<8]:%NAME%// No map or chat notification for magic amulets past level 80
ItemDisplay[MAG !ID amu CLVL<80 FILTLVL<8]:%TAN%o  %NAME%  %TAN%o%BLUE%%BORDER-91%%MAP-97%%DOT-5A%%PX-DA%// All unidentified amulets

// Magic Charms

// Hide all Large Charms on Filter Levels 11-12
ItemDisplay[MAG !ID (FILTLVL~11-12) cm2 !TOWN]://
// Hide Large Charms that aren't item level 90+ on Filter Levels 8-10
ItemDisplay[MAG !ID ILVL<90 (FILTLVL~8-10) cm2 !TOWN]://
// Hide Small and Grand Charms that aren't item level 90+ on Filter Level 12
ItemDisplay[MAG !ID ILVL<90 FILTLVL=12 (cm1 OR cm3) !TOWN]://

// Item Level 91+ Grand Charms
ItemDisplay[MAG !ID ILVL>90 cm3 FILTLVL<12 GROUND]:%MAGIC_CHARM_LEFT%  %BLUE%Grand Charm %WHITE%• %BLUE%%ILVL%  %MAGIC_CHARM_RIGHT%%BLUE%%BORDER-8F%%MAP-91%%DOT-C5%%PX-9F%// iLvl 91 or higher grand charms for cube rerolling
ItemDisplay[MAG !ID ILVL>90 cm3 FILTLVL<12 !GROUND]:%MAGIC_CHARM_LEFT%  %BLUE%Grand Charm %WHITE%• %BLUE%Item Level %ILVL%  %MAGIC_CHARM_RIGHT%%BLUE%%BORDER-8F%%MAP-91%%DOT-C5%%PX-9F%// iLvl 91 or higher grand charms for cube rerolling

// Add item level to 90+ magic charms
ItemDisplay[MAG !ID ILVL>89 (cm1 OR cm2 OR cm3) GROUND]:%NAME% %WHITE%• %BLUE%%ILVL%%CONTINUE%//
ItemDisplay[MAG !ID ILVL>89 (cm1 OR cm2 OR cm3) !GROUND]:%NAME% %WHITE%• %BLUE%Item Level %ILVL%%CONTINUE%//

// Charm Notifications
// Small Charms and Grand Charms
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL=12 ILVL>89]:%NAME%%BORDER-8F%%MAP-91%%DOT-C5%%PX-9F%%CONTINUE%//
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL=12 ILVL<90]:%NAME%%MAP-91%%DOT-C5%%PX-9F%%TIER-0%%CONTINUE%//
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL~8-11 ILVL>89]:%NAME%%BORDER-8F%%MAP-91%%DOT-C5%%PX-9F%%CONTINUE%//
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL~8-11 ILVL<90]:%NAME%%MAP-91%%DOT-C5%%PX-9F%%CONTINUE%//
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL<8]:%NAME%%BORDER-8F%%MAP-91%%DOT-C5%%PX-9F%%CONTINUE%//

// Large Charms
ItemDisplay[MAG !ID cm2 FILTLVL<8]:%NAME%%BORDER-8F%%MAP-91%%DOT-C5%%PX-9F%%CONTINUE%//

// Charm Symbols
// Small and Grand Charms
ItemDisplay[MAG !ID (cm1 OR cm3) ILVL>89]:%TEAL%\%BLUE%(%PURPLE%(  %NAME%  %PURPLE%)%BLUE%)%TEAL%/%BLUE%{%NAME%}//
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL<8 ILVL<90]:%TEAL%\%BLUE%(%PURPLE%(  %NAME%  %PURPLE%)%BLUE%)%TEAL%/%BLUE%{%NAME%}//
ItemDisplay[MAG !ID (cm1 OR cm3) FILTLVL>7 ILVL<90]:%TEAL%\%BLUE%((  %NAME%  %BLUE%))%TEAL%/%BLUE%{%NAME%}//
// Large Charms
ItemDisplay[MAG !ID cm2 FILTLVL~8-10 ILVL>89]:%PURPLE%-  %NAME%  %PURPLE%-%BLUE%{%NAME%}//
ItemDisplay[MAG !ID cm2 FILTLVL~8-10 ILVL<90]:%TEAL%-  %NAME%  %TEAL%-%BLUE%{%NAME%}//
ItemDisplay[MAG !ID cm2 FILTLVL<8]:%TEAL%\%BLUE%(%PURPLE%(  %NAME%  %PURPLE%)%BLUE%)%TEAL%/%BLUE%{%NAME%}//

// Magic Rings
ItemDisplay[MAG !ID rin CLVL>79 FILTLVL>2 !TOWN]:// Hide unidentified magic rings on filter level 5 or higher
ItemDisplay[MAG !ID rin CLVL<80 FILTLVL>2]:%TAN%•  %NAME%  %TAN%•%BLUE%//

ItemDisplay[MAG !ID rin CLVL<20 FILTLVL<2]:%TAN%•  %NAME%  %TAN%•%BLUE%%MAP-91%%DOT-97%%PX-0E%// All unidentified rings
ItemDisplay[MAG !ID rin CLVL>19 FILTLVL<2]:%TAN%•  %NAME%  %TAN%•%BLUE%// Do not notify for magic rings after character level 19

// Magic Circlets
ItemDisplay[MAG !ID !ETH CIRC FILTLVL<8]:%TAN%o  %NAME%  %TAN%o%BLUE%%BORDER-91%%MAP-97%%DOT-5A%%PX-DA%// Notify for magic circlets before character level 80

// Magic Jewels
ItemDisplay[jewf QTY>1]:%TAN%(x %BLUE%Jewel %TAN%x) %WHITE%Fragments %TAN%x %WHITE%%QTY%{%BLUE%Jewel %WHITE%when crafting%CL%%WHITE%Use in place of a}%MAP-91%%DOT-97%%PX-A6%// Jewel fragments
ItemDisplay[jewf QTY=1]:%TAN%(x %BLUE%Jewel %TAN%x) %WHITE%Fragment{%BLUE%Jewel %WHITE%when crafting%CL%%WHITE%Use in place of a}%MAP-91%%DOT-97%%PX-A6%// Jewel fragments

ItemDisplay[MAG !ID jew MAPID~183-184]:%TAN%(x  %BLUE%Jewel  %TAN%x)%BLUE%%DOT-97%%PX-0E%%TIER-0%// All unidentified magic jewels
ItemDisplay[MAG !ID jew CLVL>29 FILTLVL~8-11 !MAPID~183-184]:%TAN%(x  %BLUE%Jewel  %TAN%x)%BLUE%%DOT-97%%PX-0E%// All unidentified magic jewels
ItemDisplay[MAG !ID jew CLVL>29 FILTLVL=12 !MAPID~183-184]:%TAN%(x  %BLUE%Jewel  %TAN%x)%BLUE%%DOT-97%%PX-0E%%TIER-0%// All unidentified magic jewels
ItemDisplay[MAG !ID jew CLVL>29 FILTLVL<8 !MAPID~183-184]:%TAN%* %BLUE%>  %TAN%(x  %BLUE%Jewel  %TAN%x)  %BLUE%< %TAN%*%BLUE%%MAP-91%%DOT-97%%PX-0E%// All unidentified magic jewels
ItemDisplay[MAG !ID jew CLVL<30 FILTLVL<12]:%TAN%* %BLUE%>  %TAN%(x  %BLUE%Jewel  %TAN%x)  %BLUE%< %TAN%*%BLUE%%MAP-91%%DOT-97%%PX-0E%// All unidentified magic jewels

// Magic Amazon Spears

ItemDisplay[MAG !ID !ETH AMAZON (am3 OR am4 OR am8 OR am9 OR amd OR ame) FILTLVL>7 !TOWN]://
ItemDisplay[MAG !ID ETH AMAZON (am3 OR am4 OR am8 OR am9 OR amd OR ame) (FILTLVL=10 OR FILTLVL=12) !TOWN]://

