//----------------------------------------------------------------------------------------------------------
// ===========================================  Map Display: End  ==========================================
//----------------------------------------------------------------------------------------------------------
// Every map's display ends here, after the experience tags of 146. These rules also hold the maps' minimap
// icons: in BH's notification pass the first matching rule without %CONTINUE% ends a map's icons.

// Dungeons (Tier 4)
ItemDisplay[MAPTIER=4]:%NAME%%BORDER-05%%MAP-62%%DOT-68%%PX-6D%{%NAME%}//

// Unique Maps
ItemDisplay[(t54 OR t55 OR t56)]:%NAME%%BORDER-8F%%MAP-9B%%DOT-5A%%PX-AA%{%NAME%}//
ItemDisplay[(t52 OR t53 OR t57)]:%NAME%%BORDER-05%%MAP-0A%%DOT-5A%%PX-AA%{%NAME%}//
ItemDisplay[(t51 OR t58)]:%NAME%%BORDER-71%%MAP-75%%DOT-5A%%PX-AA%{%NAME%}//

// Maps (Tiers 1-3)
ItemDisplay[NMAG MAPTIER~1-3]:%NAME%%DOT-D6%%PX-20%%WHITE%{%NAME%}//
ItemDisplay[MAG MAPTIER~1-3]:%NAME%%DOT-97%%PX-99%%BLUE%{%NAME%}//
ItemDisplay[RARE MAPTIER~1-3]:%NAME%%DOT-5E%%PX-6D%%YELLOW%{%NAME%}//

// Arenas
ItemDisplay[(t61 OR t62)]:%BLUE%\%WHITE%\%BLUE%V%WHITE%/%BLUE%/  %WHITE%%NAME%  %BLUE%\%WHITE%\%BLUE%V%WHITE%/%BLUE%/%WHITE%{%GRAY%Portal can be used for shopping%NL%%TAN%to open Dueling Arena%CL%Right click in Act 1}// Items for PvP arenas
