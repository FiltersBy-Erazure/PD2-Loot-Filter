// ---------------------------------------------------------------------
// ========================  Maximum Resistances  ======================
// ---------------------------------------------------------------------


// Rare/Crafted Amulets - 2% Max Res
// MaxRes(c) 40+Life/15+Str/15+Dex, 5+FCR/10+AllRes/20+C.Res/20+L.Res/20+F.Res/20+P.Res, +2-3 to Class/Tab Skills
ItemDisplay[(RARE OR CRAFT) amu ID (STAT40=2 STAT42=2 STAT44=2 STAT46=2) (LIFE>39 OR STR>14 OR DEX>14) (FCR>4 OR RES>9 OR CRES>19 OR FRES>19 OR PRES>19) (TABSK40>1 OR TABSK41>1 OR TABSK42>1 OR TABSK32>1 OR TABSK33>1 OR TABSK34>1 OR TABSK24>1 OR TABSK25>1 OR TABSK26>1 OR TABSK16>1 OR TABSK17>1 OR TABSK18>1 OR TABSK8>1 OR TABSK9>1 OR TABSK10>1 OR TABSK48>1 OR TABSK49>1 OR TABSK50>1 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1)]:%NAME%{%PURPLE%Max Resistances%CL%%NAME%}%CONTINUE%//
ItemDisplay[(RARE OR CRAFT) amu ID (STAT40=4 STAT42=4 STAT44=4 STAT46=4) (LIFE>39 OR STR>14 OR DEX>14) (FCR>4 OR RES>9 OR CRES>19 OR FRES>19 OR PRES>19) (TABSK40>1 OR TABSK41>1 OR TABSK42>1 OR TABSK32>1 OR TABSK33>1 OR TABSK34>1 OR TABSK24>1 OR TABSK25>1 OR TABSK26>1 OR TABSK16>1 OR TABSK17>1 OR TABSK18>1 OR TABSK8>1 OR TABSK9>1 OR TABSK10>1 OR TABSK48>1 OR TABSK49>1 OR TABSK50>1 OR TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1)]:%NAME%{%GREEN%***%DARK_GREEN%**%BLUE%**   %PURPLE%Max Resistances   %BLUE%**%DARK_GREEN%**%GREEN%***%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Belts - 2% Max Res
// 2% MaxRes (c), 30+Life/15+Str, 8+%PDR/10+FCR/17+FHR/25%PLR, 19+C.Res/19+L.Res/19+F.Res/19+P.Res
ItemDisplay[(RARE OR CRAFT) BELT ID (STAT40=2 STAT42=2 STAT44=2 STAT46=2) (LIFE>29 OR STR>14) (STAT36>7 OR FHR>16 OR FCR>9 OR STAT110>24) (CRES>19 OR LRES>19 OR FRES>19 OR PRES>19)]:%NAME%{%PURPLE%Max Resistances%CL%%NAME%}%CONTINUE%//


// ------------------------------------------------------------------------------
//    ===========================  Resistances Tags  =========================
// ------------------------------------------------------------------------------

// All Resistances
ItemDisplay[!((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR ((SHIELD !DIN) OR (DIN RES>19)) OR CHEST OR HELM OR CIRC OR rin OR amu) ((RES>5 STAT360=51) OR (rin RES>7) OR RES>14)]:%NAME%{%LIGHT_GRAY%**%GRAY%**%PURPLE%**   %PURPLE%All Resistances   %PURPLE%**%GRAY%**%LIGHT_GRAY%**%CL%%NAME%}//
// Tri Resistance
ItemDisplay[!((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR (SHIELD !DIN) OR CHEST OR HELM OR CIRC OR rin OR amu) (((PRES>14 FRES>14 CRES>14) CLVL<50) OR (PRES>14 FRES>14 CRES>14 PRES+FRES+CRES>29))]:%NAME%{%RED%**%DARK_GREEN%**%BLUE%**   %PURPLE%Triple Resist   %BLUE%**%DARK_GREEN%**%RED%**%CL%%NAME%}//
