// Keep orginal coloring for Set items
ItemDisplay[SET]:%GREEN%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ETH SET]:%WHITE%Eth %NAME%{%NAME%}%CONTINUE%//

// High Value Set Items
ItemDisplay[SET !ID urn]:%NAME%%SOUNDID-2585%%CONTINUE%// Griswold's Valor Corona
ItemDisplay[SET !ID paf]:%NAME%%SOUNDID-2585%%CONTINUE%// Griswold's Honor Vortex Shield
ItemDisplay[SET !ID 7ws]:%NAME%%SOUNDID-2594%%CONTINUE%// Griswold's Redemption Caduceus
ItemDisplay[SET !ID uar]:%NAME%%SOUNDID-2585%%CONTINUE%// Immortal King's Soul Cage Sacred Armor
ItemDisplay[SET !ID uth]:%NAME%%SOUNDID-2585%%CONTINUE%// Tal Rasha's Guardianship Lacquered Plate

ItemDisplay[SET !ID (urn OR paf OR 7ws OR uar OR uth)]:%SET_HIGH_VALUE_LEFT%  %GREEN%%NAME%  %SET_HIGH_VALUE_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-84%%PX-20%//

// Medium Value Set Items
ItemDisplay[SET !ID dr8 FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Aldur's Stony Gaze Hunter's Guise
ItemDisplay[SET !ID uul FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Aldur's Deception Shadow Plate
ItemDisplay[SET !ID xtb FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Aldur's Advance Battle Boots
ItemDisplay[SET !ID ci3 FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// M'avina's True Sight Diadem
ItemDisplay[SET !ID uh9 FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Trang-Oul's Guise Bone Visage
ItemDisplay[SET !ID xmg FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Trang-Oul's Claws Heavy Bracers
ItemDisplay[SET !ID ne9 FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Trang-Oul's Wing Cantor Trophy
ItemDisplay[SET !ID xhm FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Guillaume's Face Winged Helm
ItemDisplay[SET !ID ulg FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Laying of Hands Bramble Mitts
ItemDisplay[SET !ID 7qr FILTLVL<12]:%NAME%%SOUNDID-2594%%CONTINUE%// Natalya's Mark Scissors Suwayyah
ItemDisplay[SET !ID ucl FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Natalya's Shadow Loricated Mail
ItemDisplay[SET !ID ETH 7fb FILTLVL<12]:%NAME%%SOUNDID-2594%%CONTINUE%// Eth Bul-Kathos' Tribal Guardian Colossus Sword
ItemDisplay[SET !ID ETH 7gd FILTLVL<12]:%NAME%%SOUNDID-2594%%CONTINUE%// Eth Bul-Kathos' Sacred Charge Colossus Blade
ItemDisplay[SET !ID ETH 7ls FILTLVL<12]:%NAME%%SOUNDID-2594%%CONTINUE%// Eth Sazabi's Cobalt Redeemer Cryptic Sword
ItemDisplay[SET !ID utc FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Trang-Oul's Girth Troll Belt
ItemDisplay[SET !ID uts FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Taebaek's Glory Ward
ItemDisplay[SET !ID 6cs FILTLVL<12]:%NAME%%SOUNDID-2594%%CONTINUE%// Naj's Puzzler Elder Staff
ItemDisplay[SET !ID xh9 FILTLVL<12]:%NAME%%SOUNDID-2585%%CONTINUE%// Natalya's Totem Grim Helm

ItemDisplay[SET !ID FILTLVL<5 (xtb OR uh9 OR xmg OR ne9 OR ulg OR 7qr OR ucl OR (ETH (7fb OR 7gd OR 7ls)))]:%SET_HIGH_VALUE_LEFT%  %GREEN%%NAME%  %SET_HIGH_VALUE_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-84%%PX-20%// The high value look on levels 0-4
ItemDisplay[SET !ID ((FILTLVL~5-11 (xtb OR uh9 OR xmg OR ne9 OR ulg OR 7qr OR ucl OR (ETH (7fb OR 7gd OR 7ls)))) OR (FILTLVL<12 (uul OR ci3 OR dr8 OR xhm OR utc OR uts OR 6cs OR xh9)))]:%SET_MEDIUM_VALUE_LEFT%  %GREEN%%NAME%  %SET_MEDIUM_VALUE_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-84%%PX-20%// Aldur's Deception and M'avina's True Sight on levels 0-4 too (the author, 2026-10-26), and Aldur's Stony Gaze, Guillaume's Face, Trang-Oul's Girth, Taebaek's Glory, Naj's Puzzler and Natalya's Totem (the author, 2026-10-29: the tier price review)
ItemDisplay[SET !ID FILTLVL=12 (dr8 OR uul OR xtb OR ci3 OR uh9 OR xmg OR ne9 OR xhm OR ulg OR 7qr OR ucl OR utc OR uts OR 6cs OR xh9 OR (ETH (7fb OR 7gd OR 7ls)))]:%NAME%// The plain name on level 12: no look, icon or sound

// Undiscovered Set Items (Grail): every unidentified set item you haven't discovered yet (Discovery Progress) that no
// rule above notifies, rings and amulets too, gets a chat line and the Grail icon on every filter level (the author,
// 2026-10-25). Identified ones get none: an item is discovered when it is identified, so an identified one on the
// ground is one a player dropped, in town too. The rules that give the icon stop, so no later rule's icon covers it
// (the author, 2026-10-29). Rings and amulets keep the set look of their rules below: a rule here gives that look
// with the Grail icon, and this %CONTINUE% layer (no look) gives the icon where those rules show none (rings on level
// 12 at character level 80+, amulets on 5-12 at 90+)
ItemDisplay[SET !ID GRAIL_NEW (rin OR amu)]:%NAME%{%NAME%}%BORDER-71%%MAP-76%%DOT-7D%%PX-69%%CONTINUE%//

// The Grail look: every set item the tiers above leave, but rings and amulets, until you've discovered it, on every
// filter level, ahead of the Low Level Duel look
ItemDisplay[SET !ID GRAIL_NEW !(rin OR amu)]:%SET_GRAIL_LEFT%  %NAME%  %SET_GRAIL_RIGHT%%BORDER-71%%MAP-76%%DOT-7D%%PX-69%//

// Rings and amulets: the set look of their rules below, with the Grail icon, where those rules show it
ItemDisplay[SET !ID GRAIL_NEW ((rin !(CLVL>79 FILTLVL>11)) OR (amu !(CLVL>89 FILTLVL>4)))]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-69%//

// Low Level Duel Set Items
ItemDisplay[SET !ID !ETH FILTLVL<5 (vbt OR vgl OR xlb)]:%SET_LLD_LEFT%  %NAME%  %SET_LLD_RIGHT%%GREEN%%BORDER-71%%MAP-C5%%DOT-9F%%PX-A2%//
ItemDisplay[SET !ID !ETH FILTLVL~5-11 (vbt OR vgl OR xlb)]:%NAME%//

// Rings and Amulets
ItemDisplay[SET !ID rin CLVL>79 FILTLVL>11 !TOWN]:%NAME%//
ItemDisplay[SET !ID rin CLVL>79 FILTLVL<12]:%SET_LEFT%  %GREEN%%NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%//
ItemDisplay[SET !ID rin CLVL<80]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//

ItemDisplay[SET !ID amu CLVL>89 FILTLVL>4 GROUND !TOWN !GRAIL_NEW]://
ItemDisplay[SET !ID amu CLVL>89 FILTLVL<5]:%SET_LEFT%  %GREEN%%NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%//
ItemDisplay[SET !ID amu CLVL<90]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//

// Normal Set Items
ItemDisplay[SET !ID NORM kit CLVL>59 FILTLVL~3-7]:%SET_NORMAL_LEFT%  %NAME%  %SET_NORMAL_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%// Milabrega's Orb Kite Shield: its levels 0-2 look on 3-7, the plain name on 8-11, hidden on 12 (the author, 2026-10-30)
ItemDisplay[SET !ID NORM kit CLVL<60 FILTLVL~3-7]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//
ItemDisplay[SET !ID NORM kit FILTLVL~8-11]:%NAME%//
ItemDisplay[SET !ID NORM lbt FILTLVL~5-12]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//
ItemDisplay[SET !ID NORM (ba5 OR lbl OR lgl OR tow) FILTLVL~5-12]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%//
ItemDisplay[SET !ID NORM !(lbt OR ba5 OR lbl OR lgl OR tow) FILTLVL~5-12 GROUND !TOWN !GRAIL_NEW]://

ItemDisplay[SET !ID NORM (lbt OR ba5 OR lbl OR lgl OR tow) FILTLVL<5]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//
ItemDisplay[SET !ID NORM stu FILTLVL~3-4]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%// S14: Cow King's Hide shows through level 7 like the Horns (full set gives Cow Form)
ItemDisplay[SET !ID NORM !(lbt OR ba5 OR lbl OR lgl OR tow) FILTLVL~3-4 !GRAIL_NEW GROUND !TOWN]://

ItemDisplay[SET !ID NORM CLVL>59 FILTLVL<3]:%SET_NORMAL_LEFT%  %NAME%  %SET_NORMAL_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%//
ItemDisplay[SET !ID NORM CLVL<60 FILTLVL<3]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//

// Exceptional Set items
ItemDisplay[SET !ID EXC (xhm OR dr8 OR xtb OR xar OR zvb OR xtg OR xmb OR xsk OR zmb OR oba OR xul OR xhb OR zhb OR xhg OR xh9 OR xvg) FILTLVL=12 !TOWN]:%NAME%//
ItemDisplay[SET !ID EXC !(xhm OR dr8 OR xtb OR xar OR zvb OR xtg OR xmb OR xsk OR zmb OR oba OR xul OR xhb OR zhb OR xhg OR xh9 OR xvg) FILTLVL=12 GROUND !TOWN !GRAIL_NEW]://

