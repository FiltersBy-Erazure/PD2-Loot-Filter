ItemDisplay[SET !ID EXC !(xhm OR dr8 OR xtb OR xar OR zvb OR xtg OR xmb OR xsk OR zmb OR oba OR xul OR xhb OR zhb OR xhg OR xh9 OR xvg) FILTLVL~5-11 GROUND !TOWN !GRAIL_NEW]://

ItemDisplay[SET !ID EXC (xhm OR dr8 OR xtb OR xar OR zvb OR xtg OR xmb OR xsk OR zmb OR oba OR xul OR xhb OR zhb OR xhg OR xh9 OR xvg) FILTLVL~3-4]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%BORDER-71%%MAP-76%%DOT-7D%%PX-84%//
ItemDisplay[SET !ID EXC !(xhm OR dr8 OR xtb OR xar OR zvb OR xtg OR xmb OR xsk OR zmb OR oba OR xul OR xhb OR zhb OR xhg OR xh9 OR xvg) FILTLVL~3-4]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%//
ItemDisplay[SET !ID EXC FILTLVL<3]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-84%//

// Elite Set items
ItemDisplay[SET !ID ELT (ulg OR uhm OR uld OR amc OR ucl OR 6cs OR 7m7 OR uar) FILTLVL=12 !TOWN]:%NAME%//
ItemDisplay[SET !ID ELT !(ulg OR uhm OR uld OR amc OR ucl OR 6cs OR 7m7 OR uar) FILTLVL=12 GROUND !TOWN !GRAIL_NEW]://

ItemDisplay[SET !ID ELT (ulg OR uhm OR uld OR amc OR ucl OR 6cs OR 7m7 OR uar) FILTLVL~5-11]:%SET_LEFT%  %NAME%  %SET_RIGHT%%GREEN%%MAP-71%%DOT-76%%PX-81%%TIER-0%//
ItemDisplay[SET !ID ELT !(ulg OR uhm OR uld OR amc OR ucl OR 6cs OR 7m7 OR uar) FILTLVL~5-11 GROUND !TOWN !GRAIL_NEW]://

