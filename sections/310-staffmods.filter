// ------------------------------------------------------------------------------
//     =========================  Staffmods Display ======================
// ------------------------------------------------------------------------------

// Show staffmods on second line
//Assassin Claws, Daggers, Wands, and Necromancer Shields
ItemDisplay[(NMAG OR MAG) !EQUIPPED !RW (SK251>0 OR SK252>0 OR SK253>0 OR SK254>0 OR SK255>0 OR SK256>0 OR SK257>0 OR SK258>0 OR SK259>0 OR SK260>0 OR SK261>0 OR SK262>0 OR SK263>0 OR SK264>0 OR SK265>0 OR SK266>0 OR SK267>0 OR SK268>0 OR SK269>0 OR SK270>0 OR SK271>0 OR SK272>0 OR SK273>0 OR SK274>0 OR SK275>0 OR SK276>0 OR SK277>0 OR SK278>0 OR SK279>0 OR SK280>0 OR SK366>0)]:%CL%%NAME%{%NAME%}%CONTINUE%//
//Assassin Claws, Daggers, Wands, and Necromancer Shields
