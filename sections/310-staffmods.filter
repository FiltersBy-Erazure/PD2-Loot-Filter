// Show staffmods on NMAG items


// Add +skills tag to Amazon spears and javelins
ItemDisplay[NMAG !RW TABSK2>0]:%CL%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[NMAG !RW TABSK2=1]:%WHITE%+1%DARK_GREEN%jav%TAN%sk%CS%%GRAY%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[NMAG !RW TABSK2=2]:%WHITE%+2%DARK_GREEN%jav%TAN%sk%CS%%GRAY%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[NMAG !RW TABSK2=3]:%WHITE%+3%DARK_GREEN%jav%TAN%sk%CS%%GRAY%%NAME%{%NAME%}%CONTINUE%

// Add +skills tag to Amazon bows
ItemDisplay[NMAG !RW TABSK0>0]:%CL%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[NMAG !RW TABSK0=1]:%WHITE%+1%DARK_GREEN%bow%TAN%sk%CS%%NAME%{%NAME%}%CONTINUE%
