// -------------------------------------------------------------------------------
//     =======================  Low Cost Vendor Tag ($)  =====================
// -------------------------------------------------------------------------------

ItemDisplay[MAG CLVL>79 BUYPRICE<70000 CRAFTALVL>84 ((CHEST !STAT78>0) OR (SHIELD !NEC)) SHOP]:%GRAY%(%ORANGE%$%GRAY%) %NAME%{%NAME%}%CONTINUE%// Orange $ Tag at Vendors
ItemDisplay[MAG CLVL>49 CRAFTALVL>49 ((DIFF=0 BUYPRICE<30000) OR (DIFF=1 BUYPRICE<50000) OR (DIFF=2 BUYPRICE<100000)) (BAR OR DRU OR NEC OR STAFF OR SOR OR btl OR 9tw OR 7tw OR axf OR 9xf OR 7xf OR wsp OR (WAND !(wnd OR ywn OR 9wn)) OR clb OR 9cl OR spc OR 9sp) SHOP]:%GRAY%(%ORANGE%$%GRAY%) %NAME%{%NAME%}%CONTINUE%// Orange $ Tag at Vendors

