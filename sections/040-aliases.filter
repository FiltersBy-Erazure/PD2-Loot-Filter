Alias[UNI_EXCEPTIONAL_RIGHT]:%WHITE%•  %GOLD%< %GRAY%*%GOLD%*

// Unique Elite
Alias[UNI_ELITE_LEFT]:%GOLD%\%GRAY%\  %GOLD%>  %WHITE%•
Alias[UNI_ELITE_RIGHT]:%WHITE%•  %GOLD%<  %GRAY%/%GOLD%/

// Set High Value
Alias[SET_HIGH_VALUE_LEFT]:%PURPLE%\%DARK_GREEN%\  %GREEN%>  %WHITE%o
Alias[SET_HIGH_VALUE_RIGHT]:%WHITE%o  %GREEN%<  %DARK_GREEN%/%PURPLE%/

// Set Medium Value
Alias[SET_MEDIUM_VALUE_LEFT]:%PURPLE%*%DARK_GREEN%* %GREEN%>  %WHITE%•
Alias[SET_MEDIUM_VALUE_RIGHT]:%WHITE%•  %GREEN%< %DARK_GREEN%*%PURPLE%*

// Set LLD
Alias[SET_LLD_LEFT]:%TEAL%*%DARK_GREEN%* %GREEN%>
Alias[SET_LLD_RIGHT]:%GREEN%< %DARK_GREEN%*%TEAL%*

// Set
Alias[SET_LEFT]:%PURPLE%*%DARK_GREEN%* %GREEN%>
Alias[SET_RIGHT]:%GREEN%< %DARK_GREEN%*%PURPLE%*

// Set Normal: normal-tier set items at character level 60+ (levels 0-2)
Alias[SET_NORMAL_LEFT]:%DARK_GREEN%*%GREEN%* >
Alias[SET_NORMAL_RIGHT]:%GREEN%< *%DARK_GREEN%*

// Rare High Value
Alias[RARE_HIGH_VALUE_LEFT]:%PURPLE%\%YELLOW%\ %PURPLE%• %YELLOW%>
Alias[RARE_HIGH_VALUE_RIGHT]:%YELLOW%< %PURPLE%• %YELLOW%/%PURPLE%/

// Rare Medium Value
Alias[RARE_MEDIUM_VALUE_LEFT]:%PURPLE%• %YELLOW%>
Alias[RARE_MEDIUM_VALUE_RIGHT]:%YELLOW%< %PURPLE%•

// Rare Eth Craft
Alias[RARE_ETH_CRAFT_LEFT]:%ORANGE%• %YELLOW%>
Alias[RARE_ETH_CRAFT_RIGHT]:%YELLOW%< %ORANGE%•

// Magic Eth Craft
Alias[MAGIC_ETH_CRAFT_LEFT]:%ORANGE%• %BLUE%>
Alias[MAGIC_ETH_CRAFT_RIGHT]:%BLUE%< %ORANGE%•

// Magic Charms
Alias[MAGIC_CHARM_LEFT]:%TEAL%\(%PURPLE%(
Alias[MAGIC_CHARM_RIGHT]:%PURPLE%)%TEAL%)/

// Rare Jewels: the name between (x and x)
Alias[RARE_JEWEL_NAME]:%TAN%(x  %YELLOW%%NAME%  %TAN%x)

// Magic Jewels: the name between (x and x)
Alias[MAGIC_JEWEL_NAME]:%TAN%(x  %BLUE%Jewel  %TAN%x)

// Magic Jewel arrows: the * > and < * around the name (levels 0-4, or below character level 30)
Alias[MAGIC_JEWEL_LEFT]:%TAN%* %BLUE%>
Alias[MAGIC_JEWEL_RIGHT]:%BLUE%< %TAN%*

// Magic Rings
Alias[MAGIC_RING_LEFT]:%TAN%•
Alias[MAGIC_RING_RIGHT]:%TAN%•

// Magic Small, Grand and Large Charms (Small and Grand on levels 0-4 or of item level 90+, Large on levels 0-6)
Alias[MAGIC_CHARMS_LEFT]:%TEAL%\%BLUE%(%PURPLE%(
Alias[MAGIC_CHARMS_RIGHT]:%PURPLE%)%BLUE%)%TEAL%/

// Magic Small and Grand Charms below item level 90 (levels 5-12)
Alias[MAGIC_CHARMS_DIM_LEFT]:%TEAL%\%BLUE%((
Alias[MAGIC_CHARMS_DIM_RIGHT]:%BLUE%))%TEAL%/

// Magic Large Charms of item level 90+ (levels 8 and 10)
Alias[MAGIC_LARGE_CHARM_90_LEFT]:%PURPLE%-
Alias[MAGIC_LARGE_CHARM_90_RIGHT]:%PURPLE%-

// Magic Large Charms below item level 90 (levels 8 and 10)
Alias[MAGIC_LARGE_CHARM_LEFT]:%TEAL%-
Alias[MAGIC_LARGE_CHARM_RIGHT]:%TEAL%-

// Blue Teal Highlight
Alias[HIGHLIGHT_1_LEFT]:%BLUE%***%TEAL%****
Alias[HIGHLIGHT_1_RIGHT]:%TEAL%****%BLUE%***

// Blue Purple Red Orange Highlight
Alias[HIGHLIGHT_2_LEFT]:%BLUE%**%PURPLE%**%RED%**%ORANGE%***
Alias[HIGHLIGHT_2_RIGHT]:%ORANGE%***%RED%**%PURPLE%**%BLUE%**

// Amplify Damage
Alias[AMPLIFY_LEFT]:%PURPLE%**%RED%**%ORANGE%**%YELLOW%*
Alias[AMPLIFY_RIGHT]:%YELLOW%*%ORANGE%**%RED%**%PURPLE%**

// Lower Resist
Alias[LOWER_RES_LEFT]:%BLUE%**%PURPLE%**%RED%**%ORANGE%*
Alias[LOWER_RES_RIGHT]:%ORANGE%*%RED%**%PURPLE%**%BLUE%**

// Tier 1 Maps - non-unique
Alias[TIER_1_MAPS]:(MAPTIER=1 !UNI)

// Tier 2 Maps - non-unique
Alias[TIER_2_MAPS]:(MAPTIER=2 !UNI)

// Tier 3 Maps - non-unique
Alias[TIER_3_MAPS]:(MAPTIER=3 !UNI)

// Unique Maps
Alias[UNIQUE_MAPS]:(t51 OR t52 OR t53 OR t54 OR t55 OR t56 OR t57 OR t58)

// Tier 4 Dungeons
Alias[DUNGEONS]:(t41 OR t42 OR t43 OR t44)

