// =====================================  Aliases  ==================================

// When character is in one of the five town MAP IDs
Alias[TOWN]:(MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109)

// S14: Grail (Discovery Progress). A unique or set item not yet discovered; an unidentified one counts
// as discovered only when every unique/set it could be is. Hide rules for uniques and sets end with
// !GRAIL_NEW, so these items are never hidden until discovered. Without discovery data (Season 13
// clients) those hide rules never match.
Alias[GRAIL_NEW]:((UNI OR SET) !ALLDISCOVERED)

// Lowest Runes
Alias[LOWEST_RUNE_LOW_QTY_LEFT]:%DARK_GREEN%x%GRAY%x%LIGHT_GRAY%x
Alias[LOWEST_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%GRAY%x%DARK_GREEN%x
Alias[LOWEST_RUNE_HIGH_QTY_LEFT]:%DARK_GREEN%\x%GRAY%\x%LIGHT_GRAY%\x
Alias[LOWEST_RUNE_HIGH_QTY_RIGHT]:%LIGHT_GRAY%x/%GRAY%x/%DARK_GREEN%x/

// Low Runes
Alias[LOW_RUNE_LOW_QTY_LEFT]:%BLUE%x%GRAY%x%LIGHT_GRAY%x
Alias[LOW_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%GRAY%x%BLUE%x
Alias[LOW_RUNE_HIGH_QTY_LEFT]:%BLUE%\x%GRAY%\x%LIGHT_GRAY%\x
Alias[LOW_RUNE_HIGH_QTY_RIGHT]:%LIGHT_GRAY%x/%GRAY%x/%BLUE%x/

// Mid Runes
Alias[MID_RUNE_LOW_QTY_LEFT]:%ORANGE%x%YELLOW%x%TAN%x%LIGHT_GRAY%x
Alias[MID_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%TAN%x%YELLOW%x%ORANGE%x
Alias[MID_RUNE_HIGH_QTY]:%ORANGE%x%YELLOW%x%TAN%o%YELLOW%x%ORANGE%x

// Lem Low Qty
Alias[LEM_RUNE_LOW_QTY_LEFT]:%DARK_GREEN%x%GREEN%x%TAN%x%LIGHT_GRAY%x
Alias[LEM_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%TAN%x%GREEN%x%DARK_GREEN%x

// Pul Low Qty
Alias[PUL_RUNE_LOW_QTY]:%DARK_GREEN%x%GREEN%x%TAN%xox%GREEN%x%DARK_GREEN%x

// Lem Pul High Qty
Alias[LEM_PUL_RUNE_HIGH_QTY]:%DARK_GREEN%x%GREEN%x%YELLOW%x%TAN%o%YELLOW%x%GREEN%x%DARK_GREEN%x

// Um Mal
Alias[UM_RUNE]:%DARK_GREEN%x%GREEN%xX%YELLOW%X%TAN%O%YELLOW%X%GREEN%Xx%DARK_GREEN%x
Alias[MAL_RUNE]:%DARK_GREEN%xX%GREEN%\X%YELLOW%X%TAN%O%YELLOW%X%GREEN%X/%DARK_GREEN%Xx

// Ist Gul
Alias[IST_GUL_RUNE]:%BLUE%xX%DARK_GREEN%\X%GREEN%\X%YELLOW%X%TAN%O%YELLOW%X%GREEN%X/%DARK_GREEN%X/%BLUE%Xx

// Vex Ohm Lo
Alias[VEX_OHM_LO_RUNE]:%BLUE%xX%PURPLE%\X%ORANGE%\X%YELLOW%X%TAN%O%YELLOW%X%ORANGE%X/%PURPLE%X/%BLUE%Xx

// Sur Ber Jah Cham Zod BIG GG
Alias[SUR_BER_JAH_CHAM_ZOD_BIG_GG]:%PURPLE%xX%RED%\X%ORANGE%\X%YELLOW%X%TAN%O%YELLOW%X%ORANGE%X/%RED%X/%PURPLE%Xx

// Worldstone Low Qty
Alias[WORLDSTONE_LOW_QTY]:%RED%x%CORAL%x%WHITE%o%CORAL%x%RED%x

// Worldstone High Qty
Alias[WORLDSTONE_HIGH_QTY]:%RED%xX%CORAL%X%WHITE%O%CORAL%X%RED%Xx

// Catalyst Shard
Alias[CATALYST_SHARD]:%GRAY%x%LIGHT_GRAY%X%WHITE%XOX%LIGHT_GRAY%X%GRAY%x

// Puzzlepiece
Alias[PUZZLEPIECE_LEFT]:%GOLD%[%ORANGE%X%GOLD%][%YELLOW%X%GOLD%][%TAN%X%GOLD%]
Alias[PUZZLEPIECE_RIGHT]:%GOLD%[%TAN%X%GOLD%][%YELLOW%X%GOLD%][%ORANGE%X%GOLD%]

// Puzzlebox
Alias[PUZZLEBOX_LEFT]:%GOLD%[%BLUE%X%GOLD%][%PURPLE%X%GOLD%][%ORANGE%X%GOLD%][%TAN%X%GOLD%]
Alias[PUZZLEBOX_RIGHT]:%GOLD%[%TAN%X%GOLD%][%ORANGE%X%GOLD%][%PURPLE%X%GOLD%][%BLUE%X%GOLD%]

// Demonic Cube
Alias[DEMONIC_CUBE]:%RED%xX%CORAL%\X%WHITE%\XOX/%CORAL%X/%RED%Xx

// Skeleton Key
Alias[SKELETON_KEY]:%GOLD%\%BLACK%\%GOLD%\%GOLD%X%GOLD%/%BLACK%/%GOLD%/

// Horadric Almanac
Alias[ALMANAC]:%RED%I%GOLD%X%RED%iIIi%GOLD%X%RED%I

// Horadric Navigator
Alias[NAVIGATOR]:%BLUE%I%GOLD%X%BLUE%iIIi%GOLD%X%BLUE%I

// Vial of Lightsong
Alias[VIAL]:%PURPLE%xX%BLUE%xX%LIGHT_GRAY%x\%WHITE%\V/%LIGHT_GRAY%/x%BLUE%Xx%PURPLE%Xx

// Lilith's Mirror
Alias[MIRROR]:%PURPLE%xX%RED%xX%ORANGE%x\%TAN%\%WHITE%V%TAN%/%ORANGE%/x%RED%Xx%PURPLE%Xx

// Key of Destruction
Alias[DKEY]:%DARK_GREEN%\%GREEN%\\%DARK_GREEN%X%GREEN%/%GREEN%/%DARK_GREEN%/

// Key of Hate
Alias[HKEY]:%CORAL%\%RED%\\%CORAL%X%RED%/%RED%/%CORAL%/

// Key of Terror
Alias[TKEY]:%BLUE%\%TEAL%\\%BLUE%X%TEAL%/%TEAL%/%BLUE%/

// Rainbow Facet
Alias[FACET_LEFT]:%GREEN%\\%BLUE%\\%PURPLE%\\%RED%\\%ORANGE%\\%YELLOW%\\
Alias[FACET_RIGHT]:%YELLOW%/%YELLOW%/%ORANGE%/%ORANGE%/%RED%/%RED%/%PURPLE%/%PURPLE%/%BLUE%/%BLUE%/%GREEN%/%GREEN%/

// Uniques from Diablo Clone and Rathma
Alias[UNI_DCLONE_RATHMA]:%BLUE%X\%TEAL%X\%GREEN%X\O/X%TEAL%/X%BLUE%/X

// Unique High Value
Alias[UNI_HIGH_VALUE_LEFT]:%BLUE%\\%PURPLE%\\%RED%\\%ORANGE%\\  %GOLD%>  %WHITE%O  
Alias[UNI_HIGH_VALUE_RIGHT]:%WHITE%O  %GOLD%<  %ORANGE%/%ORANGE%/%RED%/%RED%/%PURPLE%/%PURPLE%/%BLUE%/%BLUE%/%GOLD%

// Unique Medium Value
Alias[UNI_MEDIUM_VALUE_LEFT]:%RED%\\%ORANGE%\\%YELLOW%\  %GOLD%>  %WHITE%•
Alias[UNI_MEDIUM_VALUE_RIGHT]:%WHITE%•  %GOLD%<  %YELLOW%/%ORANGE%/%ORANGE%/%RED%/%RED%/%GOLD%

// Unique Minimal Value
Alias[UNI_MINIMAL_VALUE_LEFT]:%RED%\%ORANGE%\\  %GOLD%>  %WHITE%•
Alias[UNI_MINIMAL_VALUE_RIGHT]:%WHITE%•  %GOLD%<  %ORANGE%/%ORANGE%/%RED%/%GOLD%

// Unique LLD
Alias[UNI_LLD_LEFT]:%GRAY%*%TEAL%* %WHITE%>
Alias[UNI_LLD_RIGHT]:%WHITE%< %TEAL%*%GRAY%*

// Unique Normal
Alias[UNI_NORMAL_LEFT]:%GOLD%*%GRAY%* %WHITE%>
Alias[UNI_NORMAL_RIGHT]:%WHITE%< %GRAY%*%GOLD%*

// Unique Exceptional
Alias[UNI_EXCEPTIONAL_LEFT]:%GOLD%*%GRAY%* %GOLD%>  %WHITE%•
Alias[UNI_EXCEPTIONAL_RIGHT]:%WHITE%•  %GOLD%< %GRAY%*%GOLD%*

// Unique Elite
Alias[UNI_ELITE_LEFT]:%GOLD%\%GRAY%\  %GOLD%>  %WHITE%•
Alias[UNI_ELITE_RIGHT]:%WHITE%•  %GOLD%<  %GRAY%/%GOLD%/

// Set High Value
Alias[SET_HIGH_VALUE_LEFT]:%PURPLE%\%DARK_GREEN%\  %GREEN%>  %WHITE%o
Alias[SET_HIGH_VALUE_RIGHT]:%WHITE%o  %GREEN%<  %DARK_GREEN%/%PURPLE%/

// Set LLD
Alias[SET_LLD_LEFT]:%TEAL%*%DARK_GREEN%* %GREEN%>
Alias[SET_LLD_RIGHT]:%GREEN%< %DARK_GREEN%*%TEAL%*

// Set
Alias[SET_LEFT]:%PURPLE%*%DARK_GREEN%* %GREEN%>
Alias[SET_RIGHT]:%GREEN%< %DARK_GREEN%*%PURPLE%*

// Rare High Value
Alias[RARE_HIGH_VALUE_LEFT]:%PURPLE%\%YELLOW%\ %PURPLE%• %YELLOW%>
Alias[RARE_HIGH_VALUE_RIGHT]:%YELLOW%< %PURPLE%• %YELLOW%/%PURPLE%/

// Rare Medium Value
Alias[RARE_MEDIUM_VALUE_LEFT]:%PURPLE%• %YELLOW%>
Alias[RARE_MEDIUM_VALUE_RIGHT]:%YELLOW%< %PURPLE%•

// Rare Eth Craft
Alias[RARE_ETH_CRAFT_LEFT]:%ORANGE%• %YELLOW%>
Alias[RARE_ETH_CRAFT_RIGHT]:%YELLOW%< %ORANGE%•

// Magic Eth Craft
Alias[MAGIC_ETH_CRAFT_LEFT]:%ORANGE%• %BLUE%>
Alias[MAGIC_ETH_CRAFT_RIGHT]:%BLUE%< %ORANGE%•

// Magic Charms
Alias[MAGIC_CHARM_LEFT]:%TEAL%\(%PURPLE%(
Alias[MAGIC_CHARM_RIGHT]:%PURPLE%)%TEAL%)/

// Green Teal Blue Highlight
Alias[HIGHLIGHT_1_LEFT]:%GRAY%**%BLUE%**%TEAL%***
Alias[HIGHLIGHT_1_RIGHT]:%TEAL%***%BLUE%**%GRAY%**

// Blue Purple Red Orange Highlight
Alias[HIGHLIGHT_2_LEFT]:%BLUE%**%PURPLE%**%RED%**%ORANGE%***
Alias[HIGHLIGHT_2_RIGHT]:%ORANGE%***%RED%**%PURPLE%**%BLUE%**

// Amplify Damage
Alias[AMPLIFY_LEFT]:%PURPLE%**%RED%**%ORANGE%**%YELLOW%*
Alias[AMPLIFY_RIGHT]:%YELLOW%*%ORANGE%**%RED%**%PURPLE%**

// Lower Resist
Alias[LOWER_RES_LEFT]:%BLUE%**%PURPLE%**%RED%**%ORANGE%*
Alias[LOWER_RES_RIGHT]:%ORANGE%*%RED%**%PURPLE%**%BLUE%**

// Tier 1 Maps - non-unique
Alias[TIER_1_MAPS]:(MAPTIER=1 !UNI)

// Tier 2 Maps - non-unique
Alias[TIER_2_MAPS]:(MAPTIER=2 !UNI)

// Tier 3 Maps - non-unique
Alias[TIER_3_MAPS]:(MAPTIER=3 !UNI)

// Unique Maps
Alias[UNIQUE_MAPS]:(t51 OR t52 OR t53 OR t54 OR t55 OR t56 OR t57 OR t58)

// Tier 4 Dungeons
Alias[DUNGEONS]:(t41 OR t42 OR t43 OR t44)

