// =====================================  Aliases  ==================================

// When character is in one of the five town MAP IDs
// S14: or in a Guild Hall (MAPID 202-206, "Guild 1-5" in Levels.txt; town-like, no combat)
Alias[TOWN]:(MAPID=1 OR MAPID=40 OR MAPID=75 OR MAPID=103 OR MAPID=109 OR MAPID~202-206)

// S14: Grail (Discovery Progress). A unique or set item not yet discovered; an unidentified one counts
// as discovered only when every unique/set it could be is. Hide rules for uniques and sets end with
// !GRAIL_NEW, so these items are never hidden until discovered. Without discovery data (Season 13
// clients) those hide rules never match.
Alias[GRAIL_NEW]:((UNI OR SET) !ALLDISCOVERED)

// Lowest Runes
Alias[LOWEST_RUNE_LOW_QTY_LEFT]:%DARK_GREEN%x%GRAY%x%LIGHT_GRAY%x
Alias[LOWEST_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%GRAY%x%DARK_GREEN%x
Alias[LOWEST_RUNE_HIGH_QTY_LEFT]:%DARK_GREEN%\x%GRAY%\x%LIGHT_GRAY%\x
Alias[LOWEST_RUNE_HIGH_QTY_RIGHT]:%LIGHT_GRAY%x/%GRAY%x/%DARK_GREEN%x/

// Low Runes
Alias[LOW_RUNE_LOW_QTY_LEFT]:%BLUE%x%GRAY%x%LIGHT_GRAY%x
Alias[LOW_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%GRAY%x%BLUE%x
Alias[LOW_RUNE_HIGH_QTY_LEFT]:%BLUE%\x%GRAY%\x%LIGHT_GRAY%\x
Alias[LOW_RUNE_HIGH_QTY_RIGHT]:%LIGHT_GRAY%x/%GRAY%x/%BLUE%x/

// Mid Runes
Alias[MID_RUNE_LOW_QTY_LEFT]:%ORANGE%x%YELLOW%x%TAN%x%LIGHT_GRAY%x
Alias[MID_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%TAN%x%YELLOW%x%ORANGE%x
Alias[MID_RUNE_HIGH_QTY]:%ORANGE%x%YELLOW%x%TAN%o%YELLOW%x%ORANGE%x

// Lem Low Qty
Alias[LEM_RUNE_LOW_QTY_LEFT]:%DARK_GREEN%x%GREEN%x%TAN%x%LIGHT_GRAY%x
Alias[LEM_RUNE_LOW_QTY_RIGHT]:%LIGHT_GRAY%x%TAN%x%GREEN%x%DARK_GREEN%x

// Pul Low Qty
Alias[PUL_RUNE_LOW_QTY]:%DARK_GREEN%x%GREEN%x%TAN%xox%GREEN%x%DARK_GREEN%x

// Lem Pul High Qty
Alias[LEM_PUL_RUNE_HIGH_QTY]:%DARK_GREEN%x%GREEN%x%YELLOW%x%TAN%o%YELLOW%x%GREEN%x%DARK_GREEN%x

// Um Mal
Alias[UM_RUNE]:%DARK_GREEN%x%GREEN%xX%YELLOW%X%TAN%O%YELLOW%X%GREEN%Xx%DARK_GREEN%x
Alias[MAL_RUNE]:%DARK_GREEN%xX%GREEN%\X%YELLOW%X%TAN%O%YELLOW%X%GREEN%X/%DARK_GREEN%Xx

// Ist Gul
Alias[IST_GUL_RUNE]:%BLUE%xX%DARK_GREEN%\X%GREEN%\X%YELLOW%X%TAN%O%YELLOW%X%GREEN%X/%DARK_GREEN%X/%BLUE%Xx

// Vex Ohm Lo
Alias[VEX_OHM_LO_RUNE]:%BLUE%xX%PURPLE%\X%ORANGE%\X%YELLOW%X%TAN%O%YELLOW%X%ORANGE%X/%PURPLE%X/%BLUE%Xx

// Sur Ber Jah Cham Zod BIG GG
Alias[SUR_BER_JAH_CHAM_ZOD_BIG_GG]:%PURPLE%xX%RED%\X%ORANGE%\X%YELLOW%X%TAN%O%YELLOW%X%ORANGE%X/%RED%X/%PURPLE%Xx

// Worldstone Low Qty
Alias[WORLDSTONE_LOW_QTY]:%RED%x%CORAL%x%WHITE%o%CORAL%x%RED%x

// Worldstone High Qty
Alias[WORLDSTONE_HIGH_QTY]:%RED%xX%CORAL%X%WHITE%O%CORAL%X%RED%Xx

// Catalyst Shard
Alias[CATALYST_SHARD]:%GRAY%x%LIGHT_GRAY%X%WHITE%XOX%LIGHT_GRAY%X%GRAY%x

// Puzzlepiece
Alias[PUZZLEPIECE_LEFT]:%GOLD%[%ORANGE%X%GOLD%][%YELLOW%X%GOLD%][%TAN%X%GOLD%]
Alias[PUZZLEPIECE_RIGHT]:%GOLD%[%TAN%X%GOLD%][%YELLOW%X%GOLD%][%ORANGE%X%GOLD%]

// Puzzlebox
Alias[PUZZLEBOX_LEFT]:%GOLD%[%BLUE%X%GOLD%][%ORANGE%X%GOLD%][%YELLOW%X%GOLD%][%TAN%X%GOLD%]
Alias[PUZZLEBOX_RIGHT]:%GOLD%[%TAN%X%GOLD%][%YELLOW%X%GOLD%][%ORANGE%X%GOLD%][%BLUE%X%GOLD%]

// Demonic Cube
Alias[DEMONIC_CUBE]:%RED%xX%CORAL%\X%WHITE%\XOX/%CORAL%X/%RED%Xx

