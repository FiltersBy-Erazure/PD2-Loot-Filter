Alias[BOSSTAG_RA_GLOVES]:((RARE OR CRAFT) GLOVES ID STAT110>24 IAS>19 (TABSK0>1 OR TABSK2>1 OR TABSK50>1) $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,IAS>29,AR>99,EDAM>29,STAT141>9,STAT136>9,STAT116>0,RES>4,FRES>14,CRES>14,PRES>14,STAT153>0,STAT153>0,IF(STAT153>0,0,STAT118>0),STAT360==0)>=3))
ItemDisplay[BOSSTAG_RA_GLOVES]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
