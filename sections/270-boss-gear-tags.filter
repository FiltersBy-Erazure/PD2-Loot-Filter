// ------------------------------------------------------------------------------
//    ===============  Boss Gear Tags Display (Rathma, Diablo Clone, Lucion)  ===============
// ------------------------------------------------------------------------------

// One description line per item naming every boss it suits, in the order Rathma / D.Clone / Lucion (names red,
// slashes gray). Rathma needs PLR and counts fire, cold and poison resistances, never lightning. D.Clone and Lucion
// share their rules but for the resistance: D.Clone counts fire (and lightning on belts and gloves), Lucion lightning.
// Each slot's conditions are aliases, BOSSTAG_RA_<slot> (Rathma), BOSSTAG_DC_<slot> (D.Clone) and BOSSTAG_LU_<slot>
// (Lucion); the slot's rules are the combinations of them.

// Rare/Crafted Amulets
// Rathma: 50+ PLR mandatory, 4+ desirable affixes
// D.Clone / Lucion: uncorrupted, or corrupted to +1 all skills, all max res or cannot be frozen, mandatory; 5+ desirable
// affixes (20+ fire / lightning res is one)
Alias[BOSSTAG_RA_AMU]:((RARE OR CRAFT) amu ID STAT110>49 $f(COUNT(LIFE>29,STR>14,DEX>14,ALLATTRIB>4,ALLSK>0,FCR>9,FHR>9,STAT96>9,STAT20>0,AR>99,EDAM>29,RES>9,FRES>29,CRES>29,PRES>29,MAXRES>1,STAT118==1,STAT153==1,STAT360==0,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=4))
Alias[BOSSTAG_DC_AMU]:((RARE OR CRAFT) amu ID (STAT360=0 OR STAT360=45 OR STAT360=50 OR STAT360=72) $f(COUNT(LIFE>29,STR>14,DEX>14,ALLATTRIB>4,ALLSK>0,FCR>9,FHR>9,STAT96>9,STAT20>0,AR>99,EDAM>29,RES>9,FRES>19,MAXRES>1,STAT118==1,STAT153==1,STAT360==0,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=5))
Alias[BOSSTAG_LU_AMU]:((RARE OR CRAFT) amu ID (STAT360=0 OR STAT360=45 OR STAT360=50 OR STAT360=72) $f(COUNT(LIFE>29,STR>14,DEX>14,ALLATTRIB>4,ALLSK>0,FCR>9,FHR>9,STAT96>9,STAT20>0,AR>99,EDAM>29,RES>9,LRES>19,MAXRES>1,STAT118==1,STAT153==1,STAT360==0,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=5))
ItemDisplay[BOSSTAG_RA_AMU BOSSTAG_DC_AMU BOSSTAG_LU_AMU]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_AMU BOSSTAG_DC_AMU !BOSSTAG_LU_AMU]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_AMU !BOSSTAG_DC_AMU BOSSTAG_LU_AMU]:%NAME%{%RED%Rathma %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_AMU BOSSTAG_DC_AMU BOSSTAG_LU_AMU]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_AMU !BOSSTAG_DC_AMU !BOSSTAG_LU_AMU]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_AMU BOSSTAG_DC_AMU !BOSSTAG_LU_AMU]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_AMU !BOSSTAG_DC_AMU BOSSTAG_LU_AMU]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Magic Amulets
// Rathma: 75 PLR and +3 to a skill tab or +2 class skills mandatory; uncorrupted, or corrupted to +1 all skills, all max res or cannot be frozen
// D.Clone / Lucion: +3 to a skill tab or +2 class skills and 61+ life or life per level mandatory; uncorrupted, or corrupted to +1 all skills, all max res, cannot be frozen or fire / lightning res
// No Rathma / D.Clone or Rathma / Lucion rule: Rathma's needs the PLR suffix, D.Clone's and Lucion's a life suffix
Alias[BOSSTAG_RA_MAGAMU]:(MAG amu ID STAT110>74 (TABSK0>2 OR TABSK1>2 OR TABSK2>2 OR TABSK8>2 OR TABSK9>2 OR TABSK10>2 OR TABSK16>2 OR TABSK17>2 OR TABSK18>2 OR TABSK24>2 OR TABSK25>2 OR TABSK26>2 OR TABSK32>2 OR TABSK33>2 OR TABSK34>2 OR TABSK40>2 OR TABSK41>2 OR TABSK42>2 OR TABSK48>2 OR TABSK49>2 OR TABSK50>2 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1) (STAT360=0 OR ALLSK>0 OR MAXRES>1 OR STAT153=1))
Alias[BOSSTAG_DC_MAGAMU]:(MAG amu ID (TABSK0>2 OR TABSK1>2 OR TABSK2>2 OR TABSK8>2 OR TABSK9>2 OR TABSK10>2 OR TABSK16>2 OR TABSK17>2 OR TABSK18>2 OR TABSK24>2 OR TABSK25>2 OR TABSK26>2 OR TABSK32>2 OR TABSK33>2 OR TABSK34>2 OR TABSK40>2 OR TABSK41>2 OR TABSK42>2 OR TABSK48>2 OR TABSK49>2 OR TABSK50>2 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1) (LIFE>60 OR STAT216>0) (STAT360=0 OR ALLSK>0 OR MAXRES>1 OR STAT153=1 OR STAT360=36))
Alias[BOSSTAG_LU_MAGAMU]:(MAG amu ID (TABSK0>2 OR TABSK1>2 OR TABSK2>2 OR TABSK8>2 OR TABSK9>2 OR TABSK10>2 OR TABSK16>2 OR TABSK17>2 OR TABSK18>2 OR TABSK24>2 OR TABSK25>2 OR TABSK26>2 OR TABSK32>2 OR TABSK33>2 OR TABSK34>2 OR TABSK40>2 OR TABSK41>2 OR TABSK42>2 OR TABSK48>2 OR TABSK49>2 OR TABSK50>2 OR CLSK0>1 OR CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK4>1 OR CLSK5>1 OR CLSK6>1) (LIFE>60 OR STAT216>0) (STAT360=0 OR ALLSK>0 OR MAXRES>1 OR STAT153=1 OR STAT360=38))
ItemDisplay[!BOSSTAG_RA_MAGAMU BOSSTAG_DC_MAGAMU BOSSTAG_LU_MAGAMU]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_MAGAMU !BOSSTAG_DC_MAGAMU !BOSSTAG_LU_MAGAMU]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_MAGAMU BOSSTAG_DC_MAGAMU !BOSSTAG_LU_MAGAMU]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_MAGAMU !BOSSTAG_DC_MAGAMU BOSSTAG_LU_MAGAMU]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Rings
// Rathma: Physical - 25+ PLR, 1+ offensive affixes, 4+ desirable affixes
// Rathma: Caster - 25+ PLR, 4+ desirable affixes
// No D.Clone or Lucion ring tag for now (author, 2026-10-19: Dwarf Star is too good for D.Clone)
Alias[BOSSTAG_RA_RING]:((RARE OR CRAFT) rin ID STAT110>24 (($f(COUNT(AR>59,MINDMG>8,MAXDMG>9)>=1) $f(COUNT(LIFE>19,STR>9,DEX>9,STAT3>9,ALLATTRIB>4,FCR>9,STAT96>9,AR>59,MINDMG>8,MAXDMG>9,RES>7,FRES>14,CRES>14,PRES>14,STAT118==1,STAT360==0)>=4)) OR ($f(COUNT(LIFE>19,STR>9,DEX>9,STAT3>9,ALLATTRIB>4,FCR>9,STAT96>9,RES>7,FRES>14,CRES>14,PRES>14,STAT118==1,STAT360==0)>=4))))
ItemDisplay[BOSSTAG_RA_RING]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Shields
// Rathma: Caster - 75+ PLR mandatory, 4+ desirable affixes
// Rathma: Physical - 75+ PLR and 80+ ED mandatory, 3+ desirable affixes
// D.Clone / Lucion: 4+ max fire / lightning res mandatory (Emberlord's / Tempestguard's 3-5, corruption 4-5); casters 5+
// desirable affixes, attackers 80+ ED and 4+ (no FCR); 8+ max res (prefix and corruption) and the all res corruption
// (20-25) count too
Alias[BOSSTAG_RA_SHIELD]:((RARE OR CRAFT) SHIELD ID STAT110>74 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FBR>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>1,STAT44>1,STAT46>1)>=4) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FBR>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>1,STAT44>1,STAT46>1)>=3))))
Alias[BOSSTAG_DC_SHIELD]:((RARE OR CRAFT) SHIELD ID STAT40>3 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FBR>19,SOCK>1,RES>9,FRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>7,STAT360==51)>=5) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FBR>19,SOCK>1,RES>9,FRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>7,STAT360==51)>=4))))
Alias[BOSSTAG_LU_SHIELD]:((RARE OR CRAFT) SHIELD ID STAT42>3 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FBR>19,SOCK>1,RES>9,LRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT42>7,STAT360==51)>=5) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FBR>19,SOCK>1,RES>9,LRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT42>7,STAT360==51)>=4))))
ItemDisplay[BOSSTAG_RA_SHIELD BOSSTAG_DC_SHIELD BOSSTAG_LU_SHIELD]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_SHIELD BOSSTAG_DC_SHIELD !BOSSTAG_LU_SHIELD]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_SHIELD !BOSSTAG_DC_SHIELD BOSSTAG_LU_SHIELD]:%NAME%{%RED%Rathma %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_SHIELD BOSSTAG_DC_SHIELD BOSSTAG_LU_SHIELD]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_SHIELD !BOSSTAG_DC_SHIELD !BOSSTAG_LU_SHIELD]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_SHIELD BOSSTAG_DC_SHIELD !BOSSTAG_LU_SHIELD]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_SHIELD !BOSSTAG_DC_SHIELD BOSSTAG_LU_SHIELD]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Belts
// Rathma: Uncorrupted or 2% all max resistances corruption, 5+ desirable affixes
// D.Clone / Lucion: 3+ max fire / lightning res mandatory (the 2-3 prefix, more with the all max res corruption), 4+
// desirable affixes; D.Clone counts lightning res too
Alias[BOSSTAG_RA_BELT]:((RARE OR CRAFT) BELT ID (STAT360=0 OR MAXRES>1) $f(COUNT(MAXRES>1,STAT40-MAXRES>1,STAT44-MAXRES>1,STAT46-MAXRES>1,STAT110>24,LIFE>89,LIFE>49,STR>19,FCR>9,FHR>14,FRES>14,CRES>14,PRES>14,STAT36>7,STAT360==0)>=5))
Alias[BOSSTAG_DC_BELT]:((RARE OR CRAFT) BELT ID STAT40>2 $f(COUNT(STAT360==0,MAXRES>1,LIFE>49,LIFE>89,STR>19,FCR>9,FHR>14,FRES>19,LRES>19,STAT36>7,RES>4,ALLATTRIB>3)>=4))
Alias[BOSSTAG_LU_BELT]:((RARE OR CRAFT) BELT ID STAT42>2 $f(COUNT(STAT360==0,MAXRES>1,LIFE>49,LIFE>89,STR>19,FCR>9,FHR>14,LRES>19,STAT36>7,RES>4,ALLATTRIB>3)>=4))
ItemDisplay[BOSSTAG_RA_BELT BOSSTAG_DC_BELT BOSSTAG_LU_BELT]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_BELT BOSSTAG_DC_BELT !BOSSTAG_LU_BELT]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_BELT !BOSSTAG_DC_BELT BOSSTAG_LU_BELT]:%NAME%{%RED%Rathma %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_BELT BOSSTAG_DC_BELT BOSSTAG_LU_BELT]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_BELT !BOSSTAG_DC_BELT !BOSSTAG_LU_BELT]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_BELT BOSSTAG_DC_BELT !BOSSTAG_LU_BELT]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_BELT !BOSSTAG_DC_BELT BOSSTAG_LU_BELT]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Body Armor
// Rathma: Caster - 75+ PLR mandatory, 4+ desirable affixes
// Rathma: Physical - 75+ PLR and 80+ ED mandatory, 3+ desirable affixes
// D.Clone / Lucion: Caster - 20+ PDR mandatory, 4+ desirable affixes
// D.Clone / Lucion: Physical - 20+ PDR and 80+ ED mandatory, 3+ desirable affixes
Alias[BOSSTAG_RA_CHEST]:((RARE OR CRAFT) CHEST ID STAT110>74 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FRW>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT360==53,STAT360==54,STAT360==56)>=4) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FRW>19,SOCK>1,RES>9,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT360==53,STAT360==54,STAT360==56)>=3))))
Alias[BOSSTAG_DC_CHEST]:((RARE OR CRAFT) CHEST ID STAT36>19 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FRW>19,SOCK>1,RES>9,FRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>1)>=4) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FRW>19,SOCK>1,RES>9,FRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>1)>=3))))
Alias[BOSSTAG_LU_CHEST]:((RARE OR CRAFT) CHEST ID STAT36>19 ($f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK1>0,CLSK2>0,CLSK3>0,CLSK5>0,CLSK6>0,FCR>19,FHR>16,FRW>19,SOCK>1,RES>9,LRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT42>1)>=4) OR (EDAM>79 $f(COUNT(LIFE>49,STR>14,DEX>14,STAT216>0,CLSK0>0,CLSK3>0,CLSK4>0,CLSK5>0,CLSK6>0,FHR>16,FRW>19,SOCK>1,RES>9,LRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT42>1)>=3))))
ItemDisplay[BOSSTAG_RA_CHEST BOSSTAG_DC_CHEST BOSSTAG_LU_CHEST]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_CHEST BOSSTAG_DC_CHEST !BOSSTAG_LU_CHEST]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_CHEST !BOSSTAG_DC_CHEST BOSSTAG_LU_CHEST]:%NAME%{%RED%Rathma %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_CHEST BOSSTAG_DC_CHEST BOSSTAG_LU_CHEST]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_CHEST !BOSSTAG_DC_CHEST !BOSSTAG_LU_CHEST]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_CHEST BOSSTAG_DC_CHEST !BOSSTAG_LU_CHEST]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_CHEST !BOSSTAG_DC_CHEST BOSSTAG_LU_CHEST]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Helms (not circlets)
// D.Clone / Lucion: Caster - 4+ desirable affixes (+2 to a class's skills, any class)
// D.Clone / Lucion: Physical - 60+ ED mandatory, 3+ desirable affixes (also 20+ CB, 20+ DS, 5+ life leech)
Alias[BOSSTAG_DC_HELM]:((RARE OR CRAFT) HELM ID ($f(COUNT(LIFE>39,STR>14,DEX>14,STAT216>0,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK49>1,FHR>16,SOCK>1,RES>9,FRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>1)>=4) OR (EDAM>59 $f(COUNT(LIFE>39,STR>14,DEX>14,STAT216>0,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK49>1,FHR>16,SOCK>1,RES>9,FRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT40>1,STAT136>19,STAT141>19,STAT60>4)>=3))))
Alias[BOSSTAG_LU_HELM]:((RARE OR CRAFT) HELM ID ($f(COUNT(LIFE>39,STR>14,DEX>14,STAT216>0,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK49>1,FHR>16,SOCK>1,RES>9,LRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT42>1)>=4) OR (EDAM>59 $f(COUNT(LIFE>39,STR>14,DEX>14,STAT216>0,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK41>1,TABSK42>1,TABSK49>1,FHR>16,SOCK>1,RES>9,LRES>19,STAT36>7,IF(STAT360==43,0,STAT76>4),STAT360==0,STAT360==43,STAT360==45,STAT360==50,STAT42>1,STAT136>19,STAT141>19,STAT60>4)>=3))))
ItemDisplay[BOSSTAG_DC_HELM BOSSTAG_LU_HELM]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_DC_HELM !BOSSTAG_LU_HELM]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_DC_HELM BOSSTAG_LU_HELM]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Rare Circlets
// Rathma: 50+ PLR mandatory, 5+ desirable affixes
// D.Clone / Lucion: 20+ fire / lightning res or max fire / lightning res (corruption) mandatory, 5+ desirable affixes
Alias[BOSSTAG_RA_CIRC]:(RARE CIRC ID STAT110>49 $f(COUNT(LIFE>29,STR>14,DEX>14,STAT216>0,ALLSK>0,FCR>19,FHR>16,FRW>19,SOCK>2,RES>9,STAT40>1,STAT44>1,STAT46>1,STAT153==1,STAT360==0,STAT36>7,STAT76>4,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=5))
Alias[BOSSTAG_DC_CIRC]:(RARE CIRC ID (FRES>19 OR STAT40>1) $f(COUNT(LIFE>29,STR>14,DEX>14,STAT216>0,ALLSK>0,FCR>19,FHR>16,FRW>19,SOCK>2,RES>9,FRES>19,STAT40>1,STAT153==1,STAT360==0,STAT36>7,STAT76>4,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=5))
Alias[BOSSTAG_LU_CIRC]:(RARE CIRC ID (LRES>19 OR STAT42>1) $f(COUNT(LIFE>29,STR>14,DEX>14,STAT216>0,ALLSK>0,FCR>19,FHR>16,FRW>19,SOCK>2,RES>9,LRES>19,STAT42>1,STAT153==1,STAT360==0,STAT36>7,STAT76>4,TABSK0>1,TABSK1>1,TABSK2>1,TABSK8>1,TABSK9>1,TABSK10>1,TABSK16>1,TABSK17>1,TABSK18>1,TABSK24>1,TABSK25>1,TABSK26>1,TABSK32>1,TABSK33>1,TABSK34>1,TABSK40>1,TABSK42>1,TABSK48>1,TABSK49>1,TABSK50>1,CLSK0>1,CLSK1>1,CLSK2>1,CLSK3>1,CLSK4>1,CLSK5>1,CLSK6>1)>=5))
ItemDisplay[BOSSTAG_RA_CIRC BOSSTAG_DC_CIRC BOSSTAG_LU_CIRC]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_CIRC BOSSTAG_DC_CIRC !BOSSTAG_LU_CIRC]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_CIRC !BOSSTAG_DC_CIRC BOSSTAG_LU_CIRC]:%NAME%{%RED%Rathma %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_CIRC BOSSTAG_DC_CIRC BOSSTAG_LU_CIRC]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_CIRC !BOSSTAG_DC_CIRC !BOSSTAG_LU_CIRC]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_CIRC BOSSTAG_DC_CIRC !BOSSTAG_LU_CIRC]:%NAME%{%RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_CIRC !BOSSTAG_DC_CIRC BOSSTAG_LU_CIRC]:%NAME%{%RED%Lucion%CL%%NAME%}%CONTINUE%//

// Rare/Crafted Gloves
// Rathma: 25+ PLR, 20+ IAS, +2 skill tab mandatory, 3+ desirable affixes (also 30+ ED, 10+ deadly strike, 10+ crushing blow)
// D.Clone / Lucion: Caster - 20 FCR mandatory, 4+ desirable affixes (10+ deadly strike counts: Wind and Shock Wave druids)
// D.Clone / Lucion: Physical - 5+ desirable affixes (+2 Bow and Crossbow, Barbarian Combat, Javelin and Spear or Martial
// Arts skills is one); D.Clone counts lightning res too
Alias[BOSSTAG_RA_GLOVES]:((RARE OR CRAFT) GLOVES ID STAT110>24 IAS>19 (TABSK0=2 OR TABSK2=2 OR TABSK50=2) $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,IAS>29,AR>99,EDAM>29,STAT141>9,STAT136>9,STAT116>0,RES>4,FRES>14,CRES>14,PRES>14,STAT118==1,STAT360==0)>=3))
Alias[BOSSTAG_DC_GLOVES]:((RARE OR CRAFT) GLOVES ID ((FCR>19 $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,RES>4,FRES>19,LRES>19,STAT141>9,STAT118==1,STAT360==0)>=4)) OR $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,IAS>19,AR>99,EDAM>29,STAT141>9,STAT136>9,STAT116>0,RES>4,FRES>19,LRES>19,STAT118==1,STAT360==0,TABSK0>1,TABSK32>1,TABSK2>1,TABSK50>1)>=5)))
Alias[BOSSTAG_LU_GLOVES]:((RARE OR CRAFT) GLOVES ID ((FCR>19 $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,RES>4,LRES>19,STAT141>9,STAT118==1,STAT360==0)>=4)) OR $f(COUNT(LIFE>19,STR>9,DEX>9,ALLATTRIB>4,IAS>19,AR>99,EDAM>29,STAT141>9,STAT136>9,STAT116>0,RES>4,LRES>19,STAT118==1,STAT360==0,TABSK0>1,TABSK32>1,TABSK2>1,TABSK50>1)>=5)))
ItemDisplay[BOSSTAG_RA_GLOVES BOSSTAG_DC_GLOVES BOSSTAG_LU_GLOVES]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_GLOVES BOSSTAG_DC_GLOVES !BOSSTAG_LU_GLOVES]:%NAME%{%RED%Rathma %GRAY%/ %RED%D.Clone%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_GLOVES !BOSSTAG_DC_GLOVES BOSSTAG_LU_GLOVES]:%NAME%{%RED%Rathma %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[!BOSSTAG_RA_GLOVES BOSSTAG_DC_GLOVES BOSSTAG_LU_GLOVES]:%NAME%{%RED%D.Clone %GRAY%/ %RED%Lucion%CL%%NAME%}%CONTINUE%//
ItemDisplay[BOSSTAG_RA_GLOVES !BOSSTAG_DC_GLOVES !BOSSTAG_LU_GLOVES]:%NAME%{%RED%Rathma%CL%%NAME%}%CONTINUE%//
