// ------------------------------------------------------------------------------
//    ===================  +Skills Items and Shop Highlights  ===============
// ------------------------------------------------------------------------------

// Physical Ring
ItemDisplay[(RARE OR CRAFT) rin ID (MINDMG+MAXDMG>19 $f(COUNT(LIFE>19,STR>9,DEX>7,STAT3>7,ALLATTRIB>3,STAT96>9,AR>59,MINDMG>0,MAXDMG>0,STAT60>3,STAT62>2,RES>5,FRES>14,CRES>14,PRES>14,LRES>14,MFIND>14,STAT36>0,STAT118==1,STAT360==0)>=5))]:%NAME%{%HIGHLIGHT_1_LEFT%   %GREEN%Physical   %HIGHLIGHT_1_RIGHT%%CL%%NAME%}%CONTINUE%//

// +3 Class/Tab Skills with +20 FCR and FRW
ItemDisplay[(MAG OR RARE) FCR=20 CIRC ALLSK=1 FRW>0 (CLSK0=2 OR CLSK1=2 OR CLSK2=2 OR CLSK3=2 OR CLSK4=2 OR CLSK5=2 OR CLSK6=2 OR TABSK1=2 OR TABSK8=2 OR TABSK9=2 OR TABSK10=2 OR TABSK16=2 OR TABSK17=2 OR TABSK18=2 OR TABSK24=2 OR TABSK34=2 OR TABSK42=2 OR TABSK48=2 OR TABSK49=2)]:%NAME%{%HIGHLIGHT_1_LEFT%   %GREEN%+3 Skills %FRW%/%FCR%   %HIGHLIGHT_1_RIGHT%%CL%%NAME%}%CONTINUE%//
// +2 Class/Tab Skills with +20 FCR and FRW
