// ------------------------------------------------------------------------------
//    ===========================  Resistances Tags  =========================
// ------------------------------------------------------------------------------

// One resistance tag per item, the first of these that holds: All Resistances, a Triple Resist, a Dual Resist,
// else a line per resistance (levels 0-4 below character level 80). Since 2026-10-29 the tags sit right under
// the skill and shop highlights (the author's order), so these rules continue and each skips the ones before it:
// an alias holds one rule's resistances, for its own rule and the !(...) of the rules after it.

// Levels 0-4 below character level 80
Alias[RESTAG_ALL]:((RES>5 STAT360=51) OR (rin RES>7) OR RES>14)
Alias[RESTAG_TRI_PFC]:(((PRES>14 FRES>14 CRES>14) CLVL<50) OR (PRES>14 FRES>14 CRES>14 PRES+FRES+CRES>29))
Alias[RESTAG_TRI_PFL]:(((PRES>14 FRES>14 LRES>14) CLVL<50) OR (PRES>14 FRES>14 LRES>14 PRES+FRES+LRES>29))
Alias[RESTAG_TRI_PLC]:(((PRES>14 LRES>14 CRES>14) CLVL<50) OR (PRES>14 LRES>14 CRES>14 PRES+LRES+CRES>29))
Alias[RESTAG_TRI_LFC]:(((LRES>14 FRES>14 CRES>14) CLVL<50) OR (LRES>14 FRES>14 CRES>14 LRES+FRES+CRES>29))
Alias[RESTAG_DUO_PF]:(((PRES>14 FRES>14) CLVL<50) OR (PRES>14 FRES>14 PRES+FRES>19))
Alias[RESTAG_DUO_PL]:(((PRES>14 LRES>14) CLVL<50) OR (PRES>14 LRES>14 PRES+LRES>19))
Alias[RESTAG_DUO_PC]:(((PRES>14 CRES>14) CLVL<50) OR (PRES>14 CRES>14 PRES+CRES>19))
Alias[RESTAG_DUO_CL]:(((CRES>14 LRES>14) CLVL<50) OR (CRES>14 LRES>14 CRES+LRES>19))
Alias[RESTAG_DUO_CF]:(((CRES>14 FRES>14) CLVL<50) OR (CRES>14 FRES>14 CRES+FRES>19))
Alias[RESTAG_DUO_LF]:(((LRES>14 FRES>14) CLVL<50) OR (LRES>14 FRES>14 LRES+FRES>19))
// Boots, belts, gloves on levels 5-7 (and 0-4 from character level 80): boots 80+ in all, belts and gloves 60+
Alias[RESTAG5_TRI_PFC]:(PRES>14 FRES>14 CRES>14 ((BOOTS PRES+FRES+CRES>79) OR ((BELT OR GLOVES) PRES+FRES+CRES>59)))
Alias[RESTAG5_TRI_PFL]:(PRES>14 FRES>14 LRES>14 ((BOOTS PRES+FRES+LRES>79) OR ((BELT OR GLOVES) PRES+FRES+LRES>59)))
Alias[RESTAG5_TRI_PLC]:(PRES>14 LRES>14 CRES>14 ((BOOTS PRES+LRES+CRES>79) OR ((BELT OR GLOVES) PRES+LRES+CRES>59)))
Alias[RESTAG5_TRI_LFC]:(LRES>14 FRES>14 CRES>14 ((BOOTS LRES+FRES+CRES>79) OR ((BELT OR GLOVES) LRES+FRES+CRES>59)))
Alias[RESTAG5_DUO_PF]:(PRES>14 FRES>14 ((BOOTS PRES+FRES>59) OR ((BELT OR GLOVES) PRES+FRES>39)))
Alias[RESTAG5_DUO_PL]:(PRES>14 LRES>14 ((BOOTS PRES+LRES>59) OR ((BELT OR GLOVES) PRES+LRES>39)))
Alias[RESTAG5_DUO_PC]:(PRES>14 CRES>14 ((BOOTS PRES+CRES>59) OR ((BELT OR GLOVES) PRES+CRES>39)))
Alias[RESTAG5_DUO_CL]:(CRES>14 LRES>14 ((BOOTS CRES+LRES>59) OR ((BELT OR GLOVES) CRES+LRES>39)))
Alias[RESTAG5_DUO_CF]:(CRES>14 FRES>14 ((BOOTS CRES+FRES>59) OR ((BELT OR GLOVES) CRES+FRES>39)))
Alias[RESTAG5_DUO_LF]:(LRES>14 FRES>14 ((BOOTS LRES+FRES>59) OR ((BELT OR GLOVES) LRES+FRES>39)))
// Levels 8-12: boots 90+, belts and gloves 65+
Alias[RESTAG8_TRI_PFC]:(PRES>14 FRES>14 CRES>14 ((BOOTS PRES+FRES+CRES>89) OR ((BELT OR GLOVES) PRES+FRES+CRES>64)))
Alias[RESTAG8_TRI_PFL]:(PRES>14 FRES>14 LRES>14 ((BOOTS PRES+FRES+LRES>89) OR ((BELT OR GLOVES) PRES+FRES+LRES>64)))
Alias[RESTAG8_TRI_PLC]:(PRES>14 LRES>14 CRES>14 ((BOOTS PRES+LRES+CRES>89) OR ((BELT OR GLOVES) PRES+LRES+CRES>64)))
Alias[RESTAG8_TRI_LFC]:(LRES>14 FRES>14 CRES>14 ((BOOTS LRES+FRES+CRES>89) OR ((BELT OR GLOVES) LRES+FRES+CRES>64)))
Alias[RESTAG8_DUO_PF]:(PRES>14 FRES>14 ((BOOTS PRES+FRES>64) OR ((BELT OR GLOVES) PRES+FRES>44)))
Alias[RESTAG8_DUO_PL]:(PRES>14 LRES>14 ((BOOTS PRES+LRES>64) OR ((BELT OR GLOVES) PRES+LRES>44)))
Alias[RESTAG8_DUO_PC]:(PRES>14 CRES>14 ((BOOTS PRES+CRES>64) OR ((BELT OR GLOVES) PRES+CRES>44)))
Alias[RESTAG8_DUO_CL]:(CRES>14 LRES>14 ((BOOTS CRES+LRES>64) OR ((BELT OR GLOVES) CRES+LRES>44)))
Alias[RESTAG8_DUO_CF]:(CRES>14 FRES>14 ((BOOTS CRES+FRES>64) OR ((BELT OR GLOVES) CRES+FRES>44)))
Alias[RESTAG8_DUO_LF]:(LRES>14 FRES>14 ((BOOTS LRES+FRES>64) OR ((BELT OR GLOVES) LRES+FRES>44)))

// All Resistances
ItemDisplay[!(CLVL>79 OR FILTLVL>4) !((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR ((SHIELD !DIN) OR (DIN RES>19)) OR CHEST OR HELM OR CIRC OR rin OR amu) RESTAG_ALL]:%NAME%{%LIGHT_GRAY%**%GRAY%**%PURPLE%**   %PURPLE%All Resistances   %PURPLE%**%GRAY%**%LIGHT_GRAY%**%CL%%NAME%}%CONTINUE%//
// Tri Resistance
ItemDisplay[!(CLVL>79 OR FILTLVL>4) !((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR (SHIELD !DIN) OR CHEST OR HELM OR CIRC OR rin OR amu) RESTAG_TRI_PFC !RESTAG_ALL]:%NAME%{%RED%**%DARK_GREEN%**%BLUE%**   %PURPLE%Triple Resist   %BLUE%**%DARK_GREEN%**%RED%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[!(CLVL>79 OR FILTLVL>4) !((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR (SHIELD !DIN) OR CHEST OR HELM OR CIRC OR rin OR amu) RESTAG_TRI_PFL !(RESTAG_ALL OR RESTAG_TRI_PFC)]:%NAME%{%RED%**%YELLOW%**%DARK_GREEN%**   %PURPLE%Triple Resist   %DARK_GREEN%**%YELLOW%**%RED%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[!(CLVL>79 OR FILTLVL>4) !((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR (SHIELD !DIN) OR CHEST OR HELM OR CIRC OR rin OR amu) RESTAG_TRI_PLC !(RESTAG_ALL OR RESTAG_TRI_PFC OR RESTAG_TRI_PFL)]:%NAME%{%BLUE%**%DARK_GREEN%**%YELLOW%**   %PURPLE%Triple Resist   %YELLOW%**%DARK_GREEN%**%BLUE%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[!(CLVL>79 OR FILTLVL>4) !((SHIELD OR HELM OR CHEST) SHOP CLVL>69) ((!RW NMAG GEMMED) OR MAG OR RARE OR CRAFT) ID (WAND OR SCEPTER OR STAFF OR BELT OR GLOVES OR BOOTS OR (SHIELD !DIN) OR CHEST OR HELM OR CIRC OR rin OR amu) RESTAG_TRI_LFC !(RESTAG_ALL OR RESTAG_TRI_PFC OR RESTAG_TRI_PFL OR RESTAG_TRI_PLC)]:%NAME%{%RED%**%YELLOW%**%BLUE%**   %PURPLE%Triple Resist   %BLUE%**%YELLOW%**%RED%**%CL%%NAME%}%CONTINUE%//
// Boots, belts, gloves on levels 5-7 (and 0-4 from character level 80): boots 80+ in all, belts and gloves 60+
ItemDisplay[(FILTLVL~5-7 OR (FILTLVL<5 CLVL>79)) (MAG OR RARE OR CRAFT) ID RESTAG5_TRI_PFC]:%NAME%{%RED%**%DARK_GREEN%**%BLUE%**   %PURPLE%Triple Resist   %BLUE%**%DARK_GREEN%**%RED%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[(FILTLVL~5-7 OR (FILTLVL<5 CLVL>79)) (MAG OR RARE OR CRAFT) ID RESTAG5_TRI_PFL !RESTAG5_TRI_PFC]:%NAME%{%RED%**%YELLOW%**%DARK_GREEN%**   %PURPLE%Triple Resist   %DARK_GREEN%**%YELLOW%**%RED%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[(FILTLVL~5-7 OR (FILTLVL<5 CLVL>79)) (MAG OR RARE OR CRAFT) ID RESTAG5_TRI_PLC !(RESTAG5_TRI_PFC OR RESTAG5_TRI_PFL)]:%NAME%{%BLUE%**%DARK_GREEN%**%YELLOW%**   %PURPLE%Triple Resist   %YELLOW%**%DARK_GREEN%**%BLUE%**%CL%%NAME%}%CONTINUE%//
ItemDisplay[(FILTLVL~5-7 OR (FILTLVL<5 CLVL>79)) (MAG OR RARE OR CRAFT) ID RESTAG5_TRI_LFC !(RESTAG5_TRI_PFC OR RESTAG5_TRI_PFL OR RESTAG5_TRI_PLC)]:%NAME%{%RED%**%YELLOW%**%BLUE%**   %PURPLE%Triple Resist   %BLUE%**%YELLOW%**%RED%**%CL%%NAME%}%CONTINUE%//
