// ------------------------------------------------------------------------------
//    ===========================  Jewels Display ===========================
// ------------------------------------------------------------------------------

// Jewel Visual Tags
ItemDisplay[MAG ID jew (STAT74>0 OR IAS>0 OR RES>0 OR FRES>0 OR LRES>0 OR CRES>0 OR PRES>0 OR DEF>0 OR STAT78>0 OR STAT121>0 OR STAT122>0 OR AR>0 OR LIFE>0 OR MFIND>0 OR MANA>0 OR STAT1>0 OR DTM>0 OR GFIND>0 OR STR>0 OR DEX>0 OR STAT501>0 OR STAT91<0 OR STAT86>0 OR STAT138>0 OR MAXDMG>0 OR MINDMG>0 OR ED>0 OR FHR>0)]:%CL%%BLUE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[RARE ID jew]:%CL%%YELLOW%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI ID jew]:%CL%%GOLD%%NAME%{%NAME%}%CONTINUE%

// Magic Low Level Dueling Jewels (LLD) - 2+ desirable affixes
ItemDisplay[MAG jew ID LVLREQ<31 $f(COUNT(CRES>24,FRES>24,LRES>24,PRES>24,RES>9,ED>14,MAXDMG+MINDMG>14,MAXDMG>11,MINDMG>9,STR>5,DEX>6,STAT91==-15,STAT135>0,AR>49,STAT51>49,AND(STAT48>7,STAT49>27))>=2)]:%TEAL%LLD%CS%%NAME%{%TEAL%Low Level Dueling%CL%%NAME%}%CONTINUE%//
// Rare Low Level Dueling Jewels (LLD) - 3+ desirable affixes
ItemDisplay[RARE jew ID LVLREQ<31 $f(COUNT(CRES>19,FRES>19,LRES>19,PRES>19,RES>5,ED>11,MAXDMG+MINDMG>13,MAXDMG>7,MINDMG>6,STR>4,DEX>5,STAT91==-15,STAT135>0,AR>39,STAT51>39,AND(STAT48>5,STAT49>23))>=3)]:%TEAL%LLD%CS%%NAME%{%TEAL%Low Level Dueling%CL%%NAME%}%CONTINUE%//

// -15% Requirements
ItemDisplay[(MAG OR RARE) STAT91<0 ID jew]:%WHITE%%STAT91%%LIGHT_GRAY%%PERCENT%req%CS%%NAME%{%NAME%}%CONTINUE%
// Magic Find
ItemDisplay[(MAG OR RARE) MFIND>0 ID jew]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
// Gold Find
ItemDisplay[(MAG OR RARE) GFIND>0 ID jew]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%
// Attacker Takes Damage
ItemDisplay[(MAG OR RARE) STAT78>0 ID jew]:%WHITE%%STAT78%%GRAY%atd%CS%%NAME%{%NAME%}%CONTINUE%
// Life after Kill
ItemDisplay[(MAG OR RARE) STAT86~1-2 ID jew]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) STAT86=3 ID jew]:%WHITE%%STAT86%%PURPLE%lpk%CS%%NAME%{%NAME%}%CONTINUE%
// Mana after Kill
ItemDisplay[(MAG OR RARE) STAT138~1-2 ID jew]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) STAT138=3 ID jew]:%WHITE%%STAT138%%PURPLE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
// Damage to Mana
ItemDisplay[(MAG OR RARE) DTM>0 ID jew]:%WHITE%%DTM%%BLUE%dtm%CS%%NAME%{%NAME%}%CONTINUE%
// All Res
ItemDisplay[(MAG OR RARE) RES>0 ID jew]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
// Fire Res
ItemDisplay[(MAG OR RARE) !RES>0 FRES>0 ID jew]:%WHITE%%FRES%%RED%res%CS%%NAME%{%NAME%}%CONTINUE%
// Light Res
ItemDisplay[(MAG OR RARE) !RES>0 LRES>0 ID jew]:%WHITE%%LRES%%YELLOW%res%CS%%NAME%{%NAME%}%CONTINUE%
// Cold Res
ItemDisplay[(MAG OR RARE) !RES>0 CRES>0 ID jew]:%WHITE%%CRES%%BLUE%res%CS%%NAME%{%NAME%}%CONTINUE%
// Poison Res
ItemDisplay[(MAG OR RARE) !RES>0 PRES>0 ID jew]:%WHITE%%PRES%%DARK_GREEN%res%CS%%NAME%{%NAME%}%CONTINUE%
// Replenish Life
ItemDisplay[(MAG OR RARE) STAT74>0 ID jew]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%
// Mana
ItemDisplay[(MAG OR RARE) MANA>0 ID jew]:%WHITE%%MANA%%BLUE%mana%CS%%NAME%{%NAME%}%CONTINUE%
// Energy
ItemDisplay[(MAG OR RARE) STAT1>0 ID jew]:%WHITE%%STAT1%%BLUE%nrg%CS%%NAME%{%NAME%}%CONTINUE%
// Life
ItemDisplay[(MAG OR RARE) LIFE>0 ID jew]:%WHITE%%LIFE%%RED%life%CS%%NAME%{%NAME%}%CONTINUE%
// Dexterity
ItemDisplay[(MAG OR RARE) DEX>0 ID jew]:%WHITE%%DEX%%GRAY%dex%CS%%NAME%{%NAME%}%CONTINUE%
// Strength
ItemDisplay[(MAG OR RARE) STR>0 ID jew]:%WHITE%%STR%%GRAY%str%CS%%NAME%{%NAME%}%CONTINUE%
// Defense
ItemDisplay[(MAG OR RARE) DEF>0 ID jew]:%WHITE%%DEF%%GRAY%def%CS%%NAME%{%NAME%}%CONTINUE%
// Open Wounds
ItemDisplay[(MAG OR RARE) STAT501>0 ID jew]:%WHITE%%STAT501%%CORAL%ow%CS%%NAME%{%NAME%}%CONTINUE%
// % Damage to Demons
ItemDisplay[(MAG OR RARE) STAT121>0 STAT121<30 ID jew]:%WHITE%%STAT121%%TAN%dem%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) STAT121>29 ID jew]:%WHITE%%STAT121%%RED%dem%CS%%NAME%{%NAME%}%CONTINUE%
// % Damage to Undead
ItemDisplay[(MAG OR RARE) STAT122>0 STAT122<40 ID jew]:%WHITE%%STAT122%%TAN%und%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) STAT122>39 ID jew]:%WHITE%%STAT122%%RED%und%CS%%NAME%{%NAME%}%CONTINUE%
// AR
ItemDisplay[(MAG OR RARE) AR>0 ID jew]:%WHITE%%AR%%DARK_GREEN%ar%CS%%NAME%{%NAME%}%CONTINUE%
// Max Damage
ItemDisplay[(MAG OR RARE) MAXDMG>0 MAXDMG<14 ID jew]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) MAXDMG>13 ID jew]:%WHITE%%MAXDMG%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
// Min Damage
ItemDisplay[(MAG OR RARE) MINDMG>0 MINDMG<13 ID jew]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) MINDMG>12 ID jew]:%WHITE%%MINDMG%%PURPLE%min%CS%%NAME%{%NAME%}%CONTINUE%
// Enhanced Damage
ItemDisplay[(MAG OR RARE) ED>0 ED<30 ID jew]:%WHITE%%ED%%TAN%ed%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ED>29 ED<38 ID jew]:%WHITE%%ED%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE) ED>37 ID jew]:%WHITE%%ED%%PURPLE%ed%CS%%NAME%{%NAME%}%CONTINUE%
// 15 Increased Attack Speed
ItemDisplay[(MAG OR RARE) IAS>0 ID jew]:%WHITE%%IAS%%ORANGE%ias%CS%%NAME%{%NAME%}%CONTINUE%
// Faster Hit Recovery
ItemDisplay[(MAG OR RARE) FHR>0 ID jew]:%WHITE%%FHR%%TAN%fhr%CS%%NAME%{%NAME%}%CONTINUE%

// Fire Facet
ItemDisplay[UNI STAT329~3-5 STAT333~3-5 !(STAT329=5 STAT333=5) ID jew]:%RED%-%STAT333%% +%STAT329%%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI (STAT329=5 STAT333=5) ID jew]:%RED%\%GOLD%\%RED%\  -%STAT333%% +%STAT329%%  /%GOLD%/%RED%/%NAME%{%NAME%}%CONTINUE%
// Light Facet
ItemDisplay[UNI STAT330~3-5 STAT334~3-5 !(STAT330=5 STAT334=5) ID jew]:%YELLOW%-%STAT334%% +%STAT330%%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI (STAT330=5 STAT334=5) ID jew]:%YELLOW%\%GOLD%\%YELLOW%\  -%STAT334%% +%STAT330%%  /%GOLD%/%YELLOW%/%NAME%{%NAME%}%CONTINUE%
// Cold Facet
ItemDisplay[UNI STAT331~3-5 STAT335~3-5 !(STAT331=5 STAT335=5) ID jew]:%BLUE%-%STAT335%% +%STAT331%%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI (STAT331=5 STAT335=5) ID jew]:%BLUE%\%GOLD%\%BLUE%\  +%STAT331%% -%STAT335%%  /%GOLD%/%BLUE%/%NAME%{%NAME%}%CONTINUE%
// Poison Facet
ItemDisplay[UNI STAT332~3-5 STAT336~3-5 !(STAT332=5 STAT336=5) ID jew]:%DARK_GREEN%-%STAT336%% +%STAT332%%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI (STAT332=5 STAT336=5) ID jew]:%DARK_GREEN%\%GOLD%\%DARK_GREEN%\  +%STAT332%% -%STAT336%%  /%GOLD%/%DARK_GREEN%/%NAME%{%NAME%}%CONTINUE%

// Jewel Fragment Item Description
ItemDisplay[MAG ID jew]:%NAME%{%WHITE%to create %TAN%(x %BLUE%Jewel %TAN%x) %WHITE%Fragments%CL%%TAN%Cube %WHITE%any %BLUE%Jewel %WHITE%with %GRAY%Keys%WHITE%%CL%%NAME%}%CONTINUE%//

// Rerolling Rare Jewels for Rerolled Affix Level 66+ 
ItemDisplay[RARE jew ID STAT486=0 REROLLALVL>65]:%NAME%{%WHITE%Rerolled Affix Level: %BLUE%%REROLLALVL%%CL%%YELLOW%Jewel %TAN%+ %WHITE%3 %TAN%x %LIGHT_GRAY%Perfect %WHITE%Skulls %GRAY%o%CL%%WHITE%Cube Reroll Recipe:%CL%%NAME%}%CONTINUE%//
ItemDisplay[RARE jew ID STAT486=0 REROLLALVL<66]:%NAME%{%WHITE%Rerolled Affix Level: %RED%%REROLLALVL%%CL%%NAME%}%CONTINUE%//

// End of Continue Statements
ItemDisplay[(MAG OR RARE) ID jew]:%NAME%{%NAME%}//

