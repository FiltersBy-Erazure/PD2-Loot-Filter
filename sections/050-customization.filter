// =========================  Loot Filter Customization  =============================

// The section below contains lines of code that are "commented out".
// When a line of code has "//" in front of it, the filter will ignore that line as it doesn't read anything after "//".
// To enable a line, simply remove the "//" in front of the line (the left-most // before ItemDisplay).
// The filter reads from top to bottom. Enabling these lines will override any lines that would otherwise hide these items.

// After making your edits, be sure to save the filter file to Diablo II\ProjectD2\filters\local
// On the launcher, click Item Filter Profiles, Local Filter, select the filter name, then click Save Filter

// =================================================================================

//  ===============  Potions  ===============
//   Show Standard Health and Mana Potions
//ItemDisplay[hp5]:%WHITE% H%RED%+ %WHITE%{%WHITE% Super Healing Potion }//
//ItemDisplay[mp5]:%WHITE% M%BLUE%+ %WHITE%{%WHITE% Super Mana Potion }//

//   Show Compact Health and Mana Potions
//ItemDisplay[mp5]:%WHITE%M%BLUE%+%WHITE%{%WHITE% Super Mana Potion }//
//ItemDisplay[hp5]:%WHITE%H%RED%+%WHITE%{%WHITE% Super Healing Potion }//

//   Hide Health and Mana Potions
//ItemDisplay[mp5]:{%WHITE% Super Mana Potion }//
//ItemDisplay[hp5]:{%WHITE% Super Healing Potion }//

//   Show Antidote Potions
//ItemDisplay[yps]:%GRAY%i%DARK_GREEN%(%WHITE%A%DARK_GREEN%)%GRAY%i%WHITE%{%WHITE%+25% poison resistance for 30 seconds%CL%%WHITE%Cures %DARK_GREEN%poison %WHITE%affliction and grants%CL%Antidote Potion}//

//   Hide Antidote Potions
//ItemDisplay[yps]:{%WHITE%+25% poison resistance for 30 seconds%CL%%WHITE%Cures %DARK_GREEN%poison %WHITE%affliction and grants%CL%Antidote Potion}//

//   Show Full Rejuvenation Potions
//ItemDisplay[rvl]:%PURPLE%i(%WHITE% Full %PURPLE%)i%WHITE%{%WHITE% Full Rejuvenation Potion }//

//   Show Small Rejuvenation Potions
//ItemDisplay[rvs]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i%WHITE%{%WHITE% Rejuvenation Potion }//

//   Hide Small Rejuvenation Potions
//ItemDisplay[rvs]:{%WHITE% Rejuvenation Potion }//

//  ==========  Arrows and Bolts  ==========
//   Hide magic quivers
//ItemDisplay[MAG !ID QUIVER]://

//   Hide rare quivers
//ItemDisplay[RARE !ID QUIVER]://

//   Show Magic Arrows
//ItemDisplay[MAG !ID (aqv2 OR aqv3)]:%BLUE%Arrows//

//   Show Rare Arrows
//ItemDisplay[RARE !ID (aqv OR aqv2 OR aqv3)]:%YELLOW%Arrows//

//   Show Magic Bolts
//ItemDisplay[MAG !ID (cqv2 OR cqv3)]:%BLUE%Bolts//

//   Show Rare Bolts
//ItemDisplay[RARE !ID (cqv OR cqv2 OR cqv3)]:%YELLOW%Bolts//

//  ==========  Druid Pelts  ==========
//   Hide Magic Non-Ethereal Druid Pelts
//ItemDisplay[MAG !ID !ETH DRU]://

//   Hide Rare Non-Ethereal Druid Pelts
//ItemDisplay[RARE !ID !ETH DRU]://

//   Show Magic Non-Ethereal Druid Pelts
//ItemDisplay[MAG !ID !ETH DRU]:%BLUE%%NAME%//

//   Show Magic Ethereal Druid Pelts
//ItemDisplay[MAG !ID ETH DRU]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Non-Ethereal Druid Pelts
//ItemDisplay[RARE !ID !ETH DRU]:%YELLOW%%NAME%//

//   Show Rare Ethereal Druid Pelts
//ItemDisplay[RARE !ID ETH DRU]:%WHITE%Eth %YELLOW%%NAME%//

//  ==========  Druid Clubs  ==========
//   Hide Magic Non-Ethereal Druid Clubs
//ItemDisplay[MAG !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]://

//   Hide Rare Non-Ethereal Druid Clubs
//ItemDisplay[RARE !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]://

//   Show Magic Non-Ethereal Druid Clubs
//ItemDisplay[MAG !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%BLUE%%NAME%//

//   Show Magic Ethereal Druid Clubs
//ItemDisplay[MAG !ID ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Non-Ethereal Druid Clubs
//ItemDisplay[RARE !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%YELLOW%%NAME%//

//   Show Rare Ethereal Druid Clubs
//ItemDisplay[RARE !ID ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%WHITE%Eth %YELLOW%%NAME%//

//  ==========  Necromancer Heads  ==========
//   Hide Magic Non-Ethereal Necromancer Heads
//ItemDisplay[MAG !ID !ETH NEC]://

//   Hide Rare Non-Ethereal Necromancer Heads
//ItemDisplay[RARE !ID !ETH NEC]://

