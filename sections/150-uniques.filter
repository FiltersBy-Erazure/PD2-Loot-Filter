ItemDisplay[ETH UNI]:%WHITE%Eth %NAME%{%NAME%}%CONTINUE%//

// --------------------------------------------------------------------------------------------------------
// ================================  Diablo Clone and Rathma Unique Items  ================================
// --------------------------------------------------------------------------------------------------------

// Rathma Items
// rar = Cage of the Unsullied Boneweave
// ram = The Third Eye Amuletm
// rbe = Band of Skulls Troll Belt

// Diablo Clone Items
// uh9 = Overlord's Helm Bone Visage
// utb = Itherael's Path Mirrored Boots
// 7bs = Hadriel's Hand Conquest Sword
// 7qr = Aidan's Scar Scissors Suwayyah
// uth = Dark Abyss Lacquered Plate

// Drop sound notifications
ItemDisplay[!POE_SOUNDS UNI !ID (rar OR ram OR rbe OR (uh9 MAPID=137) OR utb OR 7bs OR 7qr OR uth)]:%NAME%%SOUNDID-4651%%CONTINUE%//
ItemDisplay[POE_SOUNDS UNI !ID (rar OR ram OR rbe OR (uh9 MAPID=137) OR utb OR 7bs OR 7qr OR uth)]:%NAME%%SOUNDID-4719%%CONTINUE%//

// BIG GG display
ItemDisplay[BIG_GG UNI !ID (rar OR ram OR rbe OR (uh9 MAPID=137) OR utb OR 7bs OR 7qr OR uth) GROUND !(INVENTORY OR TOWN)]:%SUR_BER_JAH_CHAM_ZOD_BIG_GG%  %WHITE%BIG GG  %SUR_BER_JAH_CHAM_ZOD_BIG_GG%%GOLD%%BORDER-9B%%MAP-62%%DOT-68%%PX-20%// 
ItemDisplay[BIG_GG UNI !ID (rar OR ram OR rbe OR (uh9 MAPID=137) OR utb OR 7bs OR 7qr OR uth) (INVENTORY OR TOWN)]:%UNI_DCLONE_RATHMA%  %NAME%  %UNI_DCLONE_RATHMA%%GOLD%%BORDER-91%%MAP-97%%DOT-84%%PX-20%//

// Standard display for default-name items
ItemDisplay[!BIG_GG UNI !ID (rar OR ram OR rbe OR (uh9 MAPID=137) OR utb OR 7bs OR 7qr OR uth)]:%UNI_DCLONE_RATHMA%  %NAME%  %UNI_DCLONE_RATHMA%%GOLD%%BORDER-91%%MAP-97%%DOT-84%%PX-20%// 


