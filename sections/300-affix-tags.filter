// Minimum and Maximum Damage on Rings
ItemDisplay[(rin OR HELM OR ((CIRC OR SHIELD OR amu) LOWLVL_MAXDMG_TAG) OR (WEAPON !STAFF !WAND !SOR !STAT218>0)) (RARE OR CRAFT) !GEMMED ((MAXDMG>0 CLVL<80) OR MAXDMG>6 OR ((WEAPON OR LOWLVL_MAXDMG_TAG) MAXDMG>0)) MAXDMG<14 !(((rin OR HELM) ((MINDMG>0 CLVL<80) OR MINDMG>6)) OR ((CIRC OR SHIELD OR amu) LOWLVL_MINDMG_TAG MINDMG>0) OR (WEAPON MINDMG>0))]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR HELM OR ((CIRC OR SHIELD OR amu) LOWLVL_MAXDMG_TAG) OR (WEAPON !STAFF !WAND !SOR !STAT218>0)) (RARE OR CRAFT) !GEMMED MAXDMG>13 !(((rin OR HELM) ((MINDMG>0 CLVL<80) OR MINDMG>6)) OR ((CIRC OR SHIELD OR amu) LOWLVL_MINDMG_TAG MINDMG>0) OR (WEAPON MINDMG>0))]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM) MAG MAXDMG>0]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(UNI OR SET) QUIVER (STAT360=75 OR ROLL_MAXDMG_TAG)]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(GLOVES OR BELT OR HELM OR rin) ROLL_MAXDMG_TAG MAXDMG>0]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%

// With maximum damage per level besides: one tag, the total at your level
ItemDisplay[WEAPON !STAFF !WAND !SOR (RARE OR CRAFT) !GEMMED STAT218>0 !MINDMG>0]:%WHITE%$f(STAT22+FLOOR(STAT218*CLVL/8))%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Minimum Damage (stat 21, priority 127) ----

ItemDisplay[WEAPON ROLL_MINDMG_TAG MINDMG>0]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR HELM) (RARE OR CRAFT OR ROLL_MINDMG_TAG) !GEMMED ((MINDMG>0 CLVL<80) OR MINDMG>6) MINDMG<13 !((RARE OR CRAFT) ((MAXDMG>0 CLVL<80) OR MAXDMG>6 OR (LOWLVL_MAXDMG_TAG MAXDMG>0)))]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR HELM) (RARE OR CRAFT OR ROLL_MINDMG_TAG) !GEMMED MINDMG>12 !((RARE OR CRAFT) ((MAXDMG>0 CLVL<80) OR MAXDMG>6 OR (LOWLVL_MAXDMG_TAG MAXDMG>0)))]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(((CIRC OR SHIELD OR amu) LOWLVL_MINDMG_TAG) OR ((WEAPON !STAFF !WAND !SOR) (RARE OR CRAFT))) !GEMMED MINDMG>0 !(((CIRC OR SHIELD OR amu) LOWLVL_MAXDMG_TAG MAXDMG>0) OR (WEAPON (MAXDMG>0 OR STAT218>0)))]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%

// Minimum and maximum damage as one tag whenever both show, 1-3dmg (the game's "Adds 1-3 damage") and 5-3dmg too
// (the author: compact and consistent; the game itself shows +5 min / +3 max apart): every rare and crafted item;
// with maximum damage per level, the total at your level. Weapons (not staves, wands, orbs) tag minimum and maximum
// damage at every affix level and roll (the author, 2026-10-28), not through sections/290's low-level aliases
ItemDisplay[(RARE OR CRAFT) !GEMMED !STAT218>0 (((rin OR HELM) ((MINDMG>0 CLVL<80) OR MINDMG>6) ((MAXDMG>0 CLVL<80) OR MAXDMG>6 OR (LOWLVL_MAXDMG_TAG MAXDMG>0))) OR ((CIRC OR SHIELD OR amu) LOWLVL_MINDMG_TAG LOWLVL_MAXDMG_TAG MINDMG>0 MAXDMG>0) OR ((WEAPON !STAFF !WAND !SOR) MINDMG>0 MAXDMG>0))]:%WHITE%%MINDMG%-%MAXDMG%%TAN%dmg%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON !STAFF !WAND !SOR (RARE OR CRAFT) !GEMMED MINDMG>0 STAT218>0]:%WHITE%%MINDMG%-$f(STAT22+FLOOR(STAT218*CLVL/8))%TAN%dmg%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM) MAG MINDMG>0]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(UNI OR SET) QUIVER (STAT360=74 OR ROLL_MINDMG_TAG)]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%

