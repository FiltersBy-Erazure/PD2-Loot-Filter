// ------------------------------------------------------------------------------
//     =========================  Affixes Tags Display ======================
// ------------------------------------------------------------------------------

// Put Affixes on Lower Line - Magic Rare and Crafted Items
ItemDisplay[ID (MAG OR RARE OR CRAFT)]:%CL%%NAME%{%NAME%}%CONTINUE%

// Put Affixes on Lower Line - Unique and Set Items
ItemDisplay[ID (UNI OR SET)]:%CL%%NAME%{%NAME%}%CONTINUE%

// ---- -% Requirements (stat 91, priority 0) ----

// -% Requirements
ItemDisplay[WEAPON (UNI OR SET) STAT360=6 STAT91<0]:%WHITE%%STAT91%%LIGHT_GRAY%%PERCENT%rq%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Repair Durability (stat 252, priority 1) ----

// Repair Durability
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT) REPAIR>0]:%GRAY%Rep%CS%%NAME%{%NAME%}%CONTINUE%

// Repair Durability on Armor
ItemDisplay[(CIRC OR HELM OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES) (MAG OR RARE OR CRAFT) REPAIR>0]:%GRAY%Rep%CS%%NAME%{%NAME%}%CONTINUE%

// S14: corruption 48 (was Indestructible) gives repair durability + 50-80% ED; the ED is tagged in the Enhanced Defense block
ItemDisplay[(UNI OR SET) (CHEST OR SHIELD OR HELM OR CIRC OR BOOTS) STAT360=48 !STAT152>0]:%GRAY%Rep%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Light Radius (stat 89, priority 6) ----

// Light Radius
ItemDisplay[(GLOVES OR BELT OR CHEST OR BOOTS OR SHIELD OR CIRC OR HELM OR rin OR amu) MAG STAT89>0]:%WHITE%%STAT89%%YELLOW%lr%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Magic Find per Level (stat 240, priority 7) ----

ItemDisplay[ROLL_MFLVL_TAG STAT240>0 !STAT240=8 !EQUIPPED MFIND<1]:%WHITE%$f(STAT240/8)%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_MFLVL_TAG STAT240=8 !EQUIPPED MFIND<1]:%WHITE%$f(STAT240/8).0%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_MFLVL_TAG STAT240>0 EQUIPPED MFIND<1]:%WHITE%$f(FLOOR(STAT240*CLVL/8))%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
// With Magic Find besides (Skullder's Ire corrupted +MF): one tag, the total at your level (the MF lines below skip it)
ItemDisplay[ROLL_MFLVL_TAG STAT240>0 MFIND>0]:%WHITE%$f(MFIND+FLOOR(STAT240*CLVL/8))%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Magic Find (stat 80, priority 8) ----

// Magic Find corruption on Weapons
ItemDisplay[WEAPON (UNI OR SET) MFIND>0 (STAT360=7 OR ROLL_MF_TAG) !ROLL_MFLVL_TAG]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%

// Magic Find
ItemDisplay[(rin OR amu OR ram OR CIRC OR HELM OR BELT OR BOOTS OR GLOVES OR QUIVER) (UNI OR SET) (STAT360=7 OR ROLL_MF_TAG) !ROLL_MFLVL_TAG]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM OR BELT OR BOOTS OR GLOVES) (RARE OR CRAFT) (STAT360=7 OR MFIND>9 OR (LOWLVL_MF_TAG MFIND>0))]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM OR BELT OR BOOTS OR GLOVES) MAG MFIND>0]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%

// Magic Find on Shields or Chests from corruption only
ItemDisplay[(CHEST OR SHIELD) (STAT360=7 OR ROLL_MF_TAG) !ROLL_MFLVL_TAG]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Reduced Vendor Prices (stat 87, priority 8) ----

ItemDisplay[rin ROLL_VP_TAG STAT87>0]:%WHITE%%STAT87%%ORANGE%vp%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Gold Find (stat 79, priority 10) ----

ItemDisplay[WEAPON ROLL_GF_TAG GFIND>0]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%

// Gold Find
ItemDisplay[(rin OR amu OR ram OR CIRC OR HELM OR BELT OR BOOTS OR GLOVES OR QUIVER) (UNI OR SET) (STAT360=60 OR ROLL_GF_TAG)]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR (amu !STAT206>0) OR CIRC OR HELM OR BELT OR BOOTS OR GLOVES) (RARE OR CRAFT) (GFIND>39 OR (LOWLVL_GF_TAG GFIND>0))]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM OR BELT OR BOOTS OR GLOVES) MAG GFIND>0]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[CHEST ROLL_GF_TAG GFIND>0]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Damage Taken Goes to Mana (stat 114, priority 11) ----

// Damage Taken goes to mana
ItemDisplay[(rin OR amu OR CIRC OR HELM OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES) (MAG OR ROLL_DTM_TAG) DTM>0]:%WHITE%%DTM%%BLUE%dtm%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Attacker Takes Damage (stat 78, priority 13) ----

ItemDisplay[WEAPON ROLL_ATD_TAG STAT78>0]:%WHITE%%STAT78%%GRAY%atd%CS%%NAME%{%NAME%}%CONTINUE%

// Attacker Takes Damage Corruption
ItemDisplay[(UNI OR SET) STAT360=41]:%GRAY%ATD%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[MAG (CIRC OR CHEST OR SHIELD OR BELT) STAT78>0]:%WHITE%%STAT78%%GRAY%atd%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(SHIELD OR BELT OR QUIVER OR amu OR rin) ROLL_ATD_TAG STAT78>0]:%WHITE%%STAT78%%GRAY%atd%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Attacker Takes Lightning Damage (stat 128, priority 14) ----

ItemDisplay[(WEAPON OR amu OR CHEST OR SHIELD) ROLL_LATD_TAG STAT128>0]:%WHITE%%STAT128%%YELLOW%atd%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Life per Demon Kill (stat 139, priority 15) ----

ItemDisplay[WEAPON ROLL_LPDK_TAG STAT139>0 STAT86<1]:%WHITE%%STAT139%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Life per Kill (stat 86, priority 16) ----

// Life per Kill
ItemDisplay[WEAPON (STAT360=8 OR ROLL_LPK_TAG) STAT86>0 STAT86<7 !ROLL_LPDK_TAG]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON (STAT360=8 OR ROLL_LPK_TAG) STAT86>6 !ROLL_LPDK_TAG]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
// With Life per Demon Kill besides (Odium corrupted +lpk): one tag, life per kill / per demon kill, 5/15lpk
ItemDisplay[WEAPON ROLL_LPDK_TAG STAT139>0 STAT86>0]:%WHITE%%STAT86%%GRAY%/%WHITE%%STAT139%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (UNI OR SET) (STAT360=8 OR ROLL_LPK_TAG) STAT86>0 STAT86<4]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (UNI OR SET) (STAT360=8 OR ROLL_LPK_TAG) STAT86>3]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (MAG OR RARE OR CRAFT) STAT86>0 STAT86<4]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (MAG OR RARE OR CRAFT) STAT86>3]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM OR CHEST OR SHIELD) MAG STAT86>0 STAT86<7]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM OR CHEST OR SHIELD) MAG STAT86>6]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM) (!GEMMED (RARE OR CRAFT)) STAT86>0 STAT86<7]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM) (!GEMMED (RARE OR CRAFT)) STAT86>6]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR ram OR CIRC OR HELM) (UNI OR SET) (STAT360=8 OR ROLL_LPK_TAG) STAT86>0 STAT86<7]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR ram OR CIRC OR HELM) (UNI OR SET) (STAT360=8 OR ROLL_LPK_TAG) STAT86>6]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR BOOTS OR GLOVES) (MAG OR RARE OR CRAFT) STAT86>0 STAT86<5]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR BOOTS OR GLOVES) (MAG OR RARE OR CRAFT) STAT86>4]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS) (UNI OR SET) STAT360=8 STAT86>0 STAT86<4]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS) (UNI OR SET) STAT360=8 STAT86>3]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR SHIELD OR GLOVES) ROLL_LPK_TAG STAT86>0]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR SHIELD OR WEAPON) LOWLVL_LPK_TAG !STAT360=8 STAT86>0]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Mana per Kill (stat 138, priority 16) ----

// Mana per Kill
ItemDisplay[WEAPON (STAT360=9 OR ROLL_MPK_TAG) STAT138>0 STAT138<7]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON (STAT360=9 OR ROLL_MPK_TAG) STAT138>6]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%

// MPK and LPK on rings
ItemDisplay[rin (UNI OR SET) (STAT360=9 OR ROLL_MPK_TAG) STAT138>0 STAT138<4]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (UNI OR SET) (STAT360=9 OR ROLL_MPK_TAG) STAT138>3]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (MAG OR RARE OR CRAFT) STAT138>0 STAT138<4]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[rin (MAG OR RARE OR CRAFT) STAT138>3]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%

// MPK and LPK on amulets and circlets
ItemDisplay[(amu OR CIRC OR HELM OR CHEST OR SHIELD) MAG STAT138>0 STAT138<7]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM OR CHEST OR SHIELD) MAG STAT138>6]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM) (!GEMMED (RARE OR CRAFT)) STAT138>0 STAT138<7]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM) (!GEMMED (RARE OR CRAFT)) STAT138>6]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR ram OR CIRC OR HELM) (UNI OR SET) (STAT360=9 OR ROLL_MPK_TAG) STAT138>6]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR ram OR CIRC OR HELM) (UNI OR SET) (STAT360=9 OR ROLL_MPK_TAG) STAT138>0 STAT138<7]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR BOOTS OR GLOVES) (MAG OR RARE OR CRAFT) STAT138>0 STAT138<5]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR BOOTS OR GLOVES) (MAG OR RARE OR CRAFT) STAT138>4]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR GLOVES) (UNI OR SET) (STAT360=9 OR ROLL_MPK_TAG) STAT138>0 STAT138<5]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR GLOVES) (UNI OR SET) (STAT360=9 OR ROLL_MPK_TAG) STAT138>4]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR SHIELD) ROLL_MPK_TAG STAT138>0]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR SHIELD OR WEAPON) LOWLVL_MPK_TAG !STAT360=9 STAT138>0]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Life per Hit (stat 424, priority 16) ----

// Life per Hit
ItemDisplay[WEAPON (UNI OR SET) (STAT360=4 OR ROLL_LPH_TAG) STAT424>0]:%WHITE%%STAT424%%RED%lph%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Poison Length Reduction (stat 110, priority 18) ----

ItemDisplay[(BELT OR BOOTS OR GLOVES OR CIRC OR HELM OR CHEST OR SHIELD OR rin OR amu) (MAG OR RARE OR CRAFT) STAT110>0]:%WHITE%%STAT110%%DARK_GREEN%plr%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Half Freeze Duration (stat 118, priority 19) ----

// Half Freeze Duration on Weapons
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT) STAT118=1]:%BLUE%Hfd%CS%%NAME%{%NAME%}%CONTINUE%

// HFD on Boots Gloves or Belt
ItemDisplay[(rin OR amu OR CIRC OR HELM OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES) (MAG OR RARE OR CRAFT) STAT118>0]:%BLUE%Hfd%CS%%NAME%{%NAME%}%CONTINUE%

// S14: corruption 34 on boots, gloves and belts is half freeze duration (was replenish life)
ItemDisplay[(BOOTS OR GLOVES OR BELT) (UNI OR SET) STAT360=34 STAT118>0]:%BLUE%Hfd%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Cannot Be Frozen (stat 153, priority 20) ----

ItemDisplay[(CHEST OR SHIELD OR HELM OR CIRC OR amu OR ram) (STAT360=45 OR STAT206=45 OR (RARE STAT153>0))]:%BLUE%Cbf%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Magic Damage Reduction (stat 35, priority 21) ----

ItemDisplay[WEAPON ROLL_MDR_TAG STAT35>0]:%WHITE%%STAT35%%GRAY%mdr%CS%%NAME%{%NAME%}%CONTINUE%

// Flat Physical Damage Reduction (from corruption)
ItemDisplay[(rin OR CHEST OR SHIELD) (UNI OR SET) (STAT360=47 OR ROLL_MDR_TAG)]:%WHITE%%STAT35%%GRAY%mdr%CS%%NAME%{%NAME%}%CONTINUE%

// Flat Physical Damage Reduction  on Rare and Crafted
ItemDisplay[(rin OR (amu !STAT206>0) OR ((CIRC OR CHEST OR SHIELD OR WEAPON) LOWLVL_MDR_TAG)) (RARE OR CRAFT) STAT35>1]:%WHITE%%STAT35%%GRAY%mdr%CS%%NAME%{%NAME%}%CONTINUE%

// Flat Physical Damage Reduction on Magic items
ItemDisplay[(rin OR amu OR CIRC OR CHEST OR SHIELD) MAG STAT35>0]:%WHITE%%STAT35%%GRAY%mdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR amu) ROLL_MDR_TAG STAT35>0]:%WHITE%%STAT35%%GRAY%mdr%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Flat Physical Damage Reduction (stat 34, priority 22) ----

// Flat Magic Damage Reduction (from corruption) on Set and Unique
ItemDisplay[(rin OR CHEST OR SHIELD) (UNI OR SET) (STAT360=46 OR ROLL_PDRF_TAG)]:%WHITE%%STAT34%%GRAY%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// Flat Magic Damage Reduction (from corruption) on Rare and Crafted
ItemDisplay[(rin OR (amu !STAT206>0) OR ((CIRC OR CHEST OR SHIELD OR WEAPON) LOWLVL_PDRF_TAG)) (RARE OR CRAFT) STAT34>1]:%WHITE%%STAT34%%GRAY%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// Flat Magic Damage Reduction (from corruption) on Magic items
ItemDisplay[(rin OR amu OR CIRC OR CHEST OR SHIELD) MAG STAT34>0]:%WHITE%%STAT34%%GRAY%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR BELT OR amu) ROLL_PDRF_TAG STAT34>0]:%WHITE%%STAT34%%GRAY%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// ---- % Physical Damage Reduction (stat 36, priority 22) ----

ItemDisplay[WEAPON ROLL_PDR_TAG STAT36>0]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// %PDR - Magic Chests and Shields - Gold and Purple Names
ItemDisplay[(CHEST OR SHIELD) MAG STAT36>0 STAT36<25]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR SHIELD) MAG STAT36>24]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// %PDR - Rare/Crafted/Corrupted Chests and Shields - Gold and Purple Names
ItemDisplay[(CHEST OR SHIELD) !MAG STAT36>0 STAT36<18 (RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG)]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(CHEST OR SHIELD) !MAG STAT36>17 (RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG)]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// %PDR on Rings and Boots
ItemDisplay[(rin OR BOOTS) (MAG OR RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG) STAT36>0]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// %PDR on Belts
// Rare/Crafted Belts
ItemDisplay[BELT !MAG (RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG) (STAT36>0 STAT36<8)]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[BELT !MAG (RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG) STAT36>7]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// Magic Belts
ItemDisplay[BELT MAG STAT36>0 STAT36<9]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[BELT MAG STAT36>8 CLVL<80]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// %PDR on Helms and Circlets
ItemDisplay[(HELM OR CIRC) MAG (STAT36>0 STAT36<14)]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR CIRC) MAG STAT36>13]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// %PDR on Helms and Circlets
ItemDisplay[(HELM OR CIRC) !MAG (RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG) (STAT36>0 STAT36<13)]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR CIRC) !MAG (RARE OR CRAFT OR STAT360=52 OR ROLL_PDR_TAG) STAT36>12]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[QUIVER ROLL_PDR_TAG STAT36>0]:%WHITE%%STAT36%%GOLD%%PERCENT%pdr%CS%%NAME%{%NAME%}%CONTINUE%

// ---- % Fire Absorb (stat 142, priority 23) ----

ItemDisplay[rin ROLL_FABSP_TAG STAT142>0]:%WHITE%%STAT142%%RED%%PERCENT%abs%CS%%NAME%{%NAME%}%CONTINUE%

// ---- % Lightning Absorb (stat 144, priority 24) ----

ItemDisplay[WEAPON ROLL_LABSP_TAG STAT144>0]:%WHITE%%STAT144%%YELLOW%%PERCENT%abs%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR rin) ROLL_LABSP_TAG STAT144>0]:%WHITE%%STAT144%%YELLOW%%PERCENT%abs%CS%%NAME%{%NAME%}%CONTINUE%

// ---- % Cold Absorb (stat 148, priority 25) ----

ItemDisplay[WEAPON ROLL_CABSP_TAG STAT148>0]:%WHITE%%STAT148%%BLUE%%PERCENT%abs%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Fire Absorb (stat 143, priority 27) ----

ItemDisplay[HELM ROLL_FABS_TAG STAT143>0]:%WHITE%%STAT143%%RED%abs%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Lightning Absorb (stat 145, priority 29) ----

ItemDisplay[WEAPON ROLL_LABS_TAG STAT145>0]:%WHITE%%STAT145%%YELLOW%abs%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[HELM ROLL_LABS_TAG STAT145>0]:%WHITE%%STAT145%%YELLOW%abs%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Magic Absorb (stat 147, priority 33) ----

// Magic Absorb (unique/set and runeword rolls)
ItemDisplay[ROLL_MABS_TAG STAT147>0]:%WHITE%%STAT147%%ORANGE%abs%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Poison Resist (stat 45, priority 34) ----

ItemDisplay[WEAPON ROLL_PRES_TAG PRES>0]:%WHITE%%PRES%%DARK_GREEN%res%CS%%NAME%{%NAME%}%CONTINUE%

// Poison Resist
ItemDisplay[(rin OR amu OR ram OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD OR QUIVER) (UNI OR SET) (STAT360=39 OR ROLL_PRES_TAG)]:%WHITE%%PRES%%DARK_GREEN%res%CS%%NAME%{%NAME%}%CONTINUE%

// Single Resist - Rare and Crafted
// Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) PRES>0 !FRES>0 !LRES>0 !CRES>0]:%WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Single Resist - Magic
// Poison
ItemDisplay[(rin OR amu OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD) MAG PRES>0 !RES>0]:%WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Fire Resist (stat 39, priority 36) ----

ItemDisplay[WEAPON ROLL_FRES_TAG FRES>0]:%WHITE%%FRES%%RED%res%CS%%NAME%{%NAME%}%CONTINUE%

// Fire Resist
ItemDisplay[(rin OR amu OR ram OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD OR QUIVER) (UNI OR SET) (STAT360=36 OR ROLL_FRES_TAG)]:%WHITE%%FRES%%RED%res%CS%%NAME%{%NAME%}%CONTINUE%

// Dual Resist - Rare and Crafted
// Fire Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) PRES>0 FRES>0 !LRES>0 !CRES>0]:%WHITE%%FRES%%RED%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Fire
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) FRES>0 !PRES>0 !LRES>0 !CRES>0]:%WHITE%%FRES%%RED%r%CS%%NAME%{%NAME%}%CONTINUE%

// Fire
ItemDisplay[(rin OR amu OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD) MAG FRES>0 !RES>0]:%WHITE%%FRES%%RED%r%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Lightning Resist (stat 41, priority 38) ----

ItemDisplay[WEAPON ROLL_LRES_TAG LRES>0]:%WHITE%%LRES%%YELLOW%res%CS%%NAME%{%NAME%}%CONTINUE%

// Light Resist
ItemDisplay[(rin OR amu OR ram OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD OR QUIVER) (UNI OR SET) (STAT360=38 OR ROLL_LRES_TAG)]:%WHITE%%LRES%%YELLOW%res%CS%%NAME%{%NAME%}%CONTINUE%

// Light Fire Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) PRES>0 FRES>0 LRES>0 !CRES>0]:%WHITE%%LRES%%YELLOW%r %WHITE%%FRES%%RED%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Light Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) PRES>0 LRES>0 !FRES>0 !CRES>0]:%WHITE%%LRES%%YELLOW%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Light Fire
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) LRES>0 FRES>0 !PRES>0 !CRES>0]:%WHITE%%LRES%%YELLOW%r %WHITE%%FRES%%RED%r%CS%%NAME%{%NAME%}%CONTINUE%

// Light
