ItemDisplay[WEAPON (MAG OR RARE OR CRAFT OR STAT360=2 OR STAT360=17 OR STAT360=22 OR STAT360=26 OR STAT360=25 OR STAT360=24 OR ROLL_ED_TAG) ED>0 ED<100]:%WHITE%%EDAM%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT OR STAT360=2 OR STAT360=17 OR STAT360=22 OR STAT360=26 OR STAT360=25 OR STAT360=24 OR ROLL_ED_TAG) ED>99 ED<400]:%WHITE%%EDAM%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT OR STAT360=2 OR STAT360=17 OR STAT360=22 OR STAT360=26 OR STAT360=25 OR STAT360=24 OR ROLL_ED_TAG) ED>399]:%WHITE%%EDAM%%PURPLE%ed%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[((GLOVES !(MAG OR RARE OR CRAFT)) OR amu OR ram OR QUIVER) (STAT360=2 OR STAT206=2 OR ROLL_EDAM_TAG)]:%WHITE%%EDAM%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%

