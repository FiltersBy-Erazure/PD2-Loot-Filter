// Cold 
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) CRES>0 !FRES>0 !LRES>0 !PRES>0]:%WHITE%%CRES%%BLUE%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold
