// ------------------------------------------------------------------------------
//     =========================  Affixes Tags Display ======================
// ------------------------------------------------------------------------------

// Put Affixes on Lower Line - Magic Rare and Crafted Items
ItemDisplay[ID (MAG OR RARE OR CRAFT)]:%CL%%NAME%{%NAME%}%CONTINUE%

// Put Affixes on Lower Line - Unique and Set Items
ItemDisplay[ID (UNI OR SET)]:%CL%%NAME%{%NAME%}%CONTINUE%

// ------------------------------------------------------------------------
// =========================  Affixes on Weapons  =========================
// ------------------------------------------------------------------------

// Repair Durability
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT) REPAIR>0]:%GRAY%Rep%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON ROLL_SK221_TAG SK221>0]:%WHITE%%SK221%%TAN%raven%CS%%NAME%{%NAME%}%CONTINUE%

// Magic Find corruption on Weapons
ItemDisplay[WEAPON (UNI OR SET) MFIND>0 (STAT360=7 OR ROLL_MF_TAG)]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%

// Half Freeze Duration on Weapons
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT) STAT118=1]:%BLUE%Hfd%CS%%NAME%{%NAME%}%CONTINUE%

// -% Requirements
ItemDisplay[WEAPON (UNI OR SET) STAT360=6 STAT91<0]:%WHITE%%STAT91%%LIGHT_GRAY%%PERCENT%req%CS%%NAME%{%NAME%}%CONTINUE%

// Life per Hit
ItemDisplay[WEAPON (UNI OR SET) STAT360=4 STAT424>0]:%WHITE%%STAT424%%RED%lph%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON ROLL_LPH_TAG STAT424>0 !STAT360=4]:%WHITE%%STAT424%%RED%lph%CS%%NAME%{%NAME%}%CONTINUE%

// Life per Kill
ItemDisplay[WEAPON (STAT360=8 OR ROLL_LPK_TAG) STAT86>0 STAT86<7]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON (STAT360=8 OR ROLL_LPK_TAG) STAT86>6]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
// Mana per Kill
ItemDisplay[WEAPON (STAT360=9 OR ROLL_MPK_TAG) STAT138>0 STAT138<7]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[WEAPON (STAT360=9 OR ROLL_MPK_TAG) STAT138>6]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%

// Deadly Strike
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT OR STAT360=25 OR STAT360=19 OR ROLL_DS_TAG) (!DAGGER OR (DAGGER THROWING)) STAT141>9 STAT141<20]:%WHITE%%STAT141%%RED%ds%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT OR STAT360=25 OR STAT360=19 OR ROLL_DS_TAG) (!DAGGER OR (DAGGER THROWING)) STAT141>19]:%WHITE%%STAT141%%PURPLE%ds%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT OR STAT360=25 OR STAT360=19 OR ROLL_DS_TAG) DAGGER !THROWING STAT141>20]:%WHITE%%STAT141%%PURPLE%ds%CS%%NAME%{%NAME%}%CONTINUE%//

// Magic Rare or Crafted -% Enemy Resist
// Fire Damage
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT) STAT329>0]:%WHITE%%STAT329%%RED%%PERCENT%f%CS%%NAME%{%NAME%}%CONTINUE%
// Light Damage
ItemDisplay[WEAPON (MAG OR RARE OR CRAFT) STAT330>0]:%WHITE%%STAT330%%YELLOW%%PERCENT%l%CS%%NAME%{%NAME%}%CONTINUE%
