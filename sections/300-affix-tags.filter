ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=54 OR ROLL_MAXCR_TAG) !ROLL_MAXRES_TAG STAT44>0]:%WHITE%%STAT44%%BLUE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR QUIVER OR rin) ROLL_MAXCR_TAG STAT44>0]:%WHITE%%STAT44%%BLUE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Poison Resist (stat 46, priority 45) ----

ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT46>0 !((SHIELD OR BELT) $f(STAT46<=MAXRES))]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=56 OR ROLL_MAXPR_TAG) !ROLL_MAXRES_TAG STAT46>0]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(QUIVER OR rin) ROLL_MAXPR_TAG STAT46>0]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- All Maximum Resistances (stat 46+, priority 45) ----

// All four Maximum Resistances on belts and shields: the belt corruption (+2%; MAXRES is the lowest of the four).
// The S14 belt/shield affix (+2-3% / +3-5%) is one element: its line above shows the element's total when that is
// above MAXRES, so a corrupted belt with the affix shows both tags
ItemDisplay[(SHIELD OR BELT) (RARE OR CRAFT) MAXRES>0]:%WHITE%%MAXRES%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(SHIELD OR BELT) MAG MAXRES>0]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[BELT (UNI OR SET) STAT360=72 MAXRES>0]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[amu (RARE OR CRAFT) MAXRES>0]:%WHITE%%MAXRES%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR ram) (MAG OR UNI OR SET) MAXRES>0]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// All four Maximum Resistances (uniques that roll each, ROLL_MAXRES_TAG): poison/cold/lightning/fire, or one number when
// all are equal. Corruptions of one max resist count in these values: the corruption lines below skip these items
ItemDisplay[ROLL_MAXRES_TAG $f(MAX(STAT40,STAT42,STAT44,STAT46)>MAXRES)]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%%GRAY%/%WHITE%%STAT44%%BLUE%%PERCENT%%GRAY%/%WHITE%%STAT42%%YELLOW%%PERCENT%%GRAY%/%WHITE%%STAT40%%RED%%PERCENT%%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_MAXRES_TAG $f(MAX(STAT40,STAT42,STAT44,STAT46)==MAXRES)]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

