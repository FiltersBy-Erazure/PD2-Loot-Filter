// ---- All Resistances (stat 43+, priority 40) ----

ItemDisplay[WEAPON ROLL_RES_TAG RES>0]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD) (MAG OR RARE OR CRAFT) RES>0]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR ram OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD OR QUIVER) (UNI OR SET) (STAT360=51 OR STAT206=51 OR ROLL_RES_TAG) RES>0 !(UNI ID (uth OR usk OR ((aqv2 OR aqv3) FRW>19 DEX>14 CRES>49)))]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI ID (uth OR usk OR ((aqv2 OR aqv3) FRW>19 DEX>14 CRES>49)) (STAT360=51 OR STAT206=51)]:%PURPLE%Res%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Fire Resist (stat 40, priority 42) ----

ItemDisplay[WEAPON ROLL_MAXFR_TAG STAT40>0]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// Individual Maximum Resistances
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT40>0 !((SHIELD OR BELT) $f(STAT40<=MAXRES))]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=53 OR ROLL_MAXFR_TAG) !ROLL_MAXRES_TAG STAT40>0]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(GLOVES OR QUIVER OR amu OR rin) ROLL_MAXFR_TAG STAT40>0]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Lightning Resist (stat 42, priority 43) ----

ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT42>0 !((SHIELD OR BELT) $f(STAT42<=MAXRES))]:%WHITE%%STAT42%%YELLOW%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=55 OR ROLL_MAXLR_TAG) !ROLL_MAXRES_TAG STAT42>0]:%WHITE%%STAT42%%YELLOW%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR QUIVER OR rin) ROLL_MAXLR_TAG STAT42>0]:%WHITE%%STAT42%%YELLOW%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Cold Resist (stat 44, priority 44) ----

