// ---- % Maximum Mana (stat 77, priority 54) ----

ItemDisplay[CHEST ROLL_MAXMANA_TAG STAT77>0]:%WHITE%%STAT77%%BLUE%%PERCENT%m%CS%%NAME%{%NAME%}%CONTINUE%

// % Maximum Mana
ItemDisplay[BOOTS (MAG OR RARE OR CRAFT) STAT77>9]:%WHITE%%STAT77%%BLUE%%PERCENT%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(WEAPON OR SHIELD OR GLOVES OR BOOTS OR BELT OR rin) ROLL_MAXMANA_TAG STAT77>0]:%WHITE%%STAT77%%BLUE%%PERCENT%m%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Mana (stat 9, priority 55) ----

ItemDisplay[(HELM OR CIRC) ROLL_MANA_TAG MANA>0]:%WHITE%%MANA%%BLUE%mn%CS%%NAME%{%NAME%}%CONTINUE%

// Mana
ItemDisplay[(rin OR amu OR CIRC OR ((HELM OR CHEST OR SHIELD OR WEAPON) LOWLVL_MANA_TAG)) (RARE OR CRAFT) (MANA>49 OR (LOWLVL_MANA_TAG MANA>0)) !STAT217>0]:%WHITE%%MANA%%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR BOOTS OR GLOVES) (RARE OR CRAFT) (MANA>29 OR (LOWLVL_MANA_TAG MANA>0))]:%WHITE%%MANA%%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES) MAG MANA>0 !STAT217>0]:%WHITE%%MANA%%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%

// Mana per character level (stat 217, held in 256ths like mana: /2048 = /8 per level): one tag with the flat mana, the total at your level (rares always)
ItemDisplay[(amu OR CIRC OR HELM) (RARE OR CRAFT) STAT217>0]:%WHITE%$f(STAT9+FLOOR(STAT217*CLVL/2048))%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM) MAG STAT217>0]:%WHITE%$f(STAT9+FLOOR(STAT217*CLVL/2048))%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[CHEST (UNI OR SET) (STAT360=10 OR ROLL_MANA_TAG)]:%WHITE%%MANA%%BLUE%mn%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(WEAPON OR SHIELD OR BELT OR amu OR rin) ROLL_MANA_TAG MANA>0]:%WHITE%%MANA%%BLUE%mn%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Replenish Life (stat 74, priority 56) ----

// Replenish Life
ItemDisplay[(UNI OR SET) (((HELM OR CIRC) STAT360=34) OR ROLL_REPLIFE_TAG) STAT74>0]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(UNI OR SET) (HELM OR CIRC) STAT360=34 STAT74<1]:%WHITE%$f(ABS(STAT74))%RED%drain%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR CIRC OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES OR amu OR rin) MAG STAT74>0]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR CIRC) (RARE OR CRAFT) STAT360=34 STAT74>0]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Life per Level (stat 216, priority 57) ----

// Per-level rolls on uniques/sets: per level, or the total at your level while your character wears the item.
// BH shows a whole number without its ".0": exactly 1 per level adds it (1.0lf, so it reads as per level)
ItemDisplay[ROLL_LIFELVL_TAG STAT216>0 !STAT216=2048 !EQUIPPED]:%WHITE%$f(STAT216/2048)%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_LIFELVL_TAG STAT216=2048 !EQUIPPED]:%WHITE%$f(STAT216/2048).0%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_LIFELVL_TAG STAT216>0 EQUIPPED]:%WHITE%$f(FLOOR(STAT216*CLVL/2048))%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%

