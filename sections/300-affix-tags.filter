ItemDisplay[(amu OR CIRC OR HELM OR CHEST OR SHIELD) (RARE OR CRAFT) STAT216>0]:%WHITE%$f(STAT7+FLOOR(STAT216*CLVL/2048))%RED%l%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM OR CHEST OR SHIELD) MAG STAT216>0]:%WHITE%$f(STAT7+FLOOR(STAT216*CLVL/2048))%RED%l%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(WEAPON OR CHEST OR BELT OR amu OR HELM) ROLL_LIFE_TAG LIFE>0]:%WHITE%%LIFE%%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%

