// Cold Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) PRES>0 CRES>0 !FRES>0 !LRES>0]:%WHITE%%CRES%%BLUE%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold Light
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC OR ((CHEST OR SHIELD OR WEAPON) LOWLVL_SRES_TAG)) (RARE OR CRAFT) CRES>0 LRES>0 !PRES>0 !FRES>0]:%WHITE%%CRES%%BLUE%r %WHITE%%LRES%%YELLOW%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold Fire
