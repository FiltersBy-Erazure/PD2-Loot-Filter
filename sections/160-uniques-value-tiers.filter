ItemDisplay[UNI !ID aqv3]:%NAME%%CONTINUE%// Basilisk's Quill / Doom's Finger Razor Arrows / Aetherwing
ItemDisplay[UNI !ID cqv3]:%NAME%%CONTINUE%// Abyssal Ward / Bannerlord's Call / Frozen Sorrow War Bolts
ItemDisplay[UNI !ID (aqv3 OR cqv3)]:%UNI_MEDIUM_VALUE_LEFT%  %NAME%  %UNI_MEDIUM_VALUE_RIGHT%%BORDER-08%%MAP-50%%DOT-59%%PX-6A%//
//     Minimal Value Quivers
ItemDisplay[UNI !ID cqv2]:%NAME%%CONTINUE%// Shatterhead / Anvilguard Strap Heavy Bolts
ItemDisplay[UNI !ID aqv2 CLVL<60]:%NAME%%CONTINUE%// Tombsong / Swiftwind Needle Sharp Arrows
ItemDisplay[UNI !ID (cqv2 OR (aqv2 CLVL<60))]:%UNI_MINIMAL_VALUE_LEFT%  %NAME%  %UNI_MINIMAL_VALUE_RIGHT%%MAP-50%%DOT-59%%PX-6A%//

// --------------------------------------------------------------------------------------------------------
// =======================================  Low Level Duel Uniques  =======================================
// --------------------------------------------------------------------------------------------------------

ItemDisplay[UNI !ID xap]:%NAME%%CONTINUE%// Peasant Crown War Hat
ItemDisplay[UNI !ID fld]:%NAME%%CONTINUE%// Rockfleece Field Plate
ItemDisplay[UNI !ID tbt]:%NAME%%CONTINUE%// Goblin Toe Light Plated Boots
ItemDisplay[UNI !ID gth]:%NAME%%CONTINUE%// Rattlecage Gothic Plate
ItemDisplay[UNI !ID hbt]:%NAME%%CONTINUE%// Tearhaunch Greaves
ItemDisplay[UNI !ID mbt]:%NAME%%CONTINUE%// Treads of Cthon
ItemDisplay[UNI !ID pa3]:%NAME%%CONTINUE%// Sankekur's Fall
ItemDisplay[UNI !ID aar]:%NAME%%CONTINUE%// Silks of the Victor Ancient Armor
ItemDisplay[UNI !ID gsd]:%NAME%%CONTINUE%// The Patriarch Great Sword
ItemDisplay[UNI !ID vgl]:%NAME%%CONTINUE%// Bloodfist Heavy Gloves
ItemDisplay[UNI !ID mau]:%NAME%%CONTINUE%// Bonesnap Maul

ItemDisplay[UNI !ID !ETH FILTLVL<8 (xap OR fld OR tbt OR gth OR hbt OR mbt OR pa3 OR aar OR gsd OR vgl OR mau)]:%UNI_LLD_LEFT%  %NAME%  %UNI_LLD_RIGHT%%BORDER-11%%MAP-C5%%DOT-9F%%PX-A2%//
ItemDisplay[UNI !ID !ETH FILTLVL~8-11 (xap OR fld OR tbt OR gth OR hbt OR mbt OR pa3 OR aar OR gsd OR vgl OR mau)]:%NAME% %GRAY%[%TEAL%LLD%GRAY%]%GOLD%//

// --------------------------------------------------------------------------------------------------------
// =======================================  All Other Unique Items  =======================================
// --------------------------------------------------------------------------------------------------------

// Notify for all Normal Unique Items on Filter Levels 0-2
ItemDisplay[UNI !ID FILTLVL<3]:%UNI_NORMAL_LEFT%  %NAME%  %UNI_NORMAL_RIGHT%%BORDER-21%%MAP-13%%DOT-18%%PX-20%//
// Notify for all Normal Unique Items on Filter Levels 3-7
ItemDisplay[UNI !ID FILTLVL~3-7]:%UNI_NORMAL_LEFT%  %NAME%  %UNI_NORMAL_RIGHT%%MAP-13%%DOT-18%%PX-20%//
// Don't notify for other Normal Unique Items on filter levels 11-12
ItemDisplay[UNI !ID FILTLVL~8-11]:%NAME%//
// Hide Minimal Value normal unique items on filter level 12
ItemDisplay[UNI !ID FILTLVL=12 !TOWN !GRAIL_NEW]://

