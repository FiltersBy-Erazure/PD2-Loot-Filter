// Add Area Level
ItemDisplay[STAT374=0 !STAT360>0 (MAPTIER=1 OR t58)]:%NAME%{%WHITE%Area Level: 87%CL%%NAME%}%CONTINUE%//
ItemDisplay[STAT374=0 !STAT360>0 (MAPTIER=2 OR t52 OR t53 OR t57)]:%NAME%{%WHITE%Area Level: 88%CL%%NAME%}%CONTINUE%//
ItemDisplay[STAT374=0 !STAT360>0 (MAPTIER=3 OR t51 OR t54 OR t55 OR t56)]:%NAME%{%WHITE%Area Level: 89%CL%%NAME%}%CONTINUE%//
ItemDisplay[STAT374=0 !STAT360>0 MAPTIER=4]:%NAME%{%WHITE%Area Level: 92%CL%%NAME%}%CONTINUE%//

// +1 Area Level
ItemDisplay[STAT374=1 (MAPTIER=1 OR t58)]:%NAME%{%GOLD%Area Level: 88%CL%%NAME%}%CONTINUE%//
ItemDisplay[STAT374=1 (MAPTIER=2 OR t52 OR t53 OR t57)]:%NAME%{%GOLD%Area Level: 89%CL%%NAME%}%CONTINUE%//
ItemDisplay[STAT374=1 (MAPTIER=3 OR t51 OR t54 OR t55 OR t56)]:%NAME%{%GOLD%Area Level: 90%CL%%NAME%}%CONTINUE%//
ItemDisplay[STAT374=1 MAPTIER=4]:%NAME%{%GOLD%Area Level: 93%CL%%NAME%}%CONTINUE%//

