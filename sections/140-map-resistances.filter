// =========================================================================
// Season 13 Map Resistance Display (Per-Map, Element-by-Element)
// =========================================================================
//
// Guest Monster Resistance Values:
//   STAT439 = Vampire Lords     (Phys 75%, Cold 75%)
//   STAT440 = Hell Bovines      (Phys 50%)
//   STAT441 = Reanimated        (Phys 50%, Magic 50%, Fire 75%, Poison 80%)
//   STAT442 = Ghosts            (Phys 50%, Magic 50%, Light 65%, Poison 95%)
//   STAT437 = Dolls             (Poison 80%)
//   STAT470 = Souls             (Light 80%, Poison 75%)
//   STAT499 = Shrieking Terrors (Cold 80%)
//
// File order (top-to-bottom): Phys, Magic, Poison, Cold, Lightning, Fire
// Each line prepends via %CONTINUE%, visual order: Fire * Light * Cold * Psn * Magic * Phys
// First element per section (file order) has NO trailing *  (rightmost visually)
// Subsequent elements have trailing " %WHITE%* " to connect to element below
//

// ========================= Tier 1 Maps (Area Level 87) =========================

// ===== Ancestral Trial (t34) =====
// S13: P=50 M=50 F=120 L=120 C=75 Psn=75
ItemDisplay[t34 !STAT360>0]:%NAME%{%CL%%WHITE%Highest Resistances:%CL%%NAME%}%CONTINUE%//
ItemDisplay[t34 STAT439>0 !STAT360>0]:%NAME%{%GOLD%75%%NAME%}%CONTINUE%// Phys with Vampire Lords (75)
ItemDisplay[t34 !STAT439>0 !STAT360>0]:%NAME%{%GOLD%50%%NAME%}%CONTINUE%// Phys base (50)
ItemDisplay[t34 !STAT360>0]:%NAME%{%ORANGE%50% %WHITE%* %NAME%}%CONTINUE%// Magic 50
ItemDisplay[t34 STAT442>0 !STAT360>0]:%NAME%{%DARK_GREEN%95% %WHITE%* %NAME%}%CONTINUE%// Poison with Ghosts (95)
ItemDisplay[t34 !STAT442>0 (STAT441>0 OR STAT437>0) !STAT360>0]:%NAME%{%DARK_GREEN%80% %WHITE%* %NAME%}%CONTINUE%// Poison with Reanimated/Dolls (80)
ItemDisplay[t34 !STAT442>0 !STAT441>0 !STAT437>0 !STAT360>0]:%NAME%{%DARK_GREEN%75% %WHITE%* %NAME%}%CONTINUE%// Poison base (75)
ItemDisplay[t34 STAT499>0 !STAT360>0]:%NAME%{%BLUE%80% %WHITE%* %NAME%}%CONTINUE%// Cold with Shrieking Terrors (80)
ItemDisplay[t34 !STAT499>0 !STAT360>0]:%NAME%{%BLUE%75% %WHITE%* %NAME%}%CONTINUE%// Cold base (75)
ItemDisplay[t34]:%NAME%{%CL%%WHITE%Monster Immunities:%CL%%NAME%}%CONTINUE%//
ItemDisplay[t34]:%NAME%{%YELLOW%120%%NAME%}%CONTINUE%// Light 120
ItemDisplay[t34]:%NAME%{%RED%120% %WHITE%* %NAME%}%CONTINUE%// Fire 120

