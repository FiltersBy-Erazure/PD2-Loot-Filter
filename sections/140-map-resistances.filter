// =========================================================================
// Season 14 Map Resistance Display (Per-Map, Element-by-Element)
// =========================================================================
//
// S14: every block checked against the S14 game data (2026-10-10). A map item's start area is its Misc.txt
// "len"; the values are the highest hell resistances (MonStats.txt) of the monsters its areas spawn
// (Levels.txt nmon lists). Multi-area maps count every area with monsters: Warlord of Blood 181-182,
// City of Ureh 195-196, Djinn's Domain 197-198 (not the Wishing Well's list), Zhar's Sanctum 177-179
// (176 is the portal entrance).
//
// Guest Monster Resistance Values:
//   STAT439 = Vampire Lords     (Phys 75%, Cold 75%, Poison 50%)
//   STAT440 = Hell Bovines      (Phys 50%)
//   STAT441 = Reanimated        (Phys 50%, Magic 50%, Fire 75%, Poison 80%)
//   STAT442 = Ghosts            (Phys 50%, Magic 50%, Light 65%, Poison 50%)
//   STAT437 = Dolls             (Poison 80%)
//   STAT470 = Souls             (Magic 25%, Light 80%, Poison 75%)
//   STAT499 = Minions of Destruction (Phys 50%, Fire 75%, Poison 95%)
//   S14: Vampire Lords, Ghosts, Souls and Minions of Destruction are the hell resistances of the game data's
//   map-mod monsters (vampire8MapMod Dark Lord, wraithMapMod, willowisp1MapMod, baalminion3MapMod; PD2 gave
//   the Shrieking Terrors code to Minions of Destruction). Hell Bovines, Reanimated and Dolls have no map-mod
//   row; their values match hellbovine*, reanimatedhorde6 (Unholy Corpse) and bonefetish6 (Undead Stygian Doll).
//
// File order (top-to-bottom): Phys, Magic, Poison, Cold, Lightning, Fire
// Each line prepends via %CONTINUE%, visual order: Fire * Light * Cold * Psn * Magic * Phys
// First element per section (file order) has NO trailing *  (rightmost visually)
// Subsequent elements have trailing " %WHITE%* " to connect to element below
//

// ========================= Tier 1 Maps (Area Level 87) =========================

// ===== Ancestral Trial (t34) =====
// S13: P=50 M=50 F=120 L=120 C=75 Psn=75
ItemDisplay[t34 !STAT360>0]:%NAME%{%CL%%WHITE%Highest Resistances:%CL%%NAME%}%CONTINUE%//
ItemDisplay[t34 STAT439>0 !STAT360>0]:%NAME%{%GOLD%75%%NAME%}%CONTINUE%// Phys with Vampire Lords (75)
ItemDisplay[t34 !STAT439>0 !STAT360>0]:%NAME%{%GOLD%50%%NAME%}%CONTINUE%// Phys base (50)
ItemDisplay[t34 !STAT360>0]:%NAME%{%ORANGE%50% %WHITE%* %NAME%}%CONTINUE%// Magic 50
ItemDisplay[t34 STAT499>0 !STAT360>0]:%NAME%{%DARK_GREEN%95% %WHITE%* %NAME%}%CONTINUE%// Poison with Minions of Destruction (95)
ItemDisplay[t34 !STAT499>0 (STAT441>0 OR STAT437>0) !STAT360>0]:%NAME%{%DARK_GREEN%80% %WHITE%* %NAME%}%CONTINUE%// Poison with Reanimated/Dolls (80)
ItemDisplay[t34 !STAT499>0 !STAT441>0 !STAT437>0 !STAT360>0]:%NAME%{%DARK_GREEN%75% %WHITE%* %NAME%}%CONTINUE%// Poison base (75)
ItemDisplay[t34 !STAT360>0]:%NAME%{%BLUE%75% %WHITE%* %NAME%}%CONTINUE%// Cold base (75)
ItemDisplay[t34]:%NAME%{%CL%%WHITE%Monster Immunities:%CL%%NAME%}%CONTINUE%//
ItemDisplay[t34]:%NAME%{%YELLOW%120%%NAME%}%CONTINUE%// Light 120
ItemDisplay[t34]:%NAME%{%RED%120% %WHITE%* %NAME%}%CONTINUE%// Fire 120

