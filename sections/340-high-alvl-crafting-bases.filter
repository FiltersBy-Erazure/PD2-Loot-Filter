// ------------------------------------------------------------------------------
//    ===================  High Affix Level Crafting Bases  ==================
// ------------------------------------------------------------------------------

// High Affix Level Crafting Bases

// Rings - Needs Crafted Affix Level of 81+ to roll highest-tier maximum damage affix
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>69 CRAFTALVL>80 rin !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>69 CRAFTALVL<81 rin !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<70 CRAFTALVL<81 rin !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Amulets - Needs Crafted Affix Level of 90+ to roll +2 class skills
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>69 CRAFTALVL>89 amu !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>69 CRAFTALVL<90 amu !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<70 CRAFTALVL<90 amu !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Missile Weapon, Amazon Javelin, Tipped Mace, Throwing Axe
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL>74 (BOW OR XBOW OR TMACE OR (tax OR 9ta OR 7ta OR bal OR 9b8 OR 7b8) OR (tkf OR 9tk OR 7tk OR bkf OR 9bk OR 7bk) OR (ZON JAV)) !SHOP !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL>74 (BOW OR XBOW OR TMACE OR (tax OR 9ta OR 7ta OR bal OR 9b8 OR 7b8) OR (tkf OR 9tk OR 7tk OR bkf OR 9bk OR 7bk) OR (ZON JAV)) SHOP]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL<75 (BOW OR XBOW OR TMACE OR (tax OR 9ta OR 7ta OR bal OR 9b8 OR 7b8) OR (tkf OR 9tk OR 7tk OR bkf OR 9bk OR 7bk) OR (ZON JAV)) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<50 CRAFTALVL<75 (BOW OR XBOW OR TMACE OR (tax OR 9ta OR 7ta OR bal OR 9b8 OR 7b8) OR (tkf OR 9tk OR 7tk OR bkf OR 9bk OR 7bk) OR (ZON JAV)) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Swords, Polearms, Spears, Maces (Not Tipped), Axes (Not Throwing)
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL>55 (SWORD OR POLEARM OR SPEAR OR (MACE !TMACE !(clb OR 9cl OR spc OR 9sp)) OR (AXE !THROWING) OR (JAV !ZON)) !SHOP !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL>55 (SWORD OR POLEARM OR SPEAR OR (MACE !TMACE !(clb OR 9cl OR spc OR 9sp)) OR (AXE !THROWING) OR (JAV !ZON)) SHOP]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL<56 (SWORD OR POLEARM OR SPEAR OR (MACE !TMACE !(clb OR 9cl OR spc OR 9sp)) OR (AXE !THROWING) OR (JAV !ZON)) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<50 CRAFTALVL<56 (SWORD OR POLEARM OR SPEAR OR (MACE !TMACE !(clb OR 9cl OR spc OR 9sp)) OR (AXE !THROWING) OR (JAV !ZON)) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Chests, Tower Shields/Pavise, Paladin Shields, Gloves, Boots,  Belts
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 ((CRAFTALVL>84 (CHEST OR (SHIELD !NEC) OR DIN)) OR (GLOVES CRAFTALVL>58) OR (BOOTS CRAFTALVL>64) OR (BELT CRAFTALVL>70)) !SHOP !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 ((CRAFTALVL>84 (CHEST OR (SHIELD !NEC) OR DIN)) OR (GLOVES CRAFTALVL>58) OR (BOOTS CRAFTALVL>64) OR (BELT CRAFTALVL>70)) SHOP]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 ((CRAFTALVL<85 (CHEST OR (SHIELD !NEC) OR DIN)) OR (GLOVES CRAFTALVL<59) OR (BOOTS CRAFTALVL<65) OR (BELT CRAFTALVL<71)) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<50 ((CRAFTALVL<85 (CHEST OR (SHIELD !NEC) OR DIN)) OR (GLOVES CRAFTALVL<59) OR (BOOTS CRAFTALVL<65) OR (BELT CRAFTALVL<71)) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Class Items: Staves, Sorc Orbs, Claws, Wands, Clubs
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL>49 (STAFF OR SOR OR btl OR 9tw OR 7tw OR axf OR 9xf OR 7xf OR wsp OR (WAND !(wnd OR ywn OR 9wn)) OR clb OR 9cl OR spc OR 9sp) !SHOP !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL>49 (STAFF OR SOR OR btl OR 9tw OR 7tw OR axf OR 9xf OR 7xf OR wsp OR (WAND !(wnd OR ywn OR 9wn)) OR clb OR 9cl OR spc OR 9sp) SHOP]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>49 CRAFTALVL<50 (STAFF OR SOR OR btl OR 9tw OR 7tw OR axf OR 9xf OR 7xf OR wsp OR (WAND !(wnd OR ywn OR 9wn)) OR clb OR 9cl OR spc OR 9sp) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<50 CRAFTALVL<50 (STAFF OR SOR OR btl OR 9tw OR 7tw OR axf OR 9xf OR 7xf OR wsp OR (WAND !(wnd OR ywn OR 9wn)) OR clb OR 9cl OR spc OR 9sp) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Class Items: Barbarian Helms, Druid Pelts, Necro Heads
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>64 CRAFTALVL>64 (BAR OR DRU OR NEC) !SHOP !EQUIPPED]:%NAME%{%NAME%%CL%%ORANGE%Crafted %WHITE%Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>64 CRAFTALVL>64 (BAR OR DRU OR NEC) SHOP]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %BLUE%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL>64 CRAFTALVL<65 (BAR OR DRU OR NEC) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %RED%%CRAFTALVL%}%CONTINUE%// 
ItemDisplay[STAT360=0 (MAG OR RARE) CLVL<65 CRAFTALVL<65 (BAR OR DRU OR NEC) !EQUIPPED]:%NAME%{%NAME%%CL%%WHITE%Crafted Affix Level: %CRAFTALVL%}%CONTINUE%// 

// Show Max Resistances on Nature's Peace
ItemDisplay[UNI rin STAT40>0 STAT42>0 STAT44>0 STAT46>0]:%DARK_GREEN%%STAT46%% %BLUE%%STAT44%% %YELLOW%%STAT42%% %RED%%STAT40%%%CL%%NAME%{%NAME%}%CONTINUE%

