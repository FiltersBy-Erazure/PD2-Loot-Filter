ItemDisplay[NMAG !INF !RW SOCK=2 NORM SHIELD !sml !bsh !tow !DIN !NEC FILTLVL>0 !TOWN]:// All Normal tiers 2os
ItemDisplay[NMAG !INF !RW SOCK=3 NORM SHIELD !lrg !tow !spk !DIN !NEC FILTLVL>0 !TOWN]:// All Normal tiers 3os

//      Buckler
ItemDisplay[NMAG buc CLVL>2 FILTLVL>0 !TOWN]:// Hide all white Bucklers past character level 2

//      Small Shield
ItemDisplay[NMAG !INF !RW sml !ETH SOCK=2 CLVL<10 !GEMMED]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 2os
ItemDisplay[NMAG !INF !RW sml CLVL>19 FILTLVL>0 !TOWN]:// Hide all white small shields past character level 19

//      Large Shield, Tower Shield, Spiked Shield, Bone Shield
//  Hidden after level 60
