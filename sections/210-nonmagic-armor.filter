ItemDisplay[NMAG !INF !RW (lrg OR tow OR spk) !GEMMED !ETH SOCK=3 CLVL<30 GROUND]:%ORANGE%AP %GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 3os
//  3os Vendor Tag
ItemDisplay[NMAG !INF !RW (lrg OR tow OR spk) !GEMMED !ETH SOCK=3 CLVL<30 SHOP]:%NAME%{%ORANGE%**%TAN%**%LIGHT_GRAY%**%GRAY%**  %ORANGE%Ancient's Pledge  %GRAY%**%LIGHT_GRAY%**%TAN%**%ORANGE%**}// 3os Vendor Tag

//      Tower Shield
