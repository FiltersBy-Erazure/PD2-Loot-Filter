//      +3 to one of the following: Raven, Spirit Wolf, Dire Wolf, Grizzly
ItemDisplay[NMAG !RW !ETH DRUID ((CLVL<90 FILTLVL<8) OR FILTLVL<3) ((!DRUID CLVL<60) OR (DRUID CLVL<80)) DRU SOCK=2 (SK221>2 OR SK237>2 OR SK227>2 OR SK247>2)]:%ORANGE%Lore %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !RW !ETH !DRUID ((CLVL<90 FILTLVL<8) OR FILTLVL<3) ((!DRUID CLVL<60) OR (DRUID CLVL<80)) DRU SOCK=2 (SK221>2 OR SK237>2 OR SK227>2 OR SK247>2)]:%TEAL%Lore %WHITE%%NAME%{%NAME%}%CONTINUE%//

// Hides all other Druid Helms and clubs that don't have any + to skills past level 10
ItemDisplay[NMAG !RW (DRU OR clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp) CLVL>9 FILTLVL>0 !(SK221>0 OR SK222>0 OR SK223>0 OR SK224>0 OR SK225>0 OR SK226>0 OR SK227>0 OR SK228>0 OR SK229>0 OR SK230>0 OR SK231>0 OR SK232>0 OR SK233>0 OR SK234>0 OR SK235>0 OR SK236>0 OR SK237>0 OR SK238>0 OR SK239>0 OR SK240>0 OR SK241>0 OR SK242>0 OR SK243>0 OR SK244>0 OR SK245>0 OR SK246>0 OR SK247>0 OR SK248>0 OR SK249>0 OR SK250>0 OR SK370>0) !TOWN]:// All tiers, 0os

// ------------------------------------------------------------------------------
//    ========================  Necromancer Heads  ===========================
// ------------------------------------------------------------------------------

// On filter levels 11-12, hide nonmagical necromancer heads
ItemDisplay[NMAG !RW NEC (FILTLVL~3-7 CLVL>79) GROUND !TOWN SELLPRICE>24999 AREA<3]:%GRAY%(%TAN%$%GRAY%)//
ItemDisplay[NMAG !RW NEC (FILTLVL~3-7 CLVL>79) GROUND !TOWN (SELLPRICE<25000 OR AREA>2)]://
ItemDisplay[NMAG !RW NEC FILTLVL>7 !TOWN]:// On filter levels 11-12, hide nonmagical necromancer heads 

// Hides Ethereal Necromancer Heads
ItemDisplay[NMAG !RW ETH NEC NECROMANCER CLVL>29 !TOWN]:// If your character is a necromancer, hide all Eth nonmagical necromancer heads after character level 29
ItemDisplay[NMAG !RW ETH NEC !NECROMANCER FILTLVL>0 !TOWN]:// Hides all Eth nonmagical necromancer heads for non-necromancer characters

//      Rhyme/Splendor runeword necromancer head bases
//     At levels 1-79, (+3 to one of the following: Teeth, Skele Mastery, Skele Warrior, Clay Golem, Skeletal Mage, Bone Spear, Skele Archer, Corpse Explosion, Dark Pact)
ItemDisplay[NMAG !RW NEC NECROMANCER ((CLVL<90 FILTLVL<8) OR FILTLVL<3) ((!NECROMANCER CLVL<60) OR (NECROMANCER CLVL<80)) ((NORM (SOCK=0 OR SOCK=2)) OR ((EXC OR ELT) SOCK=2)) (SK67>2 OR SK69>2 OR SK70>2 OR SK75>2 OR SK80>2 OR SK84>2 OR SK89>2 OR SK381>2 OR SK74>2 OR SK381>2)]:%ORANGE%Rhyme %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//
ItemDisplay[NMAG !RW NEC !NECROMANCER ((CLVL<90 FILTLVL<8) OR FILTLVL<3) ((!NECROMANCER CLVL<60) OR (NECROMANCER CLVL<80)) ((NORM (SOCK=0 OR SOCK=2)) OR ((EXC OR ELT) SOCK=2)) (SK67>2 OR SK69>2 OR SK70>2 OR SK75>2 OR SK80>2 OR SK84>2 OR SK89>2 OR SK381>2 OR SK74>2 OR SK381>2)]:%TEAL%Rhyme %WHITE%%NAME%{%NAME%}%CONTINUE%//

//      Ancient's Pledge Bases
//     At levels 1-79, (+3 to one of the following: Teeth, Skele Mastery, Skele Warrior, Clay Golem, Skeletal Mage, Bone Spear, Skele Archer, Corpse Explosion, Dark Pact)
ItemDisplay[NMAG !RW NEC ((CLVL<90 FILTLVL<8) OR FILTLVL<3) ((!NECROMANCER CLVL<60) OR (NECROMANCER CLVL<80)) (EXC OR ELT) (SOCK=0 OR SOCK=3) (SK67>2 OR SK69>2 OR SK70>2 OR SK75>2 OR SK80>2 OR SK84>2 OR SK89>2 OR SK381>2 OR SK74>2 OR SK381>2)]:%ORANGE%AP %WHITE%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%//

// Hides heads that don't have at least +1 to any necro skills
ItemDisplay[NMAG !RW NEC CLVL>9 FILTLVL>0 !(SK66>0 OR SK67>0 OR SK68>0 OR SK69>0 OR SK70>0 OR SK71>0 OR SK72>0 OR SK73>0 OR SK74>0 OR SK75>0 OR SK76>0 OR SK77>0 OR SK78>0 OR SK79>0 OR SK80>0 OR SK81>0 OR SK82>0 OR SK83>0 OR SK84>0 OR SK85>0 OR SK86>0 OR SK87>0 OR SK88>0 OR SK89>0 OR SK90>0 OR SK91>0 OR SK92>0 OR SK93>0 OR SK94>0 OR SK95>0 OR SK367>0 OR SK374>0 OR SK381>0) !TOWN]://

