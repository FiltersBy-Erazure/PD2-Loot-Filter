ItemDisplay[NMAG !ID SHOP MAPID>132]:%NL%%NAME%%NL%%NL%%WHITE%Possible Uniques:%GOLD%//


// White for Noneth NMAG and Gray for Eth/Socketed NMAG
ItemDisplay[(ARMOR OR WEAPON OR QUIVER) NMAG !ETH SOCK=0]:%WHITE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(ARMOR OR WEAPON OR QUIVER) NMAG (SOCK>0 OR ETH)]:%GRAY%%NAME%{%NAME%}%CONTINUE%

// Regular Sockets
ItemDisplay[(MAG OR RARE OR SET OR UNI OR CRAFT) ID !STAT360=32 SOCK>0]:%NAME% %WHITE%%SOCKETS%{%NAME%}%CONTINUE%//
ItemDisplay[NMAG !RW !STAT360=32 SOCK>0]:%NAME% %WHITE%%SOCKETS%%GRAY%{%NAME%}%CONTINUE%//
// Sockets from Corruption
ItemDisplay[(MAG OR RARE OR SET OR UNI OR CRAFT) ID STAT360=32 SOCK>0]:%NAME% %WHITE%%SOCKETS%%RED%*{%NAME%}%CONTINUE%//
ItemDisplay[NMAG !RW STAT360=32 SOCK>0]:%NAME% %WHITE%%SOCKETS%%RED%*%GRAY%{%NAME%}%CONTINUE%//

// Filtering for items with only 1 Socket
ItemDisplay[NMAG !RW (ARMOR OR WEAPON OR QUIVER) !leg SOCK=1 CLVL<5]:%GRAY%%NAME%{%NAME%}%GRAY%%CONTINUE%// Before character level 5, show all 1 socket armors and weapons
ItemDisplay[NMAG !RW (ARMOR OR WEAPON OR QUIVER) !leg SOCK=1 CLVL>4 FILTLVL>0 !(clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp OR STAFF OR SIN OR SCEPTER OR WAND OR SOR OR BAR OR DRU OR NEC) !TOWN]:// Hides all 1 socket nonmagical items except for items that sell for gold

// On filter level 5+, hide 1 Socket Class Items
ItemDisplay[NMAG !RW (FILTLVL>2 OR (CLVL>89 FILTLVL>0)) SOCK=1 (clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp OR STAFF OR SIN OR SCEPTER OR WAND OR SOR OR BAR OR DRU OR NEC) !TOWN]:// On filter level 5+, hide 1 socket class items

// Filters out inferior items unless your character is playing that class
ItemDisplay[INF (NEC OR WAND) !NECROMANCER CLVL>9 FILTLVL>0 !TOWN]://
ItemDisplay[INF (SOR OR STAFF) !SORCERESS CLVL>9 FILTLVL>0 !TOWN]://
ItemDisplay[INF SCEPTER !PALADIN CLVL>9 FILTLVL>0 !TOWN]://
ItemDisplay[INF (DRU OR clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp) !DRUID CLVL>9 FILTLVL>0 !TOWN]://
ItemDisplay[INF BAR !BARBARIAN CLVL>9 FILTLVL>0 !TOWN]://
ItemDisplay[INF SIN !ASSASSIN CLVL>9 FILTLVL>0 !TOWN]://

ItemDisplay[INF !(NEC OR WAND OR SOR OR STAFF OR SCEPTER OR DRU OR clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp OR BAR OR SIN) CLVL>5 FILTLVL>0 !TOWN]:// Hide all Low Quality, Cracked, Crude, & Damaged items after level 5


// ========================  Non-Magic Arrows and Bolts  =========================

ItemDisplay[NMAG QUIVER SOCK~0-1 !TOWN]:// Hides nonmagical Arrow quivers without sockets or with 1 socket

ItemDisplay[NMAG (aqv OR cqv) CLVL>24 !TOWN]:// Hides normal tier quivers at levels 25+
ItemDisplay[NMAG (aqv2 OR cqv2) CLVL>49 !TOWN]:// Hides exceptional tier quivers at levels 50+
ItemDisplay[NMAG (aqv3 OR cqv3) CLVL>69 !TOWN]:// Hides elite tier quivers at levels 70+

// ------------------------------------------------------------------------------
//      =========================  Armors/Chests ===========================
// ------------------------------------------------------------------------------

// Hide nonsuperior noneth 0 socket armors after character level 70
ItemDisplay[NMAG !INF !RW ED<5 !ETH CHEST CLVL>69 FILTLVL>0 SOCK=0 !TOWN]://

// Hide nonsuperior noneth armors after character level 80 and on filter levels 3+
ItemDisplay[NMAG !INF !RW ED<5 !ETH CHEST CLVL>79 FILTLVL>2 !GEMMED SOCK>0 !EQUIPPED !TOWN]://

// Hide nonsuperior noneth armors after character level 90 and on filter levels 8+
ItemDisplay[NMAG !INF !RW ED<18 !ETH CHEST CLVL>89 FILTLVL>7 (SOCK=0 OR (!GEMMED SOCK>0)) !EQUIPPED !TOWN]://

// Hide nonsuperior eth armors after character level 90 and on filter levels 3+
ItemDisplay[NMAG !INF !RW ED<5 ETH CHEST CLVL>89 FILTLVL>2 (SOCK=0 OR (!GEMMED SOCK>0)) !EQUIPPED !TOWN]://

// Notifications for 2os and 3os armors while leveling
ItemDisplay[NMAG !INF !RW NORM CHEST !ETH SOCK=2 CLVL<20 !GEMMED]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 2os
ItemDisplay[NMAG !INF !RW NORM CHEST !ETH SOCK=3 CLVL<30 !GEMMED]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 3os

// Low-Value Normal tier Armors (Quilted Armor, Leather Armor, Hard Leather Armor, Studded Leather, Scale Mail, Chain Mail, Splint Mail, Plate Mail, Field Plate)
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (qui OR lea OR hla OR stu) SOCK=0 FILTLVL>0 !TOWN]:// Hide low-value 0 socket Armors
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (scl OR chn OR spl OR plt OR fld) SOCK=0 CLVL>19 FILTLVL>0 !TOWN]:// Hide medium-value 0 socket normal armors at character levels 20+
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (qui OR lea OR hla OR stu OR scl OR chn OR spl OR plt OR fld) CLVL>29 FILTLVL>0 !TOWN]:// Hide All Normal tier Armors after level 29

// Higher-Value Normal tier Armors (Ring Mail, Breast Plate, Gothic Plate, Full Plate Mail, Ancient Armor, Light Plate)
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (gth OR ful) ED<19 SOCK=0 CLVL>49 FILTLVL>0 !TOWN]:// Hide higher-value nonsuperior 0 socket normal armors at character levels 20+
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (rng OR brs OR aar OR ltp) ED<19 SOCK=0 CLVL>19 FILTLVL>0 !TOWN]:// Hide higher-value nonsuperior 0 socket normal armors at character levels 20+
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (rng OR brs OR gth OR ful OR aar OR ltp) (ED<19 OR SOCK=2) CLVL>29 FILTLVL>0 !(SOCK=4 (gth OR ful) CLVL<70) !TOWN]:// Hide higher-value Normal tier Armors with less than 13 %ED after level 29
ItemDisplay[NMAG !INF !RW NORM CHEST !GEMMED (rng OR brs OR gth OR ful OR aar OR ltp) (ED<20 OR SOCK=2) CLVL>29 FILTLVL>2 !TOWN]:// Hide higher-value Normal tier Armors with less than 20 %ED after level 29 on filter level 5+ 
//  3os Vendor Tag
ItemDisplay[NMAG !INF !RW (brs OR rng OR ltp) !GEMMED !ETH SOCK=3 CLVL<30 SHOP]:%TAN%**%LIGHT_GRAY%*%GRAY%*  %GRAY%%NAME%  %GRAY%*%LIGHT_GRAY%*%TAN%**%GRAY%%CONTINUE%// 3os Vendor Tag

// Low-Value Exceptional tier Armors (Ghost Armor, Serpentskin Armor, Demonhide Armor, Trellised Armor, Templar Coat, Embossed Plate, Chaos Armor, Ornate Armor)
ItemDisplay[NMAG !INF !RW !GEMMED (xui OR xea OR xla OR xtu OR xlt OR xth OR xul OR xar) SOCK=0 CLVL>49 FILTLVL>0 !TOWN]:// Hide 0os at character level 50+
ItemDisplay[NMAG !INF !RW !ETH SOCK=2 CLVL<50 (xui OR xea OR xla OR xtu)]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Notify for 2os noneth under level 50
ItemDisplay[NMAG !INF !RW !ETH (SOCK=2 OR SOCK=3) (xrs OR xtp) CLVL<80]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 2 or 3 socket Cuirass and Mage Plate under level 80
ItemDisplay[NMAG !INF !RW !GEMMED (xui OR xea OR xla OR xtu) FILTLVL>2 CLVL>69 !TOWN]:// Hide Ghost Armor, Serpentskin Armor, Demonhide Armor at filter levels 3+

// Higher-Value Exceptional tier Armors (Linked Mail, Tigulated Mail, Mesh Armor, Cuirass, Russet Armor, Sharktooth Armor, Mage Plate)
ItemDisplay[NMAG !INF !RW !GEMMED (xng OR xcl OR xhn OR xrs OR xpl OR xld OR xtp) (ED<13 OR SOCK=2) CLVL>79 FILTLVL>0 !TOWN]:// Hides Select Nonsuperior Exceptional tier Armors after 79
ItemDisplay[NMAG !INF !RW SUP !ETH (SOCK=0 OR SOCK=3) (xng OR xcl OR xhn OR xrs OR xpl OR xld OR xtp) ED>12 FILTLVL<8]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior, 3os
ItemDisplay[NMAG !INF !RW !GEMMED (xng OR xcl OR xhn OR xrs OR xpl OR xld OR xtp) (ED<19 OR SOCK=2) CLVL>79 FILTLVL>7 !TOWN]:// Hides Select Nonsuperior Exceptional tier Armors after 79
ItemDisplay[NMAG !INF !RW SUP !ETH (SOCK=0 OR SOCK=3) (xng OR xcl OR xhn OR xrs OR xpl OR xld OR xtp) ED>18 FILTLVL>7]:%GRAY%%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior, 3os

// Elite tier: 
ItemDisplay[NMAG !INF !RW !SUP !ETH (SOCK=2 OR SOCK=3 OR SOCK=4) ELT CHEST FILTLVL<3 CLVL<80]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// 
ItemDisplay[NMAG !INF !RW SUP ED>4 !ETH (SOCK=0 OR SOCK=2 OR SOCK=3 OR SOCK=4) FILTLVL<3 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior
ItemDisplay[NMAG !INF !RW SUP ED>9 !ETH (SOCK=0 OR SOCK=2 OR SOCK=3 OR SOCK=4) FILTLVL>2 CLVL<90 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior
ItemDisplay[NMAG !INF !RW SUP ED>14 !ETH (SOCK=0 OR SOCK=2 OR SOCK=3 OR SOCK=4) FILTLVL~3-7 CLVL>89 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior
ItemDisplay[NMAG !INF !RW SUP ED>17 !ETH (SOCK=0 OR SOCK=2 OR SOCK=3 OR SOCK=4) FILTLVL~8-12 CLVL>89 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Superior

ItemDisplay[NMAG !INF !RW !SUP ETH (SOCK=0 OR SOCK=2 OR SOCK=3 OR SOCK=4) ELT CHEST FILTLVL<3 CLVL<80]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Elite tier 0os, Eth
ItemDisplay[NMAG !INF !RW SUP ETH ED>4 (SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL<3 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Elite tier 0os, Superior, Eth
ItemDisplay[NMAG !INF !RW SUP ETH ED>9 (SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL>2 CLVL<90 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Elite tier 0os, Superior, Eth
ItemDisplay[NMAG !INF !RW SUP ETH ED>14 (SOCK=0 OR SOCK=3 OR SOCK=4) FILTLVL>2 CLVL>89 ELT CHEST]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Elite tier 0os, Superior, Eth
ItemDisplay[NMAG !INF !RW SUP ETH ED>4 SOCK=2 ELT CHEST FILTLVL<8 CLVL<90]:%NAME%{%NAME%}%DOT-20%%PX-00%%CONTINUE%// Elite tier 2os, Superior, Eth

