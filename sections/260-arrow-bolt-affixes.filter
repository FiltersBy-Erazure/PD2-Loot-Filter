// -------------------------------------------------------------------------------
//    =====================  Affixes for Arrows and Bolts =====================
// -------------------------------------------------------------------------------

// Arrows count the maximum damage they rolled: Blunt, Sharp and Razor Arrows (QLVL 0, 25, 45) have +2, +10 and +18 of their own
// Rare/Crafted Arrows: Hide if fewer than 2 desirable affixes at character levels 30-59
ItemDisplay[(RARE OR CRAFT) (aqv OR aqv2 OR aqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MAXDMG-IF(QLVL>40,18,IF(QLVL>20,10,2))>4,MINDMG>4,STAT115==1,ED>14,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<2) FILTLVL>0 GROUND !TOWN]://
// Rare/Crafted Arrows: Hide if fewer than 2 desirable affixes at character levels 60+
ItemDisplay[(RARE OR CRAFT) (aqv OR aqv2 OR aqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MAXDMG-IF(QLVL>40,18,IF(QLVL>20,10,2))>9,MINDMG>9,STAT115==1,ED>29,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<2) FILTLVL>0 GROUND !TOWN]://

// Rare/Crafted Bolts: Hide if fewer than 2 desirable affixes at character levels 30-59
ItemDisplay[(RARE OR CRAFT) (cqv OR cqv2 OR cqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MAXDMG>4,MINDMG>4,STAT115==1,ED>14,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<2) FILTLVL>0 GROUND !TOWN]://
// Rare/Crafted Bolts: Hide if fewer than 2 desirable affixes at character levels 60+
ItemDisplay[(RARE OR CRAFT) (cqv OR cqv2 OR cqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MAXDMG>9,MINDMG>9,STAT115==1,ED>29,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<2) FILTLVL>0 GROUND !TOWN]://

// Magic Arrows: Hide if no desirable affix at character levels 30-59
ItemDisplay[MAG (aqv OR aqv2 OR aqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MAXDMG-IF(QLVL>40,18,IF(QLVL>20,10,2))>4,MINDMG>4,STAT115==1,ED>14,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<1) FILTLVL>0 GROUND !TOWN]://
// Magic Arrows: Hide if no desirable affix at character levels 60+
ItemDisplay[MAG (aqv OR aqv2 OR aqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MAXDMG-IF(QLVL>40,18,IF(QLVL>20,10,2))>9,MINDMG>9,STAT115==1,ED>29,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<1) FILTLVL>0 GROUND !TOWN]://

// Magic Bolts: Hide if no desirable affix at character levels 30-59
ItemDisplay[MAG (cqv OR cqv2 OR cqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MAXDMG>4,MINDMG>4,STAT115==1,ED>14,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<1) FILTLVL>0 GROUND !TOWN]://
// Magic Bolts: Hide if no desirable affix at character levels 60+
ItemDisplay[MAG (cqv OR cqv2 OR cqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MAXDMG>9,MINDMG>9,STAT115==1,ED>29,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<1) FILTLVL>0 GROUND !TOWN]://

// Arrow and Bolts Visual Tags
// Below affix level 60 (ALVL<60) every roll of these shows: magic and gold find, life and mana after each kill, single
// resistances, life, dexterity, strength, deadly strike, crushing blow, life and mana stolen, damage to undead and demons,
// attack rating, maximum and minimum damage, pierce (the author, 2026-10-30)
ItemDisplay[MAG ID QUIVER]:%CL%%BLUE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[RARE ID QUIVER]:%CL%%YELLOW%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[CRAFT ID QUIVER]:%CL%%ORANGE%%NAME%{%NAME%}%CONTINUE%

// Magic Find
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED MFIND>0 ID QUIVER]:%WHITE%%MFIND%%YELLOW%mf%CS%%NAME%{%NAME%}%CONTINUE%
// Gold Find
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED GFIND>0 ID QUIVER]:%WHITE%%GFIND%%GOLD%gf%CS%%NAME%{%NAME%}%CONTINUE%
// Mana after each Kill
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT138>0 ID QUIVER]:%WHITE%%STAT138%%BLUE%mpk%CS%%NAME%{%NAME%}%CONTINUE%
// Life after each Kill
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT86>0 ID QUIVER]:%WHITE%%STAT86%%RED%lpk%CS%%NAME%{%NAME%}%CONTINUE%
// Poison Length Reduction
ItemDisplay[(MAG OR RARE OR CRAFT) STAT110>0 ID QUIVER]:%WHITE%%STAT110%%DARK_GREEN%plr%CS%%NAME%{%NAME%}%CONTINUE%
// All Resist
ItemDisplay[(MAG OR RARE OR CRAFT) RES>4 ID QUIVER]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
// Poison, Fire and Lightning Resist (not with all four: the All Resist tag)
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED PRES>0 !(FRES>0 LRES>0 CRES>0) ID QUIVER]:%WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED FRES>0 !(LRES>0 CRES>0 PRES>0) ID QUIVER]:%WHITE%%FRES%%RED%r%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED LRES>0 !(FRES>0 CRES>0 PRES>0) ID QUIVER]:%WHITE%%LRES%%YELLOW%r%CS%%NAME%{%NAME%}%CONTINUE%
// Curse Resistance
ItemDisplay[(MAG OR RARE OR CRAFT) (STAT360=49 OR STAT360=62) STAT504>0 ID QUIVER]:%WHITE%%STAT504%%GOLD%cr%CS%%NAME%{%NAME%}%CONTINUE%
// Cold Resist (not with all four: the All Resist tag)
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED CRES>0 !(FRES>0 LRES>0 PRES>0) ID QUIVER]:%WHITE%%CRES%%BLUE%r%CS%%NAME%{%NAME%}%CONTINUE%
// Life
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 LIFE>0 ID QUIVER]:%WHITE%%LIFE%%RED%l%CS%%NAME%{%NAME%}%CONTINUE%
// Dexterity
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT2>0 ID QUIVER]:%WHITE%%STAT2%%GRAY%d%CS%%NAME%{%NAME%}%CONTINUE%
// Strength
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT0>0 ID QUIVER]:%WHITE%%STAT0%%GRAY%s%CS%%NAME%{%NAME%}%CONTINUE%
// Knockback
ItemDisplay[(MAG OR RARE OR CRAFT) STAT81=1 ID QUIVER]:%LIGHT_GRAY%Knb%CS%%NAME%{%NAME%}%CONTINUE%
// Open Wounds
ItemDisplay[(MAG OR RARE OR CRAFT) STAT135>9 ID QUIVER]:%WHITE%%STAT135%%CORAL%ow%CS%%NAME%{%NAME%}%CONTINUE%
// Deadly Strike
ItemDisplay[(MAG OR RARE OR CRAFT) (STAT141>9 OR (ALVL<60 STAT141>0)) STAT141<20 ID QUIVER]:%WHITE%%STAT141%%RED%ds%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) STAT141>19 ID QUIVER]:%WHITE%%STAT141%%PURPLE%ds%CS%%NAME%{%NAME%}%CONTINUE%
// Crushing Blow
ItemDisplay[(MAG OR RARE OR CRAFT) (STAT136>9 OR (ALVL<60 STAT136>0)) ID QUIVER]:%WHITE%%STAT136%%CORAL%cb%CS%%NAME%{%NAME%}%CONTINUE%
// - Enemy Fire Res
ItemDisplay[(MAG OR RARE OR CRAFT) STAT333>4 ID QUIVER]:%WHITE%-%STAT333%%RED%%PERCENT%r%CS%%NAME%{%NAME%}%CONTINUE%
// - Enemy Cold Res
ItemDisplay[(MAG OR RARE OR CRAFT) STAT335>4 ID QUIVER]:%WHITE%-%STAT335%%BLUE%%PERCENT%r%CS%%NAME%{%NAME%}%CONTINUE%
// Life Stolen per Hit
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT60>0 ID QUIVER]:%WHITE%%STAT60%%RED%ls%CS%%NAME%{%NAME%}%CONTINUE%
// Mana Stolen per Hit
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT62>0 ID QUIVER]:%WHITE%%STAT62%%BLUE%ms%CS%%NAME%{%NAME%}%CONTINUE%
// Damage to Undead
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT122>0 ID QUIVER]:%WHITE%%STAT122%%RED%und%CS%%NAME%{%NAME%}%CONTINUE%
// Damage to Demons
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED STAT121>0 ID QUIVER]:%WHITE%%STAT121%%RED%dem%CS%%NAME%{%NAME%}%CONTINUE%
// Attack Rating
ItemDisplay[(MAG OR RARE OR CRAFT) ALVL<60 !GEMMED AR>0 ID QUIVER]:%WHITE%%AR%%DARK_GREEN%ar%CS%%NAME%{%NAME%}%CONTINUE%
// -% Target Defense
ItemDisplay[(MAG OR RARE OR CRAFT) STAT116>0 ID QUIVER]:%WHITE%-%STAT116%%GRAY%%PERCENT%d%CS%%NAME%{%NAME%}%CONTINUE%
// Ignore Target Defense
ItemDisplay[(MAG OR RARE OR CRAFT) STAT115=1 ID QUIVER]:%LIGHT_GRAY%ITD%CS%%NAME%{%NAME%}%CONTINUE%
// Max Damage: arrows by the part they rolled (their own +2, +10, +18 aside), 10-14 tan and 15+ purple as bolts, any below
// affix level 60; the tag shows the total, as the game's line
ItemDisplay[(MAG OR RARE OR CRAFT) ((aqv MAXDMG>11 MAXDMG<17) OR (aqv2 MAXDMG>19 MAXDMG<25) OR (aqv3 MAXDMG>27 MAXDMG<33) OR (ALVL<60 !GEMMED ((aqv MAXDMG>2 MAXDMG<17) OR (aqv2 MAXDMG>10 MAXDMG<25) OR (aqv3 MAXDMG>18 MAXDMG<33)))) ID]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ((aqv MAXDMG>16) OR (aqv2 MAXDMG>24) OR (aqv3 MAXDMG>32)) ID]:%WHITE%%MAXDMG%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) (MAXDMG>9 OR (ALVL<60 !GEMMED MAXDMG>0)) MAXDMG<15 ID (cqv OR cqv2 OR cqv3)]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) MAXDMG>14 ID (cqv OR cqv2 OR cqv3)]:%WHITE%%MAXDMG%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
// Min Damage
ItemDisplay[(MAG OR RARE OR CRAFT) (MINDMG>9 OR (ALVL<60 !GEMMED MINDMG>0)) MINDMG<15 ID QUIVER]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) MINDMG>14 ID QUIVER]:%WHITE%%MINDMG%%PURPLE%min%CS%%NAME%{%NAME%}%CONTINUE%
// Enhanced Damage
ItemDisplay[(MAG OR RARE OR CRAFT) ED>0 ED<40 ID QUIVER]:%WHITE%%ED%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ED>39 ED<60 ID QUIVER]:%WHITE%%ED%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ED>59 ID QUIVER]:%WHITE%%ED%%PURPLE%ed%CS%%NAME%{%NAME%}%CONTINUE%
// Pierce
ItemDisplay[(MAG OR RARE OR CRAFT) (STAT156>9 OR (ALVL<60 STAT156>0)) STAT156<20 ID QUIVER]:%WHITE%%STAT156%%ORANGE%prc%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) STAT156>19 ID QUIVER]:%WHITE%%STAT156%%PURPLE%prc%CS%%NAME%{%NAME%}%CONTINUE%
// Increased Attack Speed
ItemDisplay[(MAG OR RARE OR CRAFT) IAS>9 IAS<30 ID QUIVER]:%WHITE%%IAS%%ORANGE%ias%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) IAS>29 ID QUIVER]:%WHITE%%IAS%%PURPLE%ias%CS%%NAME%{%NAME%}%CONTINUE%
// Faster Run Walk
ItemDisplay[(MAG OR RARE OR CRAFT) STAT96>9 STAT96<30 ID QUIVER]:%WHITE%%STAT96%%TAN%frw%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) STAT96>29 ID QUIVER]:%WHITE%%STAT96%%PURPLE%frw%CS%%NAME%{%NAME%}%CONTINUE%
// + Bow Skills
ItemDisplay[(MAG OR RARE OR CRAFT) (TABSK0~1-2 OR (SHOP TABSK0>2)) ID QUIVER]:%WHITE%%TABSK0%%TAN%bow%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(MAG OR RARE OR CRAFT) !SHOP TABSK0>2 ID QUIVER]:%WHITE%%TABSK0%%GOLD%bow%CS%%NAME%{%NAME%}%CONTINUE%//
// + Passive and Magic Skills
ItemDisplay[(MAG OR RARE OR CRAFT) (TABSK1~1-2 OR (SHOP TABSK1>2)) ID QUIVER]:%WHITE%%TABSK1%%TAN%pas%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(MAG OR RARE OR CRAFT) !SHOP TABSK1>2 ID QUIVER]:%WHITE%%TABSK1%%GOLD%pas%CS%%NAME%{%NAME%}%CONTINUE%//
// + 1 All Skills
ItemDisplay[(MAG OR RARE OR CRAFT) ALLSK=1 ID QUIVER]:%WHITE%1%TAN%all%CS%%NAME%{%NAME%}%CONTINUE%//

// End of Continue Statements
ItemDisplay[(MAG OR RARE OR CRAFT) ID QUIVER]:%NAME%{%NAME%}//


