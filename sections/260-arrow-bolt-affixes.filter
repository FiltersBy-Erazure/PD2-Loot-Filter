// -------------------------------------------------------------------------------
//    =====================  Affixes for Arrows and Bolts =====================
// -------------------------------------------------------------------------------

// Rare/Crafted Arrows: Hide if fewer than 3 desirable affixes at character levels 30-59
ItemDisplay[(RARE OR CRAFT) (aqv OR aqv2 OR aqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MINDMG>4,STAT115==1,ED>19,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<2) FILTLVL>0 !TOWN]://
// Rare/Crafted Arrows: Hide if fewer than 3 desirable affixes at character levels 60+
ItemDisplay[(RARE OR CRAFT) (aqv OR aqv2 OR aqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MINDMG>9,STAT115==1,ED>39,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<2) FILTLVL>0 !TOWN]://

// Rare/Crafted Bolts: Hide if fewer than 3 desirable affixes at character levels 30-59
ItemDisplay[(RARE OR CRAFT) (cqv OR cqv2 OR cqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MAXDMG>4,MINDMG>4,STAT115==1,ED>19,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<2) FILTLVL>0 !TOWN]://
// Rare/Crafted Bolts: Hide if fewer than 3 desirable affixes at character levels 60+
ItemDisplay[(RARE OR CRAFT) (cqv OR cqv2 OR cqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MAXDMG>9,MINDMG>9,STAT115==1,ED>39,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<2) FILTLVL>0 !TOWN]://

// Magic Arrows: Hide if fewer than 3 desirable affixes at character levels 30-59
ItemDisplay[MAG (aqv OR aqv2 OR aqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MINDMG>4,STAT115==1,ED>19,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<1) FILTLVL>0 !TOWN]://
// Magic Arrows: Hide if fewer than 3 desirable affixes at character levels 60+
ItemDisplay[MAG (aqv OR aqv2 OR aqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MINDMG>9,STAT115==1,ED>39,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<1) FILTLVL>0 !TOWN]://

// Magic Bolts: Hide if fewer than 3 desirable affixes at character levels 30-59
ItemDisplay[MAG (cqv OR cqv2 OR cqv3) ID CLVL~30-59 $f(COUNT(RES>4,STAT81==1,STAT135>9,STAT141>9,STAT136>9,STAT116>9,MAXDMG>4,MINDMG>4,STAT115==1,ED>19,STAT156>9,IAS>9,STAT96>9,TABSK0>0,TABSK1>0)<1) FILTLVL>0 !TOWN]://
// Magic Bolts: Hide if fewer than 3 desirable affixes at character levels 60+
ItemDisplay[MAG (cqv OR cqv2 OR cqv3) ID CLVL>59 $f(COUNT(RES>9,STAT81==1,STAT135>9,STAT141>14,STAT136>9,STAT116>9,MAXDMG>9,MINDMG>9,STAT115==1,ED>39,STAT156>14,IAS>19,STAT96>19,TABSK0>1,TABSK1>1)<1) FILTLVL>0 !TOWN]://

// Arrow and Bolts Visual Tags
ItemDisplay[MAG ID QUIVER]:%CL%%BLUE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[RARE ID QUIVER]:%CL%%YELLOW%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[CRAFT ID QUIVER]:%CL%%ORANGE%%NAME%{%NAME%}%CONTINUE%

// Poison Length Reduction
ItemDisplay[(MAG OR RARE OR CRAFT) STAT110>0 ID QUIVER]:%WHITE%%STAT110%%DARK_GREEN%plr%CS%%NAME%{%NAME%}%CONTINUE%
// All Resist
ItemDisplay[(MAG OR RARE OR CRAFT) RES>4 ID QUIVER]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
// Curse Resistance 
ItemDisplay[(MAG OR RARE OR CRAFT) (STAT360=49 OR STAT360=62) STAT504>0 ID QUIVER]:%WHITE%%STAT504%%GOLD%cr%CS%%NAME%{%NAME%}%CONTINUE%
// Knockback
ItemDisplay[(MAG OR RARE OR CRAFT) STAT81=1 ID QUIVER]:%LIGHT_GRAY%Knbk%CS%%NAME%{%NAME%}%CONTINUE%
// Open Wounds
ItemDisplay[(MAG OR RARE OR CRAFT) STAT135>9 ID QUIVER]:%WHITE%%STAT135%%CORAL%ow%CS%%NAME%{%NAME%}%CONTINUE%
// Deadly Strike
ItemDisplay[(MAG OR RARE OR CRAFT) STAT141>9 STAT141<20 ID QUIVER]:%WHITE%%STAT141%%RED%ds%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) STAT141>19 ID QUIVER]:%WHITE%%STAT141%%PURPLE%ds%CS%%NAME%{%NAME%}%CONTINUE%
// Crushing Blow
ItemDisplay[(MAG OR RARE OR CRAFT) STAT136>9 ID QUIVER]:%WHITE%%STAT136%%CORAL%cb%CS%%NAME%{%NAME%}%CONTINUE%
// - Enemy Fire Res
ItemDisplay[(MAG OR RARE OR CRAFT) STAT333>4 ID QUIVER]:%WHITE%-%STAT333%%RED%%PERCENT%res%CS%%NAME%{%NAME%}%CONTINUE%
// - Enemy Cold Res
ItemDisplay[(MAG OR RARE OR CRAFT) STAT335>4 ID QUIVER]:%WHITE%-%STAT335%%BLUE%%PERCENT%res%CS%%NAME%{%NAME%}%CONTINUE%
// -% Target Defense
ItemDisplay[(MAG OR RARE OR CRAFT) STAT116>0 ID QUIVER]:%WHITE%-%STAT116%%GRAY%%PERCENT%d%CS%%NAME%{%NAME%}%CONTINUE%
// Ignore Target Defense
ItemDisplay[(MAG OR RARE OR CRAFT) STAT115=1 ID QUIVER]:%LIGHT_GRAY%ITD%CS%%NAME%{%NAME%}%CONTINUE%
// Max Damage
ItemDisplay[(MAG OR RARE OR CRAFT) MAXDMG>9 MAXDMG<24 ID (aqv OR aqv2 OR aqv3)]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) MAXDMG>23 ID (aqv OR aqv2 OR aqv3)]:%WHITE%%MAXDMG%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) MAXDMG>9 MAXDMG<15 ID (cqv OR cqv2 OR cqv3)]:%WHITE%%MAXDMG%%TAN%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) MAXDMG>14 ID (cqv OR cqv2 OR cqv3)]:%WHITE%%MAXDMG%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
// Min Damage
ItemDisplay[(MAG OR RARE OR CRAFT) MINDMG>9 MINDMG<15 ID QUIVER]:%WHITE%%MINDMG%%TAN%min%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) MINDMG>14 ID QUIVER]:%WHITE%%MINDMG%%PURPLE%min%CS%%NAME%{%NAME%}%CONTINUE%
// Enhanced Damage
ItemDisplay[(MAG OR RARE OR CRAFT) ED>0 ED<40 ID QUIVER]:%WHITE%%ED%%TAN%ed%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ED>39 ED<60 ID QUIVER]:%WHITE%%ED%%RED%ed%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) ED>59 ID QUIVER]:%WHITE%%ED%%PURPLE%ed%CS%%NAME%{%NAME%}%CONTINUE%
// Pierce
ItemDisplay[(MAG OR RARE OR CRAFT) STAT156>9 STAT156<20 ID QUIVER]:%WHITE%%STAT156%%ORANGE%prc%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) STAT156>19 ID QUIVER]:%WHITE%%STAT156%%PURPLE%prc%CS%%NAME%{%NAME%}%CONTINUE%
// Increased Attack Speed
ItemDisplay[(MAG OR RARE OR CRAFT) IAS>9 IAS<30 ID QUIVER]:%WHITE%%IAS%%ORANGE%ias%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) IAS>29 ID QUIVER]:%WHITE%%IAS%%PURPLE%ias%CS%%NAME%{%NAME%}%CONTINUE%
// Faster Run Walk
ItemDisplay[(MAG OR RARE OR CRAFT) STAT96>9 STAT96<30 ID QUIVER]:%WHITE%%STAT96%%TAN%frw%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(MAG OR RARE OR CRAFT) STAT96>29 ID QUIVER]:%WHITE%%STAT96%%PURPLE%frw%CS%%NAME%{%NAME%}%CONTINUE%
// + Bow Skills
ItemDisplay[(MAG OR RARE OR CRAFT) TABSK0=1 ID QUIVER]:%WHITE%+1%DARK_GREEN%bow%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(MAG OR RARE OR CRAFT) TABSK0=2 ID QUIVER]:%WHITE%+2%DARK_GREEN%bow%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(MAG OR RARE OR CRAFT) TABSK0=3 ID QUIVER]:%WHITE%+3%PURPLE%bow%CS%%NAME%{%NAME%}%CONTINUE%//
// + Passive and Magic Skills
ItemDisplay[(MAG OR RARE OR CRAFT) TABSK1=1 ID QUIVER]:%WHITE%+1%DARK_GREEN%pas%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(MAG OR RARE OR CRAFT) TABSK1=2 ID QUIVER]:%WHITE%+2%DARK_GREEN%pas%CS%%NAME%{%NAME%}%CONTINUE%//
ItemDisplay[(MAG OR RARE OR CRAFT) TABSK1=3 ID QUIVER]:%WHITE%+3%PURPLE%pas%CS%%NAME%{%NAME%}%CONTINUE%//
// + 1 All Skills
ItemDisplay[(MAG OR RARE OR CRAFT) ALLSK=1 ID QUIVER]:%WHITE%1%TAN%all%CS%%NAME%{%NAME%}%CONTINUE%//

// End of Continue Statements
ItemDisplay[(MAG OR RARE OR CRAFT) ID QUIVER]:%NAME%{%NAME%}//


