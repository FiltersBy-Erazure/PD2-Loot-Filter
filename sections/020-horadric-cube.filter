// ==================================  Horadric Cube  ===============================

ItemDisplay[box]:%GOLD%Horadric Cube%CONTINUE%//
ItemDisplay[box]:%BLACK%i%GOLD%II%BLACK%X%GOLD%II%BLACK%i  %NAME%  %BLACK%i%GOLD%II%BLACK%X%GOLD%II%BLACK%i%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%WHITE%Filter Level: 0}%CONTINUE%//
ItemDisplay[box FILTLVL=1]:%NAME%{%WHITE%Filter Level: 1%CL%%GRAY%Lowest Strictness}%CONTINUE%//
ItemDisplay[box FILTLVL=2]:%NAME%{%WHITE%Filter Level: 2%CL%%GRAY%Relaxed Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=3]:%NAME%{%WHITE%Filter Level: 3%CL%%GRAY%Strict Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=4]:%NAME%{%WHITE%Filter Level: 4%CL%%GRAY%Hides H5%CL%Strict Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=5]:%NAME%{%WHITE%Filter Level: 5%CL%%GRAY%Hides M5%CL%Strict Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=6]:%NAME%{%WHITE%Filter Level: 6%CL%%GRAY%Hides H5, M5%CL%Strict Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=7]:%NAME%{%WHITE%Filter Level: 7%CL%%GRAY%Hides H5, M5, 35%%CL%Strict Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=8]:%NAME%{%WHITE%Filter Level: 8%CL%%GRAY%Hides H5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=9]:%NAME%{%WHITE%Filter Level: 9%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=10]:%NAME%{%WHITE%Filter Level: 10%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=11]:%NAME%{%WHITE%Filter Level: 11%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=12]:%NAME%{%WHITE%Filter Level: 12%CL%%GRAY%Hides H5, M5, 35%%CL%Extreme Filtering}%CONTINUE%//

ItemDisplay[box FILTLVL=0]:%NAME%{%NAME%%CL%%GRAY%Level 12 Hides Crafting Bases, Flawless Gems, and Low Value Items%CL%%GRAY%Levels 8-9-10-11 Hide Most Non-Eth and Non-Magic Class Items%CL%%GRAY%Levels 3-4-5-6-7 Hide Some Rares and Non-Superior Items%CL%%GRAY%Level 2 Hides Additional Non-Magic/Magic Items%CL%Level 1 Shows Most Non-Magic/Magic Items}%CONTINUE%//
ItemDisplay[box CLVL<50 !FILTLVL=0]:%NAME%{%NAME%%CL%%GRAY%For %GOLD%Increase and Decrease Filter Level%CL%%GRAY%For %GOLD%Always Show Items %GRAY%and Hotkeys%CL%Open Settings to Create a Toggle}%CONTINUE%//
ItemDisplay[!BIG_GG !POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Main}%CONTINUE%//
ItemDisplay[!BIG_GG !POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Revealed}%CONTINUE%//
ItemDisplay[!BIG_GG POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Main - PoE}%CONTINUE%//
ItemDisplay[!BIG_GG POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Revealed - PoE}%CONTINUE%//
ItemDisplay[BIG_GG !POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Big GG}%CONTINUE%//
ItemDisplay[BIG_GG !POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Revealed - Big GG}%CONTINUE%//
ItemDisplay[BIG_GG POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Big GG - PoE}%CONTINUE%//
ItemDisplay[BIG_GG POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%Erazure - Revealed - Big GG - PoE}%CONTINUE%//
ItemDisplay[box]:%NAME%{%NAME%%CL%%WHITE%<<VERSION>>}//

