// ==================================  Horadric Cube  ===============================

ItemDisplay[box]:%GOLD%Horadric Cube%CONTINUE%//
ItemDisplay[box]:%BLACK%i%GOLD%II%BLACK%X%GOLD%II%BLACK%i  %NAME%  %BLACK%i%GOLD%II%BLACK%X%GOLD%II%BLACK%i%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%WHITE%Filter Level: 0}%CONTINUE%//
ItemDisplay[box FILTLVL=1]:%NAME%{%WHITE%Filter Level: 1%CL%%GRAY%Lowest Strictness}%CONTINUE%//
ItemDisplay[box FILTLVL=2]:%NAME%{%WHITE%Filter Level: 2%CL%%GRAY%Relaxed Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=3]:%NAME%{%WHITE%Filter Level: 3%CL%%GRAY%Stricter Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=4]:%NAME%{%WHITE%Filter Level: 4%CL%%GRAY%Hides 35%%CL%Stricter Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=5]:%NAME%{%WHITE%Filter Level: 5%CL%%GRAY%Advanced Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=6]:%NAME%{%WHITE%Filter Level: 6%CL%%GRAY%Hides 35%%CL%Advanced Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=7]:%NAME%{%WHITE%Filter Level: 7%CL%%GRAY%Hides 35%%CL%Advanced Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=8]:%NAME%{%WHITE%Filter Level: 8%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=9]:%NAME%{%WHITE%Filter Level: 9%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=10]:%NAME%{%WHITE%Filter Level: 10%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=11]:%NAME%{%WHITE%Filter Level: 11%CL%%GRAY%Hides H5, M5, 35%%CL%Endgame Filtering}%CONTINUE%//
ItemDisplay[box FILTLVL=12]:%NAME%{%WHITE%Filter Level: 12%CL%%GRAY%Hides H5, M5, 35%%CL%Extreme Filtering}%CONTINUE%//

ItemDisplay[box FILTLVL=0]:%NAME%{%GRAY%Level 1 Shows Most Non-Magic/Magic Items%CL%%NAME%}%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%GRAY%Level 2 Hides Additional Non-Magic/Magic Items%CL%%NAME%}%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%GRAY%Levels 3-4 Hide Some Rares and Non-Superior Items%CL%%NAME%}%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%GRAY%Levels 5-6-7 Hide More Rares, Most Magic Items, Non-Magic Class Items%CL%%NAME%}%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%GRAY%Levels 8-9-10-11 Hide Most Lower Value and Non-Class Rare Items%CL%%NAME%}%CONTINUE%//
ItemDisplay[box FILTLVL=0]:%NAME%{%GRAY%Level 12 Hides Crafting Bases, Flawless Gems, Low Value Items%CL%%NAME%}%CONTINUE%//

ItemDisplay[box CLVL<50 !FILTLVL=0]:%NAME%{%NAME%%CL%%GRAY%For %GOLD%Increase and Decrease Filter Level%CL%%GRAY%For %GOLD%Always Show Items %GRAY%and Hotkeys%CL%Open Settings to Create a Toggle}%CONTINUE%//
// Each version's name here: a style variant built from one (styles/, tools/build.py) puts in its own
Alias[MAIN_VERSION_NAME]:Erazure - Main
Alias[REVEALED_VERSION_NAME]:Erazure - Revealed
Alias[MAIN_POE_VERSION_NAME]:Erazure - Main - PoE
Alias[REVEALED_POE_VERSION_NAME]:Erazure - Revealed - PoE
Alias[BIG_GG_VERSION_NAME]:Erazure - Big GG
Alias[REVEALED_BIG_GG_VERSION_NAME]:Erazure - Revealed - Big GG
Alias[BIG_GG_POE_VERSION_NAME]:Erazure - Big GG - PoE
Alias[REVEALED_BIG_GG_POE_VERSION_NAME]:Erazure - Revealed - Big GG - PoE
ItemDisplay[!BIG_GG !POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%MAIN_VERSION_NAME%}%CONTINUE%//
ItemDisplay[!BIG_GG !POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%REVEALED_VERSION_NAME%}%CONTINUE%//
ItemDisplay[!BIG_GG POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%MAIN_POE_VERSION_NAME%}%CONTINUE%//
ItemDisplay[!BIG_GG POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%REVEALED_POE_VERSION_NAME%}%CONTINUE%//
ItemDisplay[BIG_GG !POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%BIG_GG_VERSION_NAME%}%CONTINUE%//
ItemDisplay[BIG_GG !POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%REVEALED_BIG_GG_VERSION_NAME%}%CONTINUE%//
ItemDisplay[BIG_GG POE_SOUNDS !REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%BIG_GG_POE_VERSION_NAME%}%CONTINUE%//
ItemDisplay[BIG_GG POE_SOUNDS REVEALED box]:%NAME%{%NAME%%CL%%TEAL%%REVEALED_BIG_GG_POE_VERSION_NAME%}%CONTINUE%//
ItemDisplay[box]:%NAME%{%NAME%%CL%%WHITE%<<VERSION>>}//

