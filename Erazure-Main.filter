ItemDisplay[(WEAPON !((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND)) !SOCK=1 !INF SUP NMAG !RW ED~5-13]:%WHITE%%ED%%LIGHT_GRAY%ed%CS%%NAME%{%NAME%}%CONTINUE%//
