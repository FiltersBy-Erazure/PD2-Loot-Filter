// The section below contains lines of code that are "commented out".
// When a line of code has "//" in front of it, the filter will ignore that line as it doesn't read anything after "//".
// To enable a line, simply remove the "//" in front of the line (the left-most // before ItemDisplay).
// The filter reads from top to bottom. Enabling these lines will override any lines that would otherwise hide these items.

// After making your edits, be sure to save the filter file to Diablo II\ProjectD2\filters\local
// On the launcher, click Item Filter Profiles, Local Filter, select the filter name, then click Save Filter

// =================================================================================

//  ===============  Potions  ===============
//   Show Standard Health and Mana Potions
//ItemDisplay[hp5]:%WHITE% H%RED%+ %WHITE%{%WHITE% Super Healing Potion }//
//ItemDisplay[mp5]:%WHITE% M%BLUE%+ %WHITE%{%WHITE% Super Mana Potion }//

//   Show Compact Health and Mana Potions
//ItemDisplay[mp5]:%WHITE%M%BLUE%+%WHITE%{%WHITE% Super Mana Potion }//
//ItemDisplay[hp5]:%WHITE%H%RED%+%WHITE%{%WHITE% Super Healing Potion }//

//   Hide Health and Mana Potions
//ItemDisplay[mp5]:{%WHITE% Super Mana Potion }//
//ItemDisplay[hp5]:{%WHITE% Super Healing Potion }//

//   Show Antidote Potions
//ItemDisplay[yps]:%GRAY%i%DARK_GREEN%(%WHITE%A%DARK_GREEN%)%GRAY%i%WHITE%{%WHITE%+25% poison resistance for 30 seconds%CL%%WHITE%Cures %DARK_GREEN%poison %WHITE%affliction and grants%CL%Antidote Potion}//

//   Hide Antidote Potions
//ItemDisplay[yps]:{%WHITE%+25% poison resistance for 30 seconds%CL%%WHITE%Cures %DARK_GREEN%poison %WHITE%affliction and grants%CL%Antidote Potion}//

//   Show Full Rejuvenation Potions
//ItemDisplay[rvl]:%PURPLE%i(%WHITE% Full %PURPLE%)i%WHITE%{%WHITE% Full Rejuvenation Potion }//

//   Show Small Rejuvenation Potions
//ItemDisplay[rvs]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i%WHITE%{%WHITE% Rejuvenation Potion }//

//   Hide Small Rejuvenation Potions
//ItemDisplay[rvs]:{%WHITE% Rejuvenation Potion }//

//  ==========  Arrows and Bolts  ==========
//   Hide magic quivers
//ItemDisplay[MAG !ID QUIVER]://

//   Hide rare quivers
//ItemDisplay[RARE !ID QUIVER]://

//   Show Magic Arrows
//ItemDisplay[MAG !ID (aqv2 OR aqv3)]:%BLUE%Arrows//

//   Show Rare Arrows
//ItemDisplay[RARE !ID (aqv OR aqv2 OR aqv3)]:%YELLOW%Arrows//

//   Show Magic Bolts
//ItemDisplay[MAG !ID (cqv2 OR cqv3)]:%BLUE%Bolts//

//   Show Rare Bolts
//ItemDisplay[RARE !ID (cqv OR cqv2 OR cqv3)]:%YELLOW%Bolts//

//  ==========  Druid Pelts  ==========
//   Hide Magic Non-Ethereal Druid Pelts
//ItemDisplay[MAG !ID !ETH DRU]://

//   Hide Rare Non-Ethereal Druid Pelts
//ItemDisplay[RARE !ID !ETH DRU]://

//   Show Magic Non-Ethereal Druid Pelts
//ItemDisplay[MAG !ID !ETH DRU]:%BLUE%%NAME%//

//   Show Magic Ethereal Druid Pelts
//ItemDisplay[MAG !ID ETH DRU]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Non-Ethereal Druid Pelts
//ItemDisplay[RARE !ID !ETH DRU]:%YELLOW%%NAME%//

//   Show Rare Ethereal Druid Pelts
//ItemDisplay[RARE !ID ETH DRU]:%WHITE%Eth %YELLOW%%NAME%//

//  ==========  Druid Clubs  ==========
//   Hide Magic Non-Ethereal Druid Clubs
//ItemDisplay[MAG !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]://

//   Hide Rare Non-Ethereal Druid Clubs
//ItemDisplay[RARE !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]://

//   Show Magic Non-Ethereal Druid Clubs
//ItemDisplay[MAG !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%BLUE%%NAME%//

//   Show Magic Ethereal Druid Clubs
//ItemDisplay[MAG !ID ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Non-Ethereal Druid Clubs
//ItemDisplay[RARE !ID !ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%YELLOW%%NAME%//

//   Show Rare Ethereal Druid Clubs
//ItemDisplay[RARE !ID ETH (clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)]:%WHITE%Eth %YELLOW%%NAME%//

//  ==========  Necromancer Heads  ==========
//   Hide Magic Non-Ethereal Necromancer Heads
//ItemDisplay[MAG !ID !ETH NEC]://

//   Hide Rare Non-Ethereal Necromancer Heads
//ItemDisplay[RARE !ID !ETH NEC]://

//   Show Magic Non-Ethereal Necromancer Heads
//ItemDisplay[MAG !ID !ETH NEC]:%BLUE%%NAME%//

//   Show Magic Ethereal Necromancer Heads
//ItemDisplay[MAG !ID ETH NEC]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Non-Ethereal Necromancer Heads
//ItemDisplay[RARE !ID !ETH NEC]:%YELLOW%%NAME%//

//   Show Rare Ethereal Necromancer Heads
//ItemDisplay[RARE !ID ETH NEC]:%WHITE%Eth %YELLOW%%NAME%//

//        ==========  Gloves  ==========
//   Hide Magic Non-Ethereal Gloves
//ItemDisplay[MAG !ID !ETH GLOVES]://

//   Hide Rare Non-Ethereal Gloves
//ItemDisplay[RARE !ID !ETH GLOVES]://

//   Show Magic Ethereal Gloves
//ItemDisplay[MAG !ID ETH GLOVES]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Ethereal Gloves
//ItemDisplay[RARE !ID ETH GLOVES]:%WHITE%Eth %YELLOW%%NAME%//

//   Show Rare Non-Ethereal Gloves
//ItemDisplay[RARE !ID !ETH GLOVES]:%YELLOW%%NAME%//

//        ==========  Chests  ==========
//   Hide Magic Non-Ethereal Chests
//ItemDisplay[MAG !ID !ETH CHEST]://

//   Hide Rare Non-Ethereal Chests
//ItemDisplay[RARE !ID !ETH CHEST ALVL<85]://

//   Show Magic Ethereal Chests
//ItemDisplay[MAG !ID ETH CHEST]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Ethereal Chests
//ItemDisplay[RARE !ID ETH CHEST]:%WHITE%Eth %YELLOW%%NAME%//

//   Show Rare Non-Ethereal Chests
//ItemDisplay[RARE !ID !ETH CHEST]:%YELLOW%%NAME%//

//        ==========  Shields  ==========
//   Hide Magic Non-Ethereal Shields
//ItemDisplay[MAG !ID SHIELD !NEC !DIN]://

//   Hide Rare Non-Ethereal Shields
//ItemDisplay[RARE !ID SHIELD !NEC !DIN]://

//   Show Magic Ethereal Shields
//ItemDisplay[MAG !ID ETH SHIELD !NEC !DIN]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Ethereal Shields
//ItemDisplay[RARE !ID ETH SHIELD !NEC !DIN]:%WHITE%Eth %YELLOW%%NAME%//

//   Show Rare Non-Ethereal Shields
//ItemDisplay[RARE !ID !ETH SHIELD !NEC !DIN]:%YELLOW%%NAME%//

//        ==========  Boots  ==========
//   Hide Magic Non-Ethereal Boots
//ItemDisplay[MAG !ID BOOTS]://

//   Hide Rare Non-Ethereal Boots
//ItemDisplay[RARE !ID BOOTS]://

//   Show Magic Ethereal Boots
//ItemDisplay[MAG !ID ETH BOOTS]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Ethereal Boots
//ItemDisplay[RARE !ID ETH BOOTS]:%WHITE%Eth %YELLOW%%NAME%//

//   Show Rare Non-Ethereal Boots
//ItemDisplay[RARE !ID !ETH BOOTS]:%YELLOW%%NAME%//

//        ==========  All Weapons  ==========
//   Show Magic Ethereal Weapons (except sorceress orbs, wands, staves)
//ItemDisplay[MAG !ID ETH WEAPON !SOR !WAND !STAFF]:%WHITE%Eth %YELLOW%%NAME%//

//   Show Rare Ethereal Weapons (except sorceress orbs, wands, staves)
//ItemDisplay[RARE !ID ETH WEAPON !SOR !WAND !STAFF]:%WHITE%Eth %YELLOW%%NAME%//

//        ==========  Throwing Weapons  ==========
//   Show Ethereal Rare Throwing Weapons
//ItemDisplay[RARE !ID ETH (tax OR 9ta OR 7ta OR bkf OR 9bk OR 7bk OR bal OR 9b8 OR 7b8 OR glv OR 9gl OR 7gl OR tsp OR 9ts OR 7ts OR ssp OR 9s9 OR 7s7 OR pil OR 9pi OR 7pi)]:%WHITE%Eth %YELLOW%%NAME%%MAP-0B%%DOT-6A%%PX-20%%TIER-0%//

//   Show Non-Ethereal Rare Throwing Weapons
//ItemDisplay[RARE !ID !ETH (tax OR 9ta OR 7ta OR bkf OR 9bk OR 7bk OR bal OR 9b8 OR 7b8 OR glv OR 9gl OR 7gl OR tsp OR 9ts OR 7ts OR ssp OR 9s9 OR 7s7 OR pil OR 9pi OR 7pi)]:%YELLOW%%NAME%%MAP-0B%%DOT-6A%%PX-20%%TIER-0%//

//   Show Ethereal Magic Throwing Weapons
//ItemDisplay[MAG !ID ETH (tax OR 9ta OR 7ta OR bkf OR 9bk OR 7bk OR bal OR 9b8 OR 7b8 OR glv OR 9gl OR 7gl OR tsp OR 9ts OR 7ts OR ssp OR 9s9 OR 7s7 OR pil OR 9pi OR 7pi)]:%WHITE%Eth %BLUE%%NAME%%MAP-91%%DOT-97%%PX-1F%%TIER-0%//

//   Show Ethereal Non-Magic Throwing Weapons
//ItemDisplay[NMAG !ID ETH (tax OR 9ta OR 7ta OR bkf OR 9bk OR 7bk OR bal OR 9b8 OR 7b8 OR glv OR 9gl OR 7gl OR tsp OR 9ts OR 7ts OR ssp OR 9s9 OR 7s7 OR pil OR 9pi OR 7pi)]:%WHITE%Eth %GRAY%%NAME%//

//        ==========  Amazon Javelins  ==========
//   Hide Magic Non-Ethereal Amazon Javelins
//ItemDisplay[MAG !ID !ETH (am5 OR ama OR amf)]://

//   Hide Rare Non-Ethereal Amazon Javelins
//ItemDisplay[RARE !ID !ETH (am5 OR ama OR amf)]://

//   Show Magic Ethereal Amazon Javelins
//ItemDisplay[MAG !ID ETH (am5 OR ama OR amf)]:%WHITE%Eth %BLUE%%NAME%//

//   Show Rare Ethereal Amazon Javelins
