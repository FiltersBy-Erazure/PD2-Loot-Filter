//   Show Magic Non-Ethereal Amazon Javelins
//ItemDisplay[MAG !ID !ETH (am5 OR ama OR amf)]:%BLUE%%NAME%//

//   Show Rare Non-Ethereal Amazon Javelins
//ItemDisplay[RARE !ID !ETH (am5 OR ama OR amf)]:%YELLOW%%NAME%//

//        ==========  Sorceress Orbs  ==========
//   Hide All Magic Sorceress Orbs
//ItemDisplay[MAG !ID SOR]://

//   Hide All Rare Sorceress Orbs
//ItemDisplay[RARE !ID SOR]://

//   Show All Magic 3-Slot Sorceress Orbs
//ItemDisplay[MAG !ID (ob5 OR oba OR obf)]:%BLUE%%NAME%//

//   Show All Rare 3-Slot Sorceress Orbs
//ItemDisplay[RARE !ID (ob5 OR oba OR obf)]:%YELLOW%%NAME%//

//   Show All Magic 2-Slot Sorceress Orbs
//ItemDisplay[MAG !ID SOR !(ob5 OR oba OR obf)]:%BLUE%%NAME%//

//   Show All Rare 2-Slot Sorceress Orbs
//ItemDisplay[RARE !ID SOR !(ob5 OR oba OR obf)]:%YELLOW%%NAME%//

//        ==========  Amulets  ==========
//   Hide Magic Amulets
//ItemDisplay[MAG !ID amu]://

//   Show Magic Amulets
//ItemDisplay[MAG !ID amu]:%TAN%o  %BLUE%%NAME%  %TAN%o%BLUE%//

//        ==========  Charms  ==========

//   Hide All Magic Small Charms
//ItemDisplay[MAG !ID cm1 !TOWN]://

//   Hide All Magic Large Charms
//ItemDisplay[MAG !ID cm2 !TOWN]://

//   Hide All Magic Grand Charms
//ItemDisplay[MAG !ID cm3 !TOWN]://

// Hide Small Charms that aren't item level 90+
//ItemDisplay[MAG !ID ILVL<90 cm1 !TOWN]://

// Hide Large Charms that aren't item level 90+
//ItemDisplay[MAG !ID ILVL<90 cm2 !TOWN]://

// Hide Grand Charms that aren't item level 90+
//ItemDisplay[MAG !ID ILVL<90 cm3 !TOWN]://


// ================================  Gold  =======================================

ItemDisplay[GOLD<10 CLVL>4 !TOWN]://                          Hide under 10 gold if level 5+
ItemDisplay[GOLD<50 CLVL>9 !TOWN]://                          Hide under 50 gold if level 10+
ItemDisplay[GOLD<100 CLVL>19 !TOWN]://                        Hide under 100 gold if level 20+
ItemDisplay[GOLD<200 CLVL>29 !TOWN]://                        Hide under 200 gold if level 30+
ItemDisplay[GOLD<300 CLVL>39 !TOWN]://                        Hide under 300 gold if level 40+
ItemDisplay[GOLD<400 CLVL>49 !TOWN]://                        Hide under 400 gold if level 50+
ItemDisplay[GOLD<500 CLVL>59 !TOWN]://                        Hide under 500 gold if level 60+
ItemDisplay[GOLD<600 CLVL>69 !TOWN]://                        Hide under 600 gold if level 70+

ItemDisplay[GOLD<1500 CLVL>79 FILTLVL~1-4 !TOWN]://           Hide under 1500 gold if level 80+ on loot filter levels 1-4
ItemDisplay[GOLD<2500 CLVL>84 FILTLVL~1-4 !TOWN]://           Hide under 2500 gold if level 85+ on loot filter levels 1-4
ItemDisplay[GOLD<5000 CLVL>89 FILTLVL~1-4 !TOWN]://           Hide under 5000 gold if level 90+ on loot filter levels 1-4
ItemDisplay[GOLD<7500 CLVL>94 FILTLVL~1-4 !TOWN]://           Hide under 7500 gold if level 95+ on loot filter levels 1-4

ItemDisplay[GOLD<2500 CLVL>79 FILTLVL>4 !TOWN]://             Hide under 2500 gold if level 80+ on loot filter levels 5-12
ItemDisplay[GOLD<5000 CLVL>84 FILTLVL>4 !TOWN]://             Hide under 5000 gold if level 85+ on loot filter levels 5-12
ItemDisplay[GOLD<7500 CLVL>89 FILTLVL>4 !TOWN]://             Hide under 7500 gold if level 90+ on loot filter levels 5-12
ItemDisplay[GOLD<10000 CLVL>94 FILTLVL>4 !TOWN]://            Hide under 10000 gold if level 95+ on loot filter levels 5-12

// ================================  Health Potions  =================================

// Display for Healing Potions on filter level 0
ItemDisplay[hp1 FILTLVL=0]:%RED%- %WHITE%H1 %RED%-%WHITE%{%WHITE% Minor Healing Potion }//
ItemDisplay[hp2 FILTLVL=0]:%RED%• %WHITE%H2 %RED%•%WHITE%{%WHITE% Light Healing Potion }//
ItemDisplay[hp3 FILTLVL=0]:%RED%+ %WHITE%H3 %RED%+%WHITE%{%WHITE% Mid Healing Potion }//
ItemDisplay[hp4 FILTLVL=0]:%GRAY%i%RED%( %WHITE%H4 %RED%)%GRAY%i%WHITE%{%WHITE% Greater Healing Potion }//
ItemDisplay[hp5 FILTLVL=0]:%CORAL%i%RED%( %WHITE%H5 %RED%)%CORAL%i%WHITE%{%WHITE% Super Healing Potion }//

// Display for Healing Potions during levels 1-25
ItemDisplay[hp1 !FILTLVL=0 (CLVL<15 OR SHOP)]:%RED%- %WHITE%H1 %RED%-%WHITE%%PX-50%%TIER-0%{%WHITE% Minor Healing Potion }//
ItemDisplay[hp2 !FILTLVL=0 (CLVL<20 OR SHOP)]:%RED%• %WHITE%H2 %RED%•%WHITE%%PX-50%%TIER-0%{%WHITE% Light Healing Potion }//
ItemDisplay[hp3 !FILTLVL=0 (CLVL<24 OR DIFF=0 OR SHOP)]:%RED%+ %WHITE%H3 %RED%+%WHITE%%PX-50%%TIER-0%{%WHITE% Mid Healing Potion }//
ItemDisplay[hp4 !FILTLVL=0 (CLVL~1-49 OR DIFF=0 OR SHOP)]:%GRAY%i%RED%( %WHITE%H4 %RED%)%GRAY%i%WHITE%%PX-50%%TIER-0%{%WHITE% Greater Healing Potion }//
ItemDisplay[hp5 !FILTLVL=0 (CLVL~1-49 OR DIFF=0 OR SHOP)]:%CORAL%i%RED%( %WHITE%H5 %RED%)%CORAL%i%WHITE%%PX-50%%TIER-0%{%WHITE% Super Healing Potion }//

// Hide lower quality potions based on character level
ItemDisplay[hp1 !SHOP CLVL>14 !TOWN]:{%WHITE% Minor Healing Potion }//
ItemDisplay[hp2 !SHOP CLVL>19 !TOWN]:{%WHITE% Light Healing Potion }//
ItemDisplay[hp3 !SHOP CLVL>23 !TOWN]:{%WHITE% Healing Potion }//
ItemDisplay[hp4 !SHOP (CLVL>49 OR FILTLVL>2) !TOWN]:{%WHITE% Greater Healing Potion }//
ItemDisplay[hp5 !SHOP CLVL>49 FILTLVL>7 !TOWN]:{%WHITE% Super Healing Potion }//

ItemDisplay[hp1 !SHOP CLVL>14 TOWN]:%RED%- %WHITE%H1 %RED%-%WHITE%{%WHITE% Minor Healing Potion }//
ItemDisplay[hp2 !SHOP CLVL>19 TOWN]:%RED%• %WHITE%H2 %RED%•%WHITE%{%WHITE% Light Healing Potion }//
ItemDisplay[hp3 !SHOP CLVL>23 TOWN]:%RED%+ %WHITE%H3 %RED%+%WHITE%{%WHITE% Healing Potion }//
ItemDisplay[hp4 !SHOP (CLVL>49 OR FILTLVL>2) TOWN]:%GRAY%i%RED%( %WHITE%H4 %RED%)%GRAY%i%WHITE%{%WHITE% Greater Healing Potion }//
ItemDisplay[hp5 !SHOP CLVL>49 FILTLVL>7 TOWN]:%CORAL%i%RED%( %WHITE%H5 %RED%)%CORAL%i%WHITE%{%WHITE% Super Healing Potion }//

// Super Healing Potion
ItemDisplay[hp5 CLVL>49 FILTLVL~1-7]:%CORAL%i%RED%IOI%CORAL%i%WHITE%{%WHITE% Super Healing Potion }//

// ==================================  Mana Potions  ====================================

// Display for Mana Potions on filter level 0
ItemDisplay[mp1 FILTLVL=0]:%BLUE%- %WHITE%M %BLUE%-%WHITE%{%WHITE% Minor Mana Potion }//
ItemDisplay[mp2 FILTLVL=0]:%BLUE%• %WHITE%M2 %BLUE%•%WHITE%{%WHITE% Light Mana Potion }//
ItemDisplay[mp3 FILTLVL=0]:%BLUE%+ %WHITE%M3 %BLUE%+%WHITE%{%WHITE% Mana Potion }//
ItemDisplay[mp4 FILTLVL=0]:%GRAY%i%BLUE%( %WHITE%M4 %BLUE%)%GRAY%i%WHITE%{%WHITE% Greater Mana Potion }//
ItemDisplay[mp5 FILTLVL=0]:%TEAL%i%BLUE%( %WHITE%M5 %BLUE%)%TEAL%i%WHITE%{%WHITE% Super Mana Potion }//

// Display for Mana Potions during levels 1-25
ItemDisplay[mp1 !FILTLVL=0 (CLVL<15 OR SHOP)]:%BLUE%- %WHITE%M %BLUE%-%WHITE%%PX-97%%TIER-0%{%WHITE% Minor Mana Potion }//
ItemDisplay[mp2 !FILTLVL=0 (CLVL<23 OR SHOP)]:%BLUE%• %WHITE%M2 %BLUE%•%WHITE%%PX-97%%TIER-0%{%WHITE% Light Mana Potion }//
ItemDisplay[mp3 !FILTLVL=0 (CLVL<29 OR DIFF=0 OR SHOP)]:%BLUE%+ %WHITE%M3 %BLUE%+%WHITE%%PX-97%%TIER-0%{%WHITE% Mana Potion }//
ItemDisplay[mp4 !FILTLVL=0 (CLVL~1-49 OR DIFF=0 OR SHOP)]:%GRAY%i%BLUE%( %WHITE%M4 %BLUE%)%GRAY%i%WHITE%%PX-97%%TIER-0%{%WHITE% Greater Mana Potion }//
ItemDisplay[mp5 !FILTLVL=0 (CLVL~1-49 OR DIFF=0 OR SHOP)]:%TEAL%i%BLUE%( %WHITE%M5 %BLUE%)%TEAL%i%WHITE%%PX-97%%TIER-0%{%WHITE% Super Mana Potion }//

// Hide lower quality potions based on character level
ItemDisplay[mp1 !SHOP CLVL>14 !TOWN]:{%WHITE% Minor Mana Potion }//
ItemDisplay[mp2 !SHOP CLVL>22 !TOWN]:{%WHITE% Light Mana Potion }//
ItemDisplay[mp3 !SHOP CLVL>28 !TOWN]:{%WHITE% Mana Potion }//
ItemDisplay[mp4 !SHOP (CLVL>49 OR FILTLVL>2) !TOWN]:{%WHITE% Greater Mana Potion }//
ItemDisplay[mp5 !SHOP CLVL>49 FILTLVL>7 !TOWN]:{%WHITE% Super Mana Potion }//

ItemDisplay[mp1 !SHOP CLVL>14 TOWN]:%BLUE%- %WHITE%M %BLUE%-%WHITE%{%WHITE% Minor Mana Potion }//
ItemDisplay[mp2 !SHOP CLVL>22 TOWN]:%BLUE%• %WHITE%M2 %BLUE%•%WHITE%{%WHITE% Light Mana Potion }//
ItemDisplay[mp3 !SHOP CLVL>28 TOWN]:%BLUE%+ %WHITE%M3 %BLUE%+%WHITE%{%WHITE% Mana Potion }//
ItemDisplay[mp4 !SHOP (CLVL>49 OR FILTLVL>2) TOWN]:%GRAY%i%BLUE%( %WHITE%M4 %BLUE%)%GRAY%i%WHITE%{%WHITE% Greater Mana Potion }//
ItemDisplay[mp5 !SHOP CLVL>49 FILTLVL>7 TOWN]:%TEAL%i%BLUE%( %WHITE%M5 %BLUE%)%TEAL%i%WHITE%{%WHITE% Super Mana Potion }//

// Super Mana Potion
ItemDisplay[mp5 CLVL>49 FILTLVL~1-7]:%TEAL%i%BLUE%IOI%TEAL%i%WHITE%{%WHITE% Super Mana Potion }//

// Dueling Mana Potion
ItemDisplay[pvpp]:%BLUE% %WHITE%M%BLUE%+ %WHITE%{%WHITE% Dueling Mana Potion }//

// ==================================  Rejuvenation Potions  ================================

// Stash: readable names at every filter level (S14: potions stack in the stash)
ItemDisplay[rvs STASH]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i{%WHITE% Rejuvenation Potion }//
ItemDisplay[rvl STASH]:%PURPLE%i(%WHITE% Full %PURPLE%)i%WHITE%{%WHITE% Full Rejuvenation Potion }//

// Rathma
ItemDisplay[rvs (MAPID~161-163 OR MAPID=137 OR MAPID~188-189)]:%GRAY%i%PURPLE%IOI%GRAY%i%WHITE%{%WHITE% Rejuvenation Potion }//
ItemDisplay[rvl (MAPID~161-163 OR MAPID=137 OR MAPID~188-189)]:%GRAY%i%PURPLE%IOI%GRAY%i%WHITE%{%WHITE% Full Rejuvenation Potion }//
// Filter Level 0
ItemDisplay[rvs !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) FILTLVL=0]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i{%WHITE% Rejuvenation Potion }//
ItemDisplay[rvl !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) FILTLVL=0]:%PURPLE%i(%WHITE% Full %PURPLE%)i%WHITE%{%WHITE% Full Rejuvenation Potion }//

// Lower Levels
ItemDisplay[rvs !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL~1-3 OR FILTLVL=5) CLVL<50]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i{%WHITE% Rejuvenation Potion }%DOT-9B%%PX-20%%TIER-0%//
ItemDisplay[rvs !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL~1-3 OR FILTLVL=5) CLVL>49]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i{%WHITE% Rejuvenation Potion }//


// Lower Levels with minimap icon
ItemDisplay[rvl !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL~1-3 OR FILTLVL=5) CLVL<50]:%PURPLE%i(%WHITE% Full Rejuv %PURPLE%)i%WHITE%{%WHITE% Full Rejuvenation Potion }%DOT-9B%%PX-20%%TIER-0%//
ItemDisplay[rvl !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL~1-3 OR FILTLVL=5) CLVL>49]:%PURPLE%i(%WHITE% Full %PURPLE%)i%WHITE%{%WHITE% Full Rejuvenation Potion }%DOT-9B%%PX-20%%TIER-0%//

// Higher Levels
ItemDisplay[rvl !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL=4 OR FILTLVL>5) CLVL<80]:%PURPLE%i%GRAY%I%PURPLE%(O)%GRAY%I%PURPLE%i%WHITE%{%WHITE% Full Rejuvenation Potion }%DOT-9B%%PX-20%%TIER-0%//
ItemDisplay[rvl !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL=4 OR FILTLVL>5) CLVL>79]:%PURPLE%i%GRAY%I%PURPLE%(O)%GRAY%I%PURPLE%i%WHITE%{%WHITE% Full Rejuvenation Potion }//

ItemDisplay[rvs !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL=4 OR FILTLVL>5) !TOWN]:{%WHITE% Rejuvenation Potion }//
ItemDisplay[rvs !(MAPID~161-163 OR MAPID=137 OR MAPID~188-189) (FILTLVL=4 OR FILTLVL>5) TOWN]:%GRAY%i%PURPLE%(%WHITE% 35% %PURPLE%)%GRAY%i{%WHITE% Rejuvenation Potion }//

// =====================================  Utility Potions  ==================================

//Stamina
ItemDisplay[vps (CLVL<10 OR FILTLVL=0 OR SHOP)]:%GRAY%i%WHITE%( %WHITE%Stam %WHITE%)%GRAY%i%WHITE%{%WHITE%Stamina Potion}//
ItemDisplay[vps CLVL>9 !SHOP !TOWN]:{%WHITE%Stamina Potion}// Hides Stamina Potions when character level 10+
ItemDisplay[vps CLVL>9 !SHOP TOWN]:%GRAY%i%WHITE%( %WHITE%Stam %WHITE%)%GRAY%i%WHITE%{%WHITE%Stamina Potion}// Hides Stamina Potions when character level 10+

// Antidote
