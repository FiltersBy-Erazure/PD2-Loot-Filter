// Cold Light Fire
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) LRES>0 FRES>0 CRES>0 !PRES>0]:%WHITE%%CRES%%BLUE%r %WHITE%%LRES%%YELLOW%r %WHITE%%FRES%%RED%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) PRES>0 CRES>0 !FRES>0 !LRES>0]:%WHITE%%CRES%%BLUE%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold Light
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) CRES>0 LRES>0 !PRES>0 !FRES>0]:%WHITE%%CRES%%BLUE%r %WHITE%%LRES%%YELLOW%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold Fire
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) CRES>0 FRES>0 !PRES>0 !LRES>0]:%WHITE%%CRES%%BLUE%r %WHITE%%FRES%%RED%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold 
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) CRES>0 !FRES>0 !LRES>0 !PRES>0]:%WHITE%%CRES%%BLUE%r%CS%%NAME%{%NAME%}%CONTINUE%

// Cold
ItemDisplay[(rin OR amu OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD) MAG CRES>0 !RES>0]:%WHITE%%CRES%%BLUE%r%CS%%NAME%{%NAME%}%CONTINUE%

// ---- All Resistances (stat 43+, priority 40) ----

ItemDisplay[WEAPON ROLL_RES_TAG RES>0]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD) (MAG OR RARE OR CRAFT) RES>0]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR ram OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD OR QUIVER) (UNI OR SET) (STAT360=51 OR STAT206=51 OR ROLL_RES_TAG) RES>0 !(UNI ID (uth OR usk OR ((aqv2 OR aqv3) FRW>19 DEX>14 CRES>49)))]:%WHITE%%RES%%PURPLE%res%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[UNI ID (uth OR usk OR ((aqv2 OR aqv3) FRW>19 DEX>14 CRES>49)) (STAT360=51 OR STAT206=51)]:%PURPLE%Res%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Fire Resist (stat 40, priority 42) ----

ItemDisplay[WEAPON ROLL_MAXFR_TAG STAT40>0]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// Individual Maximum Resistances
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT40>0 !((SHIELD OR BELT) $f(STAT40<=MAXRES))]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=53 OR ROLL_MAXFR_TAG) !ROLL_MAXRES_TAG STAT40>0]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(GLOVES OR QUIVER OR amu OR rin) ROLL_MAXFR_TAG STAT40>0]:%WHITE%%STAT40%%RED%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Lightning Resist (stat 42, priority 43) ----

ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT42>0 !((SHIELD OR BELT) $f(STAT42<=MAXRES))]:%WHITE%%STAT42%%YELLOW%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=55 OR ROLL_MAXLR_TAG) !ROLL_MAXRES_TAG STAT42>0]:%WHITE%%STAT42%%YELLOW%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR QUIVER OR rin) ROLL_MAXLR_TAG STAT42>0]:%WHITE%%STAT42%%YELLOW%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Cold Resist (stat 44, priority 44) ----

ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT44>0 !((SHIELD OR BELT) $f(STAT44<=MAXRES))]:%WHITE%%STAT44%%BLUE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=54 OR ROLL_MAXCR_TAG) !ROLL_MAXRES_TAG STAT44>0]:%WHITE%%STAT44%%BLUE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR QUIVER OR rin) ROLL_MAXCR_TAG STAT44>0]:%WHITE%%STAT44%%BLUE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Max Poison Resist (stat 46, priority 45) ----

ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC OR BELT) (MAG OR RARE OR CRAFT) STAT46>0 !((SHIELD OR BELT) $f(STAT46<=MAXRES))]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BOOTS OR CHEST OR SHIELD OR HELM OR CIRC) (UNI OR SET) (STAT360=56 OR ROLL_MAXPR_TAG) !ROLL_MAXRES_TAG STAT46>0]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(QUIVER OR rin) ROLL_MAXPR_TAG STAT46>0]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- All Maximum Resistances (stat 46+, priority 45) ----

// All four Maximum Resistances on belts and shields: the belt corruption (+2%; MAXRES is the lowest of the four).
// The S14 belt/shield affix (+2-3% / +3-5%) is one element: its line above shows the element's total when that is
// above MAXRES, so a corrupted belt with the affix shows both tags
ItemDisplay[(SHIELD OR BELT) (RARE OR CRAFT) MAXRES>0]:%WHITE%%MAXRES%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(SHIELD OR BELT) MAG MAXRES>0]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[BELT (UNI OR SET) STAT360=72 MAXRES>0]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[amu (RARE OR CRAFT) MAXRES>0]:%WHITE%%MAXRES%%PURPLE%max%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR ram) (MAG OR UNI OR SET) MAXRES>0]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// All four Maximum Resistances (uniques that roll each, ROLL_MAXRES_TAG): poison/cold/lightning/fire, or one number when
// all are equal. Corruptions of one max resist count in these values: the corruption lines below skip these items
ItemDisplay[ROLL_MAXRES_TAG $f(MAX(STAT40,STAT42,STAT44,STAT46)>MAXRES)]:%WHITE%%STAT46%%DARK_GREEN%%PERCENT%%GRAY%/%WHITE%%STAT44%%BLUE%%PERCENT%%GRAY%/%WHITE%%STAT42%%YELLOW%%PERCENT%%GRAY%/%WHITE%%STAT40%%RED%%PERCENT%%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_MAXRES_TAG $f(MAX(STAT40,STAT42,STAT44,STAT46)==MAXRES)]:%WHITE%%MAXRES%%PURPLE%%PERCENT%max%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Mana Regeneration (stat 27, priority 52) ----

// % Mana Regeneration
ItemDisplay[(UNI OR SET) (STAT360=40 OR ROLL_REGEN_TAG) STAT27>0]:%WHITE%%STAT27%%BLUE%rgn%CS%%NAME%{%NAME%}%CONTINUE%

// ---- % Maximum Mana (stat 77, priority 54) ----

ItemDisplay[CHEST ROLL_MAXMANA_TAG STAT77>0]:%WHITE%%STAT77%%BLUE%%PERCENT%m%CS%%NAME%{%NAME%}%CONTINUE%

// % Maximum Mana
ItemDisplay[BOOTS (MAG OR RARE OR CRAFT) STAT77>9]:%WHITE%%STAT77%%BLUE%%PERCENT%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(WEAPON OR SHIELD OR GLOVES OR BOOTS OR BELT OR rin) ROLL_MAXMANA_TAG STAT77>0]:%WHITE%%STAT77%%BLUE%%PERCENT%m%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Mana (stat 9, priority 55) ----

ItemDisplay[(HELM OR CIRC) ROLL_MANA_TAG MANA>0]:%WHITE%%MANA%%BLUE%mn%CS%%NAME%{%NAME%}%CONTINUE%

// Mana
ItemDisplay[(rin OR amu OR CIRC) (RARE OR CRAFT) MANA>49 !STAT217>0]:%WHITE%%MANA%%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(BELT OR BOOTS OR GLOVES) (RARE OR CRAFT) MANA>29]:%WHITE%%MANA%%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(rin OR amu OR CIRC OR HELM OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES) MAG MANA>0 !STAT217>0]:%WHITE%%MANA%%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%

// Mana per character level (stat 217, held in 256ths like mana: /2048 = /8 per level): one tag with the flat mana, the total at your level (rares always)
ItemDisplay[(amu OR CIRC OR HELM) (RARE OR CRAFT) STAT217>0]:%WHITE%$f(STAT9+FLOOR(STAT217*CLVL/2048))%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(amu OR CIRC OR HELM) MAG STAT217>0]:%WHITE%$f(STAT9+FLOOR(STAT217*CLVL/2048))%BLUE%m%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[CHEST (UNI OR SET) (STAT360=10 OR ROLL_MANA_TAG)]:%WHITE%%MANA%%BLUE%mn%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(WEAPON OR SHIELD OR BELT OR amu OR rin) ROLL_MANA_TAG MANA>0]:%WHITE%%MANA%%BLUE%mn%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Replenish Life (stat 74, priority 56) ----

// Replenish Life
ItemDisplay[(UNI OR SET) (((HELM OR CIRC) STAT360=34) OR ROLL_REPLIFE_TAG) STAT74>0]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(UNI OR SET) (HELM OR CIRC) STAT360=34 STAT74<1]:%WHITE%$f(ABS(STAT74))%RED%drain%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR CIRC OR CHEST OR SHIELD OR BELT OR BOOTS OR GLOVES OR amu OR rin) MAG STAT74>0]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[(HELM OR CIRC) (RARE OR CRAFT) STAT360=34 STAT74>0]:%WHITE%%STAT74%%RED%rep%CS%%NAME%{%NAME%}%CONTINUE%

// ---- Life per Level (stat 216, priority 57) ----

// Per-level rolls on uniques/sets: per level, or the total at your level while your character wears the item.
// BH shows a whole number without its ".0": exactly 1 per level adds it (1.0lf, so it reads as per level)
ItemDisplay[ROLL_LIFELVL_TAG STAT216>0 !STAT216=2048 !EQUIPPED]:%WHITE%$f(STAT216/2048)%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_LIFELVL_TAG STAT216=2048 !EQUIPPED]:%WHITE%$f(STAT216/2048).0%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[ROLL_LIFELVL_TAG STAT216>0 EQUIPPED]:%WHITE%$f(FLOOR(STAT216*CLVL/2048))%RED%lf%CS%%NAME%{%NAME%}%CONTINUE%

