// White items: Enhanced Damage, left of the single skills above and right of the Amazon skill tabs below
// Bonus % Attack Rating Weapons
//ItemDisplay[(WEAPON !((STAFF (NORM OR (EXC !(ETH 8ws CLVL<80 (SOCK=0 OR SOCK=4))) OR (ELT !(ETH (6ws OR 6bs OR 6ls OR 6cs) (SOCK=0 OR SOCK=4 OR SOCK=5 OR SOCK=6))))) OR SOR OR WAND)) !SOCK=1 !INF SUP NMAG !RW (STAT119>19 OR (STAT119>14 ED>4) OR (STAT119>9 ED>9))]:%WHITE%%STAT119%%LIGHT_GRAY%ar%CS%%NAME%{%NAME%}%CONTINUE%//
