ItemDisplay[(rin OR amu OR ram OR HELM OR CIRC OR BELT OR BOOTS OR GLOVES OR CHEST OR SHIELD OR QUIVER) (UNI OR SET) (STAT360=38 OR ROLL_LRES_TAG)]:%WHITE%%LRES%%YELLOW%res%CS%%NAME%{%NAME%}%CONTINUE%

// Light Fire Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) PRES>0 FRES>0 LRES>0 !CRES>0]:%WHITE%%LRES%%YELLOW%r %WHITE%%FRES%%RED%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Light Poison
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) PRES>0 LRES>0 !FRES>0 !CRES>0]:%WHITE%%LRES%%YELLOW%r %WHITE%%PRES%%DARK_GREEN%r%CS%%NAME%{%NAME%}%CONTINUE%

// Light Fire
