ItemDisplay[WEAPON ROLL_CR_TAG STAT504>0]:%WHITE%%STAT504%%GOLD%cr%CS%%NAME%{%NAME%}%CONTINUE%

// Curse Resistance of Chests, Shields, Helms, Circlets
ItemDisplay[(amu OR ram OR BOOTS OR BELT OR rin OR HELM OR CIRC OR CHEST OR SHIELD OR QUIVER) (STAT360=49 OR STAT360=62 OR STAT206=49 OR STAT206=62 OR ROLL_CR_TAG) STAT504>0]:%WHITE%%STAT504%%GOLD%cr%CS%%NAME%{%NAME%}%CONTINUE%

