//  Shop Highlight for Paladin Scepters
//          +4 to Holy Bolt, Blessed Hammer, Fist of the Heavens with 10-20 FCR
ItemDisplay[SCEPTER MAG ALLSK=0 ((SK101=3 (CLSK3=1 OR TABSK24=1)) OR (SK101=2 (CLSK3=2 OR TABSK24=2)) OR (SK101=1 TABSK24=3)) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+4 Holy Bolt   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[SCEPTER MAG ALLSK=0 ((SK112=3 (CLSK3=1 OR TABSK24=1)) OR (SK112=2 (CLSK3=2 OR TABSK24=2)) OR (SK112=1 TABSK24=3)) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+4 Blessed Hammer   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[SCEPTER MAG ALLSK=0 ((SK121=3 (CLSK3=1 OR TABSK24=1)) OR (SK121=2 (CLSK3=2 OR TABSK24=2)) OR (SK121=1 TABSK24=3)) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+4 Fist of the Heavens   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//
//          +3 to Combat Skills with 10-20 FCR
ItemDisplay[SCEPTER MAG TABSK24=3 !(SK101>0 OR SK112>0 OR SK121>0) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+3 Combat Skills   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//
//          +3 to Holy Bolt, Blessed Hammer, Fist of the Heavens with 10-20 FCR
ItemDisplay[SCEPTER MAG ALLSK=0 ((SK101=3 CLSK3=0 TABSK24=0) OR (SK101=2 (CLSK3=1 OR TABSK24=1)) OR (SK101=1 (CLSK3=2 OR TABSK24=2))) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+3 Holy Bolt   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[SCEPTER MAG ALLSK=0 ((SK112=3 CLSK3=0 TABSK24=0) OR (SK112=2 (CLSK3=1 OR TABSK24=1)) OR (SK112=1 (CLSK3=2 OR TABSK24=2))) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+3 Blessed Hammer   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//
ItemDisplay[SCEPTER MAG ALLSK=0 ((SK121=3 CLSK3=0 TABSK24=0) OR (SK121=2 (CLSK3=1 OR TABSK24=1)) OR (SK121=1 (CLSK3=2 OR TABSK24=2))) ((FCR=10 CLVL<60) OR (FCR=20 CLVL<80))]:%NAME%{%HIGHLIGHT_2_LEFT%   %YELLOW%+3 Fist of the Heavens   %HIGHLIGHT_2_RIGHT%%CL%%NAME%}%CONTINUE%//

//          +4 to Holy Bolt, Blessed Hammer, Fist of the Heavens
