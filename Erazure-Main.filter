// --------------------------------------------------------------------------------------------------------

// Rare class items a character sees on filter levels 8-11: its own class's (Sorceresses: 3 staves and 3 orbs),
// and for every class the ethereal Amazon javelins and spears and the Reflex, Ceremonial and Grand Matron Bows
Alias[RARE_CLASS_ITEMS_SEEN]:((NECROMANCER (WAND OR NEC)) OR (SORCERESS (wst OR 8ws OR 6ws OR ob5 OR oba OR obf)) OR (PALADIN (SCEPTER OR DIN)) OR (ASSASSIN SIN) OR (DRUID (DRU OR clb OR spc OR 9cl OR 9sp OR 7cl OR 7sp)) OR (BARBARIAN BAR) OR (AMAZON ZON) OR (ETH (am3 OR am4 OR am5 OR am8 OR am9 OR ama OR amd OR ame OR amf)) OR am2 OR am7 OR amc)

// Hide Rare Items on Filter Levels 10 and 12 (on 10 not the class items above)
ItemDisplay[RARE !ID (FILTLVL=10 OR FILTLVL=12) ((ARMOR !CIRC !BOOTS !BELT !(CHEST (ALVL>84 OR CRAFTALVL>84)) !(SHIELD !NEC !DIN (lrg OR spk OR kit OR bsh OR tow OR gts OR xrg OR xpk OR xit OR xsh OR xow OR xts OR urg OR upk OR uit OR ush OR uow OR uts))) OR WEAPON) !(FILTLVL=10 RARE_CLASS_ITEMS_SEEN) !TOWN]://

