// Light
ItemDisplay[(rin OR (amu !STAT206>0) OR BELT OR BOOTS OR GLOVES OR HELM OR CIRC) (RARE OR CRAFT) LRES>0 !FRES>0 !PRES>0 !CRES>0]:%WHITE%%LRES%%YELLOW%r%CS%%NAME%{%NAME%}%CONTINUE%

// Light
